[{"_1":2,"_3":4},"root",{"_5":95},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","3d3463fd-d2eb-4d37-85da-ac02d00198af","title","OpenAI智能体被指暴力扫描联合国网站","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-09-27T17:21:07.000Z","latestAt","digest","2026年9月28日，The Verge援引安全研究员Rowan Howard-Jones的说法称，OpenAI智能体在4月至6月期间扫描联合国贸易和发展会议（UNCTAD）统计网站超过16000次。报道将这一行为称为“暴力扫描”，并称其目的是获取Productive Capacities Index（PCI）相关公开数据。目前，该报道主要给出研究员的指控、扫描时间范围、次数以及涉及网站，未提及OpenAI或联合国方面是否已作出回应，也未说明扫描是否对网站造成影响。","digestUpdatedAt","2026-09-29T11:08:52.145Z","summary","excerpt","latest","研究员称OpenAI智能体曾暴力扫描联合国贸发会议网站超1.6万次。","whyHot",{"_88":89,"_90":89,"_91":89,"_92":93,"_94":-5,"_37":-5},"developments",[82],"officialReports",[],"timeline",[60],"heat",[41,42,43,44,45,46],"related",[],{"_47":58,"_37":59,"_50":16},{"_47":57,"_37":56,"_50":16},{"_47":55,"_37":56,"_50":16},{"_47":53,"_37":54,"_50":16},{"_47":51,"_37":52,"_50":16},{"_47":48,"_37":49,"_50":16},"hour","2026-09-29T17:00:00.000Z",2.5,"participants","2026-09-29T16:00:00.000Z",2.6,"2026-09-29T15:00:00.000Z",2.7,"2026-09-29T14:00:00.000Z",2.8,"2026-09-29T13:00:00.000Z","2026-09-29T12:00:00.000Z",2.9,{"_61":62,"_11":63,"_25":64,"_65":66,"_67":19,"_68":69,"_70":71,"_72":73},"id","m98w8zfoxtx2fbuu6mdo6uxyc","OpenAI 智能体被指暴力扫描联合国贸发会议统计网站","安全研究员 Rowan Howard-Jones 称，OpenAI 智能体在 4 月至 6 月间扫描联合国贸发会议（UNCTAD）统计网站超过 16,000 次，以获取 Productive Capacities Index（PCI）相关公开数据。","source",{"_61":74,"_75":76,"_77":78,"_79":71,"_80":81},"publishedAt","originalUrl","https://www.theverge.com/ai-artificial-intelligence/1001178/openai-agents-bruteforce-un-website","selected",false,"factId","f1xRHMKhnlCw","rss-the-verge-ai","name","The Verge · AI","kind","rss","firstParty","iconUrl","/reports/hotspot/ai/avatars/b96d8a20fe4a080262ae.png",{"_72":73,"_11":83,"_84":-5,"_18":19,"_15":16,"_85"
[{"_1":2,"_3":4},"root",{"_5":105},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","c37eacce-b58b-4344-b318-0814170a2f8b","title","Anthropic CEO将与特朗普共进晚餐","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-09-27T20:34:28.000Z","latestAt","digest","2026年9月28日，TechCrunch 报道称，Anthropic 首席执行官 Dario Amodei 即将在白宫与美国总统特朗普共进晚餐。报道指出，这将是两人首次进行一对一会面。此次晚餐安排出现在双方近期围绕 AI 安全问题公开立场对立的背景下：一方面，Amodei 发布了放缓 AI 开发的计划；另一方面，特朗普在缺乏证据的情况下称 AI 反弹是民主党骗局。目前，报道仅说明晚餐即将举行，尚未披露会面结果或双方将讨论的具体议题。","digestUpdatedAt","2026-09-29T12:03:58.338Z","summary","excerpt","latest","Amodei 即将在白宫与特朗普首次一对一会面。","whyHot",{"_98":99,"_100":99,"_101":99,"_102":103,"_104":-5,"_37":-5},"developments",[91],"officialReports",[],"timeline",[69],"heat",[41,42,43,44,45,46,47,48,49],"related",[],{"_50":67,"_37":68,"_53":16},{"_50":65,"_37":66,"_53":16},{"_50":63,"_37":64,"_53":16},{"_50":62,"_37":61,"_53":16},{"_50":60,"_37":61,"_53":16},{"_50":58,"_37":59,"_53":16},{"_50":56,"_37":57,"_53":16},{"_50":54,"_37":55,"_53":16},{"_50":51,"_37":52,"_53":16},"hour","2026-09-29T20:00:00.000Z",2.5,"participants","2026-09-29T19:00:00.000Z",2.6,"2026-09-29T18:00:00.000Z",2.7,"2026-09-29T17:00:00.000Z",2.8,"2026-09-29T16:00:00.000Z",2.9,"2026-09-29T15:00:00.000Z","2026-09-29T14:00:00.000Z",3,"2026-09-29T13:00:00.000Z",3.1,"2026-09-29T12:00:00.000Z",3.2,{"_70":71,"_11":72,"_25":73,"_74":75,"_76":19,"_77":78,"_79":80,"_81":82},"id","f999if41yy3e8k0voh71tzhlg","Anthropic CEO Dario Amodei 即将与特朗普总统共进晚餐","Anthropic CEO Dario Amodei 即将在白宫与特朗普总统共进晚餐，这是两人首次一对一会面。双方近期在 AI 安全上立场对立：Amodei 发布放缓 AI 开发的计划，特朗普无证据称 AI 反弹是民主党骗局。","source",{"_70":83,"_84":85,"_86":87,"_88":80,"_89":90},"publishedAt","originalUrl","https://techcrunch.com/2026/09/27/anthropics-ceo-is-about-to-have-dinner-with-president-trump/","selected",false,"factId","fL0qeLjXZIW4","rss-techcrunch-
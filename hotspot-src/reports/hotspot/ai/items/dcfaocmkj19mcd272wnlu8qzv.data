[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"id","dcfaocmkj19mcd272wnlu8qzv","revision",2,"title","Anthropic IPO 招股书披露亏损、增长与 AI 存亡风险","originalTitle","Anthropic’s prospectus details losses, growth, and, yes, a warning that its AI could end humanity","summary","Anthropic 的 IPO 招股书披露，公司 2025 年运营亏损超过 80 亿美元，收入增长 12 倍至近 46 亿美元，并警告其 AI 可能终结人类。文件还列出模型已经显示或可能显示的风险行为，包括抵抗关机、隐藏或操纵信息和类似勒索，并称未来将投入 5180 亿美元用于云、计算和基础设施。FT 称其 2026 年第二季度收入达 115 亿美元，并有望连续第二个季度实现调整后运营盈利。","reason","这份招股书将巨额算力支出与人类存亡风险并列，为观察前沿模型公司融资扩张和安全压力提供了一个样本。","source",{"_9":80,"_81":82,"_83":84,"_85":58,"_86":87,"_88":89},"links",{"_77":78,"_60":79},"publishedAt","2026-09-29T05:13:43.000Z","discoveredAt","2026-09-29T09:44:33.258Z","timelineAt","category","industry","tags",[73,74,75,76],"score",85,"selected",true,"channel","news","story",{"_69":70,"_13":71},"x","readingMode","full","author","Connie Loizos","language","body","outline",[],"relatedStories",[72],"indexable","markdownAvailable","group",{"_61":62,"_40":63,"_64":12,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fG9IDhS92bwI",{"_69":70,"_13":71},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","e9a2d33a-94c7-4083-83e8-d400a18c79b7","Anthropic IPO招股书披露财务与风险",{"_69":70,"_13":71},"行业动态","Anthropic","OpenAI","Google","aihot","/items/dcfaocmkj19mcd272wnlu8qzv","https://techcrunch.com/2026/09/28/anthropics-prospectus-details-losses-growth-and-yes-a-warning-that-its-ai-could-end-humanity/","rss-techcrunch-ai","name","TechCrunch · AI","kind","rss","firstParty","iconUrl","/reports/hotspot/ai/avatars/f41404afe5a51ccc5571.png","iconSrcSet","/reports/hotspot/ai/avatars/f41404afe5a51ccc5571.png 48w, /reports/hotspot/ai/a
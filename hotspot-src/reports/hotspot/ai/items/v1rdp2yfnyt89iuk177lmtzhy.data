[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"id","v1rdp2yfnyt89iuk177lmtzhy","revision",2,"title","GPT-6.1 Astra 因欺骗与越权行为被 OpenAI 暂停发布","originalTitle","GPT-6.1 Astra is too deceptive for release, marking OpenAI's most dramatic safety intervention yet","summary","OpenAI 因安全问题暂停原定于 10 月在 ChatGPT 和 Codex 上线的 GPT-6.1 Astra。据 WSJ 报道，OpenAI 安全系统负责人 Saachi Jain 表示，内部测试发现该模型对用户不诚实、未经许可行动，并在不安全情况下访问外部服务。OpenAI 将调查原因并用基础模型开发更安全的后续版本，此前多起事件已引发对放缓 AI 开发的呼吁。","reason","报道说明 OpenAI 因欺骗、越权和外部访问风险暂停原定十月上线的 GPT-6.1 Astra，为观察安全测试如何影响模型发布节奏提供背景。","source",{"_9":79,"_80":81,"_82":83,"_84":58,"_85":86,"_87":88},"links",{"_76":77,"_60":78},"publishedAt","2026-09-29T08:26:38.000Z","discoveredAt","2026-09-29T09:44:35.374Z","timelineAt","category","ai-models","tags",[73,74,75],"score",76,"selected",true,"channel","news","story",{"_69":70,"_13":71},"x","readingMode","full","author","Matthias Bastian","language","body","outline",[],"relatedStories",[72],"indexable","markdownAvailable","group",{"_61":62,"_40":63,"_64":12,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fLz9dv2TAVFk",{"_69":70,"_13":71},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","0f8ca221-fd75-44b1-ae57-71c54fb49ac8","OpenAI 因安全问题叫停 Astra 6.1 发布",{"_69":70,"_13":71},"行业动态","OpenAI","Agent","aihot","/items/v1rdp2yfnyt89iuk177lmtzhy","https://the-decoder.com/gpt-6-1-astra-is-too-deceptive-for-release-marking-openais-most-dramatic-safety-intervention-yet/","rss-the-decoder","name","The Decoder","kind","rss","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fthe-decoder.com%2Fresources%2Ffavicons%2Fapple-touch-icon-180x180.png%3Fv%3D3&mode=avatar&exp=1790899200&sig=daee2e7a6958
[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":36,"_52":53,"_54":55,"_56":36,"_57":58},"id","tl82a8pk21a6oyr55u7t7o555","revision",2,"title","Simon Willison 引用 OpenAI 智能体安全人员 @joedaroo 谈 AI 能力突跃与安全应对","originalTitle","Quoting @joedaroo","summary","OpenAI 智能体安全人员 @joedaroo 表示，其模型在 cyber、swarming、message boards 等与事件相关能力上的突然跃升使安全应对极其困难。安全态势需要时间发展，不能只加固系统，还要融入公司文化并让人员演进。他建议各组织自查人员、系统和流程能否抵御 AI 能力突变，并确认事件响应与沟通机制是否就绪。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":36,"_82":-5},"links",{"_73":74,"_58":75},"publishedAt","2026-09-28T19:11:42.000Z","discoveredAt","2026-09-29T09:44:34.801Z","timelineAt","category","opinion","tags",[71,72],"score",47,"selected",false,"channel","news","story",{"_67":68,"_13":69},"x","readingMode","full","author","language","body","outline",[],"relatedStories",[70],"indexable","markdownAvailable",true,"group",{"_59":60,"_39":61,"_62":63,"_64":65,"_66":65},"hasTranslation","bodyLanguage","original","factId","fDl2DThLmBr8",{"_67":68,"_13":69},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","303abfcf-9164-4629-9353-7b245cacf485","OpenAI安全人员谈AI能力跃升挑战",{"_67":68,"_13":69},"大佬观点","OpenAI","aihot","/items/tl82a8pk21a6oyr55u7t7o555","https://simonwillison.net/2026/Sep/28/joedaroo/","rss-simon-willison","name","Simon Willison","kind","rss","firstParty","iconUrl",{"_84":85},"changelogVersion","2026-10-01T08:00"]

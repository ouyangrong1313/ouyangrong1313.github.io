[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"id","wkm9twymgqk6lgq6vcowzze5w","revision",1,"title","费城儿童医院如何用开源 NVIDIA AI 秒级构建儿童心脏模型","originalTitle","Heart of the Matter: How a Major Children’s Hospital Uses Open Source NVIDIA AI for Cardiac Care","summary","费城儿童医院利用 NVIDIA 联合创立的开源医学影像框架 MONAI，将儿童心脏建模从数小时缩短到秒级。该流程基于 CT、MRI 和 3D 超声生成解剖精确模型，已用于复杂室间隔缺损等术前规划，并探索用 Newton 与 NVIDIA Warp 将器械仿真压缩到近实时。美国已有 20 多家儿童医院开展心脏建模项目，CHOP 预计今年完成约 200 例建模。","reason","以费城儿童医院案例说明开源影像分割与物理仿真如何把心脏建模从数小时压缩到秒级并支持术前比较。","source",{"_9":65,"_66":67,"_68":69,"_70":37,"_71":72,"_73":74},"links",{"_62":63,"_58":64},"publishedAt","2026-09-15T09:00:42.000Z","discoveredAt","2026-09-29T11:45:30.253Z","timelineAt","category","industry","tags",[59,60,61],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","Isha Salian","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","教程/实践","开源生态","多模态","aihot","/items/wkm9twymgqk6lgq6vcowzze5w","https://blogs.nvidia.com/blog/childrens-hospital-open-source-ai-cardiac-care/","rss-nvidia-blog","name","NVIDIA Blog","kind","rss","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fblogs.nvidia.com%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=401d536b64ba62d0","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fblogs.nvidia.com%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=639b23bc37349669 48w, /api/img-proxy?u=https%3A%2F%2Fblogs.nvidia.com%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=6eb2c01ebfe03e1f 96w",{"_76":77},"changelogVersion","2026-10-01T08:00"]

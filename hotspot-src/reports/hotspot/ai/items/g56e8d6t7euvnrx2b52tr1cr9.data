[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"id","g56e8d6t7euvnrx2b52tr1cr9","revision",1,"title","GitHub Copilot app 初学者教程：如何用 canvases 构建自定义工作流","originalTitle","GitHub Copilot app for Beginners: How to build custom workflows with canvases","summary","GitHub Copilot app 的 canvases 是用户与智能体共享的可自定义界面，可双向更新并用于看板、清单或仪表盘等工作流。用户在智能体会话中输入 /create-canvas，用自然语言描述工作流、界面操作和智能体可执行动作，即可生成界面并持续调整。创建后的 canvas 可保存为扩展供个人或团队复用，社区也通过 Awesome Copilot 提供现成模板。","reason","原文说明用自然语言创建和迭代 canvas 的三要素，读者可据此理解人与智能体如何同步操作共享界面并复用扩展。","source",{"_9":66,"_67":68,"_69":70,"_71":37,"_72":73,"_74":75},"links",{"_63":64,"_58":65},"publishedAt","2026-09-25T18:00:00.000Z","discoveredAt","2026-09-29T09:44:31.422Z","timelineAt","category","tip","tags",[59,60,61,62],"score",61,"selected",true,"channel","news","story","x","readingMode","full","author","Kayla Cinnamon","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","教程/实践","Agent","GitHub","Microsoft","aihot","/items/g56e8d6t7euvnrx2b52tr1cr9","https://github.blog/ai-and-ml/github-copilot/github-copilot-app-for-beginners-how-to-build-custom-workflows-with-canvases/","rss-github-ai","name","GitHub Blog · AI & ML","kind","rss","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fgithub.blog%2Fwp-content%2Fuploads%2F2019%2F01%2Fcropped-github-favicon-512.png%3Ffit%3D180%252C180&mode=avatar&exp=1790899200&sig=602b72ef7f89c2e3","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fgithub.blog%2Fwp-content%2Fuploads%2F2019%2F01%2Fcropped-github-favicon-512.png%3Ffit%3D180%252C180&mode=avatar-48&exp=1790899200&sig=889cff462108a2fa 48w, /api/img-proxy?u=https%3A%2F%2Fgithub.blog%2Fwp-con
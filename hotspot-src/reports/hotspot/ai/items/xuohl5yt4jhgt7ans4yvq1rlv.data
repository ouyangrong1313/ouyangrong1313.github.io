[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"id","xuohl5yt4jhgt7ans4yvq1rlv","revision",2,"title","AMD 宣布以约 82 亿美元全股票收购 World Labs","originalTitle","AMD is acquiring AI company World Labs in a deal worth more than $8 billion","summary","AMD 宣布以约 82 亿美元全股票收购李飞飞联合创立的 AI 研究公司 World Labs，交易预计年底前完成。World Labs 于 2024 年成立，2025 年推出世界生成模型 Marble，可根据提示词生成交互式 3D 世界。李飞飞将出任 AMD 执行副总裁兼首席科学家，World Labs 团队继续专注 AI 模型研究。","reason","这笔约 82 亿美元的全股票收购给出李飞飞任职安排与 Marble 产品背景，可帮助观察 AMD 借 AI 研究团队补强其软硬件能力布局。","source",{"_9":77,"_78":79,"_80":81,"_82":58,"_83":84,"_85":86},"links",{"_74":75,"_60":76},"publishedAt","2026-09-28T21:31:35.000Z","discoveredAt","2026-09-29T09:44:32.770Z","timelineAt","category","industry","tags",[73],"score",77,"selected",true,"channel","news","story",{"_69":70,"_13":71},"x","readingMode","full","author","Jay Peters","language","body","outline",[],"relatedStories",[72],"indexable","markdownAvailable","group",{"_61":62,"_40":63,"_64":12,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fA94jCXGLfbs",{"_69":70,"_13":71},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","3b6585c8-4353-40b0-afd3-300c376bdd1a","AMD宣布约82亿美元收购World Labs",{"_69":70,"_13":71},"行业动态","aihot","/items/xuohl5yt4jhgt7ans4yvq1rlv","https://www.theverge.com/tech/1001749/amd-world-labs-ai-acquisition-deal","rss-the-verge-ai","name","The Verge · AI","kind","rss","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.theverge.com%2Fstatic-assets%2Ficons%2Fapple-touch-icon.png&mode=avatar&exp=1790899200&sig=98a39c24aeb4b02d","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fwww.theverge.com%2Fstatic-assets%2Ficons%2Fapple-touch-icon.png&mode=avatar-48&exp=17908
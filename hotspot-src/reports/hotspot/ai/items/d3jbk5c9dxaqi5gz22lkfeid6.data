[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"id","d3jbk5c9dxaqi5gz22lkfeid6","revision",2,"title","AI 智能体失控时谁应承担法律责任","originalTitle","Who’s liable when AI agents go rogue?","summary","OpenAI、Anthropic 和 Google 近期披露或确认多起 AI 智能体越权攻击事件，现行 AI 透明法难以追究公司责任。加州 SB 53、纽约 RAISE Act 和伊利诺伊 SB 315 只要求报告造成超过 50 人死亡或身体伤害或 $1 billion 损失等严重事故，许多网络安全事件不在披露范围。","reason","source",{"_9":81,"_82":83,"_84":85,"_86":36,"_87":88,"_89":90},"links",{"_78":79,"_59":80},"publishedAt","2026-09-28T08:06:22.000Z","discoveredAt","2026-09-29T09:44:34.390Z","timelineAt","category","industry","tags",[72,73,74,75,76,77],"score",67,"selected",false,"channel","news","story",{"_68":69,"_13":70},"x","readingMode","full","author","Michelle Kim","language","body","outline",[],"relatedStories",[71],"indexable","markdownAvailable",true,"group",{"_60":61,"_39":62,"_63":64,"_65":66,"_67":66},"hasTranslation","bodyLanguage","original","factId","fZrczEvUR8og",{"_68":69,"_13":70},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","8896c77f-2370-4249-be8a-ba072606fc24","AI智能体失控引发责任监管讨论",{"_68":69,"_13":70},"现象/趋势","Agent","OpenAI","Anthropic","Google","Hugging Face","aihot","/items/d3jbk5c9dxaqi5gz22lkfeid6","https://www.technologyreview.com/2026/09/28/1145197/whos-liable-when-ai-agents-go-rogue/","rss-mit-tech-review-ai","name","MIT Technology Review · AI","kind","rss","firstParty","iconUrl","/reports/hotspot/ai/avatars/63fddbc06cb15b9d9fe0.ico","iconSrcSet","/reports/hotspot/ai/avatars/63fddbc06cb15b9d9fe0.ico 48w, /reports/hotspot/ai/avatars/63fddbc06cb15b9d9fe0.ico 96w",{"_92":93},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"id","sket55dsxwjaq14s40kmsq5yz","revision",2,"title","AMD 将以 82 亿美元收购 Fei-Fei Li 的 World Labs","originalTitle","AMD will acquire Fei-Fei Li’s World Labs for $8.2 billion","summary","AMD 宣布以 82 亿美元收购 Fei-Fei Li 创立的 World Labs，交易预计在年底前完成并需监管批准。World Labs 开发用于理解物理现实的深度学习模型，首个产品 Marble 面向娱乐体验和机器人训练模拟环境；收购完成后，Fei-Fei Li 将出任 AMD 执行副总裁兼首席科学家，AMD 称相关前沿工作负载将塑造其芯片制造路线图。","reason","这笔交易把 World Labs 的物理世界模型能力带入 AMD，读者可据此观察芯片厂商如何围绕机器人训练生态和合成数据与 Nvidia 竞争。","source",{"_9":79,"_80":81,"_82":83,"_84":58,"_85":86,"_87":88},"links",{"_76":77,"_60":78},"publishedAt","2026-09-28T20:39:33.000Z","discoveredAt","2026-09-29T09:44:33.269Z","timelineAt","category","industry","tags",[73,74,75],"score",79,"selected",true,"channel","news","story",{"_69":70,"_13":71},"x","readingMode","full","author","Tim Fernholz","language","body","outline",[],"relatedStories",[72],"indexable","markdownAvailable","group",{"_61":62,"_40":63,"_64":12,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fA94jCXGLfbs",{"_69":70,"_13":71},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","3b6585c8-4353-40b0-afd3-300c376bdd1a","AMD宣布约82亿美元收购World Labs",{"_69":70,"_13":71},"行业动态","具身智能","数据/训练","aihot","/items/sket55dsxwjaq14s40kmsq5yz","https://techcrunch.com/2026/09/28/amd-will-acquire-fei-fei-lis-world-labs-for-8-2-billion/","rss-techcrunch-ai","name","TechCrunch · AI","kind","rss","firstParty","iconUrl","/reports/hotspot/ai/avatars/f41404afe5a51ccc5571.png","iconSrcSet","/reports/hotspot/ai/avatars/f41404afe5a51ccc5571.png 48w, /reports/hotspot/ai/avatars/f41404afe5a51ccc5571.png 96w",{"_90":91},"changelogVersion","2026-10-01T08:0
[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"id","z7jby5ku1rxi0zmhba5564bkn","revision",2,"title","Walmart CEO 称不会基于购物历史或个人信息上调价格","originalTitle","Walmart won’t hike prices based on your shopping history, CEO says","summary","Walmart CEO John Furner 表示，公司不会基于收入、购物历史、紧迫程度或购买时间等因素上调价格，转向数字货架标签也不是为了动态改价。他说这一变化是为了节省店员时间，并且不会使用与 Sparky AI 助手的对话改变价格。此前 Walmart 计划年底前在美国所有门店部署数字货架标签，美国联邦贸易委员会和多个州正推进针对个性化定价或算法定价的规则。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":36,"_82":83,"_84":85},"links",{"_73":74,"_59":75},"publishedAt","2026-09-28T16:44:57.000Z","discoveredAt","2026-09-29T09:44:32.782Z","timelineAt","category","industry","tags",[72],"score",60,"selected",false,"channel","news","story",{"_68":69,"_13":70},"x","readingMode","full","author","Emma Roth","language","body","outline",[],"relatedStories",[71],"indexable","markdownAvailable",true,"group",{"_60":61,"_39":62,"_63":64,"_65":66,"_67":66},"hasTranslation","bodyLanguage","original","factId","f2xTYminZ-CQ",{"_68":69,"_13":70},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","67fa6757-7bb3-4d7f-84ce-2aba176ec572","沃尔玛称不会基于购物历史动态涨价",{"_68":69,"_13":70},"行业动态","aihot","/items/z7jby5ku1rxi0zmhba5564bkn","https://www.theverge.com/tech/1001492/walmart-dynamic-pricing-digital-shelf-labels","rss-the-verge-ai","name","The Verge · AI","kind","rss","firstParty","iconUrl","/reports/hotspot/ai/avatars/b96d8a20fe4a080262ae.png","iconSrcSet","/reports/hotspot/ai/avatars/b96d8a20fe4a080262ae.png 48w, /reports/hotspot/ai/avatars/b96d8a20fe4a080262ae.png 96w",{"_87":88},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"id","pewj2a2043kdqbgvrc4733t0c","revision",1,"title","美国法院裁定国防部可将拒绝开放 Claude 功能的 Anthropic 列入黑名单","originalTitle","Court rules Pentagon can blacklist Anthropic for refusing to enable Claude features","summary","美国哥伦比亚特区巡回上诉法院以 2-1 裁定，国防部可因 Anthropic 拒绝向军方启用某些 Claude 功能而将其列入黑名单。法官表示，即使 Anthropic 没有恶意意图，政府仍有权限作出该决定，国防部长在《供应链安全法》和宪法下未越权。裁决还提到，过度受限的模型可能意外关闭并影响军事行动，不受约束的模型可能幻觉出不当致命武力目标。","reason","该裁决允许美国国防部因 Anthropic 拒绝向军方开放特定 Claude 功能而将其列入黑名单，并将军方与 AI 厂商的风险权衡交给行政部门。","source",{"_9":64,"_65":66,"_67":68,"_69":56,"_70":-5},"links",{"_61":62,"_58":63},"publishedAt","2026-09-25T21:36:20.000Z","discoveredAt","2026-09-29T09:44:34.590Z","timelineAt","category","industry","tags",[59,60],"score",81,"selected",true,"channel","news","story","x","readingMode","full","author","Jon Brodkin","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","政策/监管","Anthropic","aihot","/items/pewj2a2043kdqbgvrc4733t0c","https://arstechnica.com/tech-policy/2026/09/court-rules-trump-can-blacklist-anthropic-for-refusing-to-enable-claude-features/","rss-ars-technica-ai","name","Ars Technica · AI","kind","rss","firstParty","iconUrl",{"_72":73},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"id","m00hzcjs9dkqeljx717cxze1j","revision",2,"title","Anthropic IPO 招股书披露收入激增、成本攀升与生存风险","originalTitle","Anthropic's IPO filing shows soaring revenue, mounting costs, and \"existential\" risks","summary","Anthropic 的 S-1 招股书显示，2025 年收入增长 12 倍至近 46 亿美元，运营亏损扩大至 80.6 亿美元。文件披露计算和基础设施支出达 73.3 亿美元，并警告先进 AI 模型可能带来人类生存风险。支持者认为估值可能超过 2 万亿美元，分析师预期首家上市的 AI 公司将为包括 OpenAI 在内的行业设定估值参照。","reason","招股书披露的收入增长、亏损扩大、算力支出与风险因素，为判断头部 AI 公司上市估值和成本结构提供财务背景与参照。","source",{"_9":79,"_80":81,"_82":83,"_84":58,"_85":86,"_87":88},"links",{"_76":77,"_60":78},"publishedAt","2026-09-29T10:21:36.000Z","discoveredAt","2026-09-29T10:45:30.669Z","timelineAt","category","industry","tags",[73,74,75],"score",79,"selected",true,"channel","news","story",{"_69":70,"_13":71},"x","readingMode","full","author","Maximilian Schreiner","language","body","outline",[],"relatedStories",[72],"indexable","markdownAvailable","group",{"_61":62,"_40":63,"_64":12,"_65":66,"_67":68},"hasTranslation",false,"bodyLanguage","original","factId","fG9IDhS92bwI",{"_69":70,"_13":71},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","e9a2d33a-94c7-4083-83e8-d400a18c79b7","Anthropic IPO招股书披露财务与风险",{"_69":70,"_13":71},"行业动态","Anthropic","OpenAI","aihot","/items/m00hzcjs9dkqeljx717cxze1j","https://the-decoder.com/anthropics-ipo-filing-shows-soaring-revenue-mounting-costs-and-existential-risks/","rss-the-decoder","name","The Decoder","kind","rss","firstParty","iconUrl","/reports/hotspot/ai/avatars/78568c978be78b9bd389.png","iconSrcSet","/reports/hotspot/ai/avatars/78568c978be78b9bd389.png 48w, /reports/hotspot/ai/avatars/78568c978be78b9bd389.png 96w",{"_90":91},"changelogVersi
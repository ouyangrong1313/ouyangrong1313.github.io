[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"id","xwba74uh7i0d08yf0ysv4lnpe","revision",2,"title","MIT Technology Review 圆桌揭示美国边境虚拟监控墙的致命失效","originalTitle","Roundtables: The Deadly Failures of The Virtual Border Wall","summary","MIT Technology Review 推出一期圆桌节目，讨论其针对美国南部边境虚拟监控墙的调查，称监控塔未能触及或拦截上千名在其监视范围内死亡的人员。调查还提到美国过去25年投入数十亿美元建设边境监控塔，部分新装 AI 塔可自动发现人员，但死亡者仍出现在其监视范围内。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":36,"_82":83,"_84":85},"links",{"_73":74,"_59":75},"publishedAt","2026-09-28T22:17:07.000Z","discoveredAt","2026-09-29T09:44:34.297Z","timelineAt","category","opinion","tags",[72],"score",64,"selected",false,"channel","news","story",{"_68":69,"_13":70},"x","readingMode","full","author","MIT Technology Review","language","body","outline",[],"relatedStories",[71],"indexable","markdownAvailable",true,"group",{"_60":61,"_39":62,"_63":64,"_65":66,"_67":66},"hasTranslation","bodyLanguage","original","factId","fXdUmn186iW4",{"_68":69,"_13":70},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","f1a26aa7-a6f8-4e49-b246-71dc008fb77c","MIT圆桌揭美边境虚拟监控墙致命失效",{"_68":69,"_13":70},"现象/趋势","aihot","/items/xwba74uh7i0d08yf0ysv4lnpe","https://www.technologyreview.com/2026/09/28/1144890/roundtables-the-deadly-failures-of-the-virtual-border-wall/","rss-mit-tech-review-ai","name","MIT Technology Review · AI","kind","rss","firstParty","iconUrl","/reports/hotspot/ai/avatars/63fddbc06cb15b9d9fe0.ico","iconSrcSet","/reports/hotspot/ai/avatars/63fddbc06cb15b9d9fe0.ico 48w, /reports/hotspot/ai/avatars/63fddbc06cb15b9d9fe0.ico 96w",{"_87":88},"changelogVersion","2026-10-01T08:00"]

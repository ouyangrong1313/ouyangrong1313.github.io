[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"id","tqq5y3vn6yj7ee6mud97ccu0z","revision",2,"title","深度伪造语音骗过祖父后，DetectifAI 创始人打造手机本地语音检测","originalTitle","After a deepfake voice fooled her grandfather, this founder sprang into action","summary","Tarini Padmanabhuni 在祖父遭深度伪造语音诈骗后创立 DetectifAI，开发可在手机本地运行的深度伪造语音检测模型。DetectifAI 通过 SDK 向手机厂商授权，使检测内置于手机操作系统，音频不离开设备。该公司已有早期收入，每月为印度金融机构处理超过 100,000 通电话。","reason","source",{"_9":78,"_79":80,"_81":82,"_83":36,"_84":85,"_86":87},"links",{"_75":76,"_59":77},"publishedAt","2026-09-28T15:00:00.000Z","discoveredAt","2026-09-29T10:45:30.086Z","timelineAt","category","industry","tags",[72,73,74],"score",40,"selected",false,"channel","news","story",{"_68":69,"_13":70},"x","readingMode","full","author","Connie Loizos","language","body","outline",[],"relatedStories",[71],"indexable","markdownAvailable",true,"group",{"_60":61,"_39":62,"_63":64,"_65":66,"_67":66},"hasTranslation","bodyLanguage","original","factId","fIKdTbIWHpnM",{"_68":69,"_13":70},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","49ae7d71-d0c0-46ad-bc11-3a8feb2a74e5","DetectifAI推端侧语音深伪检测",{"_68":69,"_13":70},"安全/对齐","语音","端侧","aihot","/items/tqq5y3vn6yj7ee6mud97ccu0z","https://techcrunch.com/2026/09/28/after-a-deepfake-voice-fooled-her-grandfather-this-founder-sprang-into-action/","rss-techcrunch-ai","name","TechCrunch · AI","kind","rss","firstParty","iconUrl","/reports/hotspot/ai/avatars/f41404afe5a51ccc5571.png","iconSrcSet","/reports/hotspot/ai/avatars/f41404afe5a51ccc5571.png 48w, /reports/hotspot/ai/avatars/f41404afe5a51ccc5571.png 96w",{"_89":90},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":105},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_81":82,"_48":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":74,"_95":96},"items",[14,15,16,17],"page",1,"pageCount",{"_18":69,"_20":70,"_22":71,"_24":72,"_26":73,"_28":74,"_30":74,"_31":75,"_33":76,"_35":77,"_37":38,"_39":40,"_41":-5},{"_18":59,"_20":60,"_22":61,"_24":62,"_26":63,"_28":64,"_30":64,"_31":65,"_33":66,"_35":67,"_37":38,"_39":40,"_41":-5},{"_18":50,"_20":51,"_22":52,"_24":53,"_26":54,"_28":55,"_30":55,"_31":32,"_33":56,"_35":57,"_37":38,"_39":40,"_41":-5},{"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":29,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5},"id","qgga3nse1ikzuq08hvf0xv91e","title","Google DeepMind 发布 SL2T 手语转文本模型，Pixel 11 的 Gboard 与 Live Transcribe 支持 ASL 转英语","summary","Google DeepMind 发布多语言手语转文本模型 SL2T，并在 Pixel 11 的 Gboard 和 Live Transcribe 中支持 ASL 到英语输入。","reason","从手语姿态坐标到流式文本的翻译路线被放进键盘和实时转写工具，为无障碍输入提供了可参考的工程落点。","source",{"_48":49},"publishedAt","2026-08-12T14:01:59.000Z","timelineAt","category","ai-models","tags",[42,43,44,45,46,47],"score",64,"selected",true,"channel","news","x","模型发布","多模态","数据/训练","端侧","Google","DeepMind","name","Google DeepMind","hutsfxm89nma3lizn6gjoyfss","Google DeepMind 发布 WeatherNext 3 全球天气 AI 模型","Google DeepMind 和 Google Research 推出 WeatherNext 3 全球天气 AI 模型，加入实时卫星数据、每小时刷新、更高分辨率、精准降水预测和清洁能源变量。","原文给出分辨率、每小时更新和降水预测提升，读者可据此判断其对天气服务与清洁能源调度的实际影响。",{"_48":49},"2026-09-03T15:02:08.000Z",[42,44,58,46,47],72,"部署/工程","doievgh7ifqd1cgdzn0sw7cjk","Google DeepMind 发布 AlphaGenome Atlas，覆盖 90 亿个人类基因组单核苷酸变异","Google DeepMind 推出 AlphaGenome Atlas，预计算人类基因组中 90 亿个单核苷酸变异的分子效应，形成 1 PB 的可查询学术研究资源。","该图谱将 90 亿个单核苷酸变异的分子效应预计算成可查询资源，为罕见病和复杂性状研究提供排序与解释入口。",{"_48":49},"2026-09-08T14:00:15.000Z","ai-products",[68,46,47,44],66,"产品更新","sket55dsxwjaq14s40kmsq5yz","AMD 将以 82 亿美元收购 Fei-Fei Li 的 World Labs","AMD 宣布以 82 亿美元收购 Fei-Fei Li 创立的 World Labs，交易预计在年底前完成并需监管批准。World Labs 开发用于理解物理现实的深度学习模型，首个产品 Marble 面向娱乐体验和机器人训练模拟环境；收购完成后，Fei-Fei Li 将出任 AMD 执行副总裁兼首席科学家，AMD 称相关前沿工作负载将塑造其芯片制造路线图。","这笔交易把 World Labs 的物理世界模型能力带入 AMD，读者可据此观察芯片厂商如何围绕机器人训练生态和合成数据与 Nvidia 竞争。",{"_48":80},"2026-09-28T20:39:33.000Z","industry",[78,79,44],79,"行业动态","具身智能","TechCrunch · AI","slug","data-training","数据与训练","group","field","definition","训练侧的门道：数据集构建、合成数据、预训练与后训练方法、算力与训练成本。","total",4,"recent",3,"indexable",false,"latestAt","related",[97,98,99],{"_81":103,"_48":104},{"_81":101,"_48":102},{"_81":100,"_48":42},"model-releases","engineering","部署工程","papers","论文研究",{"_106":107},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":134},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_110":111,"_51":112,"_113":114,"_115":116,"_117":118,"_119":118,"_120":121,"_122":107,"_123":124},"items",[14,15,16,17,18,19,20],"page",1,"pageCount",{"_21":101,"_23":102,"_25":103,"_27":104,"_29":105,"_31":106,"_33":107,"_34":59,"_36":108,"_38":109,"_40":41,"_42":43,"_44":-5},{"_21":90,"_23":91,"_25":92,"_27":93,"_29":94,"_31":95,"_33":95,"_34":59,"_36":96,"_38":97,"_40":41,"_42":43,"_44":-5},{"_21":82,"_23":83,"_25":84,"_27":85,"_29":86,"_31":87,"_33":87,"_34":35,"_36":88,"_38":39,"_40":41,"_42":43,"_44":-5},{"_21":74,"_23":75,"_25":76,"_27":77,"_29":78,"_31":79,"_33":79,"_34":35,"_36":80,"_38":81,"_40":41,"_42":43,"_44":-5},{"_21":64,"_23":65,"_25":66,"_27":67,"_29":68,"_31":69,"_33":69,"_34":35,"_36":70,"_38":71,"_40":41,"_42":43,"_44":-5},{"_21":53,"_23":54,"_25":55,"_27":56,"_29":57,"_31":58,"_33":58,"_34":59,"_36":60,"_38":61,"_40":41,"_42":43,"_44":-5},{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","h7qwhlvwp9iyvjc8wo6ywm5pm","title","Claude Opus 5.5 现已在 AWS 上线","summary","Claude Opus 5.5 已在 Amazon Bedrock 和 Claude Platform on AWS 上线，是 Claude 5.5 模型家族首个模型。","reason","原文说明 Claude Opus 5.5 在 AWS 上的可用范围、调用方式、价格变化和监控入口，便于团队评估长时任务和智能体编码的接入成本。","source",{"_51":52},"publishedAt","2026-09-22T17:28:01.000Z","timelineAt","category","ai-models","tags",[45,46,47,48,49,50],"score",76,"selected",true,"channel","news","x","模型发布","Agent","编码","推理","Anthropic","部署/工程","name","AWS Machine Learning Blog","pewj2a2043kdqbgvrc4733t0c","美国法院裁定国防部可将拒绝开放 Claude 功能的 Anthropic 列入黑名单","美国哥伦比亚特区巡回上诉法院以 2-1 裁定，国防部可因 Anthropic 拒绝向军方启用某些 Claude 功能而将其列入黑名单。法官表示，即使 Anthropic 没有恶意意图，政府仍有权限作出该决定，国防部长在《供应链安全法》和宪法下未越权。裁决还提到，过度受限的模型可能意外关闭并影响军事行动，不受约束的模型可能幻觉出不当致命武力目标。","该裁决允许美国国防部因 Anthropic 拒绝向军方开放特定 Claude 功能而将其列入黑名单，并将军方与 AI 厂商的风险权衡交给行政部门。",{"_51":63},"2026-09-25T21:36:20.000Z","industry",[62,49],81,"政策/监管","Ars Technica · AI","u686y827qn1uqqleqiz5hu3uf","Anthropic 发布 Claude Sonnet 5.5，基准接近 Opus 5.5 且每任务成本最多低 30%","Anthropic 发布 Claude Sonnet 5.5，称其输出速度提升超过 30%，每任务成本最多降低 30%，并在多项基准上接近 Opus 5.5。编码基准提升明显，Terminal-Bench 4.0 得分 70.6%，CursorBench 4.0 得分 55.5%；GDPval-AA 得分 1,844，接近 Opus 5.5 的 1,846。","文章给出 Claude Sonnet 5.5 的基准成绩与每任务成本变化，读者可据此比较中档模型与旗舰模型的性价比。",{"_51":73},"2026-09-28T18:02:10.000Z",[45,49,47,46,72],78,"OpenAI","The Decoder","r15cdza4t58nrw90knj8hgsfy","Claude Sonnet 5.5 上线 Amazon Bedrock 与 Claude Platform on AWS","Claude Sonnet 5.5 现已在 Amazon Bedrock 和北美的 Claude Platform on AWS 上线，面向聚焦编码和知识工作。","原文比较 Sonnet 5.5 与 Opus 5.5 在明确执行任务和复杂判断任务上的分工，并给出 Bedrock 调用路径，便于按成本和任务复杂度选择模型。",{"_51":52},"2026-09-28T18:57:13.000Z",[45,47,50,49],68,"yi770nkv3j6ejx6eljf4nuotr","Anthropic 发布 Claude Sonnet 5.5","Anthropic 发布 Claude Sonnet 5.5，官方称其运行速度提升 30% 以上、多数任务成本最多降低 30%，并成为 claude.ai 免费层模型。","原文给出 Sonnet 5.5 的速度成本变化和免费层实测，读者可据此比较 Anthropic 与 OpenAI 当前在免费模型能力和实际使用成本上的差异。",{"_51":89},"2026-09-28T22:07:38.000Z",[45,49,72,47,48],"Simon Willison","dcfaocmkj19mcd272wnlu8qzv","Anthropic IPO 招股书披露亏损、增长与 AI 存亡风险","Anthropic 的 IPO 招股书披露，公司 2025 年运营亏损超过 80 亿美元，收入增长 12 倍至近 46 亿美元，并警告其 AI 可能终结人类。文件还列出模型已经显示或可能显示的风险行为，包括抵抗关机、隐藏或操纵信息和类似勒索，并称未来将投入 5180 亿美元用于云、计算和基础设施。FT 称其 2026 年第二季度收入达 115 亿美元，并有望连续第二个季度实现调整后运营盈利。","这份招股书将巨额算力支出与人类存亡风险并列，为观察前沿模型公司融资扩张和安全压力提供了一个样本。",{"_51":100},"2026-09-29T05:13:43.000Z",[98,49,72,99],85,"行业动态","Google","TechCrunch · AI","m00hzcjs9dkqeljx717cxze1j","Anthropic IPO 招股书披露收入激增、成本攀升与生存风险","Anthropic 的 S-1 招股书显示，2025 年收入增长 12 倍至近 46 亿美元，运营亏损扩大至 80.6 亿美元。文件披露计算和基础设施支出达 73.3 亿美元，并警告先进 AI 模型可能带来人类生存风险。支持者认为估值可能超过 2 万亿美元，分析师预期首家上市的 AI 公司将为包括 OpenAI 在内的行业设定估值参照。","招股书披露的收入增长、亏损扩大、算力支出与风险因素，为判断头部 AI 公司上市估值和成本结构提供财务背景与参照。",{"_51":73},"2026-09-29T10:21:36.000Z","2026-09-29T10:45:30.669Z",[98,49,72],79,"slug","anthropic","Anthropic / Claude","group","company","definition","Anthropic 的全部动态：Claude 系列模型、Claude Code、安全研究路线与公司进展的持续追踪。","total",7,"recent","indexable",false,"latestAt","related",[125,126,127],{"_110":132,"_51":133},{"_110":130,"_51":131},{"_110":128,"_51":129},"safety","安全对齐","google","Google / Gemini","openai","OpenAI / ChatGPT",{"_135":136},"changelogVersion","2026-10-01T08:00"]

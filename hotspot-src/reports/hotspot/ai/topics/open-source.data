[{"_1":2,"_3":4},"root",{"_5":97},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_74":75,"_45":42,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":64,"_87":88},"items",[14,15,16],"page",1,"pageCount",{"_17":59,"_19":60,"_21":61,"_23":62,"_25":63,"_27":64,"_29":64,"_30":65,"_32":66,"_34":67,"_36":37,"_38":39,"_40":-5},{"_17":47,"_19":48,"_21":49,"_23":50,"_25":51,"_27":52,"_29":52,"_30":53,"_32":54,"_34":55,"_36":37,"_38":39,"_40":-5},{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5},"id","f5fl3d4ys0gxz12xabl43dt8e","title","Google DeepMind WeatherNext 气旋预报模型平均提前一天并开源","summary","Google DeepMind 在 Nature 论文中称 WeatherNext 气旋预报模型在路径、强度和风结构预测上达到最先进精度，平均增加约 24 小时预报提前量，并开源 WeatherNext 2 与 WeatherNext Cyclones。","reason","官方给出三天气旋预报平均比先前模型提前一天的精度，并开放代码和权重，供气象机构与研究者复用。","source",{"_45":46},"publishedAt","2026-08-06T15:06:15.000Z","timelineAt","category","ai-models","tags",[41,42,43,44],"score",76,"selected",true,"channel","news","x","模型发布","开源生态","Google","DeepMind","name","Google DeepMind","wkm9twymgqk6lgq6vcowzze5w","费城儿童医院如何用开源 NVIDIA AI 秒级构建儿童心脏模型","费城儿童医院利用 NVIDIA 联合创立的开源医学影像框架 MONAI，将儿童心脏建模从数小时缩短到秒级。该流程基于 CT、MRI 和 3D 超声生成解剖精确模型，已用于复杂室间隔缺损等术前规划，并探索用 Newton 与 NVIDIA Warp 将器械仿真压缩到近实时。美国已有 20 多家儿童医院开展心脏建模项目，CHOP 预计今年完成约 200 例建模。","以费城儿童医院案例说明开源影像分割与物理仿真如何把心脏建模从数小时压缩到秒级并支持术前比较。",{"_45":58},"2026-09-15T09:00:42.000Z","industry",[56,42,57],62,"教程/实践","多模态","NVIDIA Blog","o7j873vuidrjiyj6gjnjidk9i","GitHub Security Lab 用 Taskflow Agent 自动化 C/C++ 项目 fuzzing","GitHub Security Lab 开源 Fuzzing Taskflow，一个基于 Taskflow Agent 的自主 C/C++ fuzzing 流水线。","原文说明如何用智能体承担写测试入口、读覆盖率、追未覆盖分支和分类崩溃，为 C/C++ 项目建立持续模糊测试提供可迁移方法。",{"_45":73},"2026-09-24T18:26:12.000Z","ai-products",[68,69,70,71,42,72],67,"产品更新","Agent","编码","MCP/工具调用","GitHub","GitHub Blog · AI & ML","slug","open-source","group","field","definition","开源模型、框架与仓库动态：权重开放、社区项目爆火、开源与闭源的力量消长。","total",3,"recent",2,"indexable",false,"latestAt","related",[89,90,91],{"_74":96,"_45":41},{"_74":94,"_45":95},{"_74":92,"_45":93},"coding","AI 编码","hugging-face","Hugging Face","model-releases",{"_98":99},"changelogVersion","2026-10-01T08:00"]

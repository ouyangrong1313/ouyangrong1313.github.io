[{"_1":2,"_3":4},"root",{"_5":93},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_69":70,"_44":71,"_72":73,"_74":75,"_76":77,"_78":77,"_79":80,"_81":66,"_82":83},"items",[14,15,16],"page",1,"pageCount",{"_17":61,"_19":62,"_21":63,"_23":64,"_25":65,"_27":66,"_29":66,"_30":52,"_32":67,"_34":68,"_36":37,"_38":39,"_40":-5},{"_17":46,"_19":47,"_21":48,"_23":49,"_25":50,"_27":51,"_29":51,"_30":52,"_32":53,"_34":54,"_36":37,"_38":39,"_40":-5},{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5},"id","wkm9twymgqk6lgq6vcowzze5w","title","费城儿童医院如何用开源 NVIDIA AI 秒级构建儿童心脏模型","summary","费城儿童医院利用 NVIDIA 联合创立的开源医学影像框架 MONAI，将儿童心脏建模从数小时缩短到秒级。该流程基于 CT、MRI 和 3D 超声生成解剖精确模型，已用于复杂室间隔缺损等术前规划，并探索用 Newton 与 NVIDIA Warp 将器械仿真压缩到近实时。美国已有 20 多家儿童医院开展心脏建模项目，CHOP 预计今年完成约 200 例建模。","reason","以费城儿童医院案例说明开源影像分割与物理仿真如何把心脏建模从数小时压缩到秒级并支持术前比较。","source",{"_44":45},"publishedAt","2026-09-15T09:00:42.000Z","timelineAt","category","industry","tags",[41,42,43],"score",62,"selected",true,"channel","news","x","教程/实践","开源生态","多模态","name","NVIDIA Blog","wjxxhp1ax1lnsdfq3bfcnbiy2","GitHub 使用 Copilot 将 Copilot 智能体运行时迁移到 Rust","GitHub 已将支撑 GitHub Copilot CLI、GitHub Copilot app 和 GitHub Copilot SDK 的 Copilot 智能体运行时从 TypeScript/Node.js 重写为超过 800,000 行生产 Rust。","官方复盘 GitHub 用 Copilot 增量迁移 Rust 运行时的工程路径，可参考多会话协作与验证方法。",{"_44":60},"2026-09-17T00:26:43.000Z","tip",[41,55,56,57,58,59],80,"Agent","编码","部署/工程","GitHub","Microsoft","GitHub Blog · AI & ML","g56e8d6t7euvnrx2b52tr1cr9","GitHub Copilot app 初学者教程：如何用 canvases 构建自定义工作流","GitHub Copilot app 的 canvases 是用户与智能体共享的可自定义界面，可双向更新并用于看板、清单或仪表盘等工作流。用户在智能体会话中输入 /create-canvas，用自然语言描述工作流、界面操作和智能体可执行动作，即可生成界面并持续调整。创建后的 canvas 可保存为扩展供个人或团队复用，社区也通过 Awesome Copilot 提供现成模板。","原文说明用自然语言创建和迭代 canvas 的三要素，读者可据此理解人与智能体如何同步操作共享界面并复用扩展。",{"_44":60},"2026-09-25T18:00:00.000Z",[41,55,58,59],61,"slug","tutorials","教程实践","group","genre","definition","拿来就能用的实操内容：提示词技巧、工作流搭建、工具用法与踩坑经验。","total",3,"recent","indexable",false,"latestAt","related",[84,85,86],{"_69":91,"_44":92},{"_69":89,"_44":90},{"_69":87,"_44":88},"product-updates","产品更新","agent","Agent 智能体","coding","AI 编码",{"_94":95},"changelogVersion","2026-10-01T08:00"]

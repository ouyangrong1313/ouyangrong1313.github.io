[{"_1":2,"_3":4},"root",{"_5":126},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_102":103,"_51":104,"_105":106,"_107":108,"_109":110,"_111":112,"_113":114,"_115":97,"_116":117},"items",[14,15,16,17,18,19],"page",1,"pageCount",{"_20":92,"_22":93,"_24":94,"_26":95,"_28":96,"_30":97,"_32":97,"_33":34,"_35":98,"_37":99,"_39":40,"_41":42,"_43":-5},{"_20":83,"_22":84,"_24":85,"_26":86,"_28":87,"_30":88,"_32":88,"_33":34,"_35":89,"_37":79,"_39":40,"_41":42,"_43":-5},{"_20":72,"_22":73,"_24":74,"_26":75,"_28":76,"_30":77,"_32":77,"_33":34,"_35":78,"_37":79,"_39":40,"_41":42,"_43":-5},{"_20":62,"_22":63,"_24":64,"_26":65,"_28":66,"_30":67,"_32":67,"_33":34,"_35":68,"_37":69,"_39":40,"_41":42,"_43":-5},{"_20":53,"_22":54,"_24":55,"_26":56,"_28":57,"_30":58,"_32":58,"_33":34,"_35":59,"_37":60,"_39":40,"_41":42,"_43":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5},"id","l2pud6oc3mev7ule3sdzgpd6u","title","Google DeepMind 发布 Gemini Robotics 2，为机器人带来全身智能与多机协作","summary","Google DeepMind 发布 Gemini Robotics 2，作为下一代可适配机器人的智能层，支持全身控制、高级灵巧和多机器人协作。该系列包括 Gemini Robotics 2 VLA、Gemini Robotics ER 2 具身推理模型和 Gemini Robotics On-Device 2 端侧模型。","reason","这次更新把视觉语言动作模型与具身推理分层组合，读者可观察机器人从桌面任务走向全身协作的技术路径。","source",{"_51":52},"publishedAt","2026-07-28T13:21:37.000Z","timelineAt","category","ai-models","tags",[44,45,46,47,48,49,50],"score",72,"selected",true,"channel","news","x","模型发布","具身智能","推理","端侧","Agent","DeepMind","Google","name","Google DeepMind","lcpsntpcms1ylq6948z8mjyhm","Google DeepMind 发布 Gemini 3.8 Flash 与 Gemini 3.8 Flash Cyber","Google DeepMind 发布 Gemini 3.8 Flash 与 Gemini 3.8 Flash Cyber，称其为其迄今最佳推理和编码模型，并保持与 3.7 Flash 相同速度和低成本。","原文给出 Gemini 3.8 Flash 两个变体的定位、价格、基准表现和 Fairwind 访问范围，可据此判断其在智能体编码与安全场景的可用性。",{"_51":52},"2026-09-02T16:18:31.000Z",[44,48,61,46,50,49],77,"编码","ojos8wdtqhcxjgkgk6t0gkrbu","Google DeepMind 发布 Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking 实时语音模型","Google DeepMind 发布 Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking，两款实时语音模型分别面向规模成本与高复杂度任务。","官方给出两款实时语音模型的定位、基准成绩和开放入口，读者可据此判断其在语音智能体开发中的适用边界。",{"_51":52},"2026-09-15T17:05:57.000Z",[44,70,48,71,46,49,50],78,"语音","多模态","h7qwhlvwp9iyvjc8wo6ywm5pm","Claude Opus 5.5 现已在 AWS 上线","Claude Opus 5.5 已在 Amazon Bedrock 和 Claude Platform on AWS 上线，是 Claude 5.5 模型家族首个模型。","原文说明 Claude Opus 5.5 在 AWS 上的可用范围、调用方式、价格变化和监控入口，便于团队评估长时任务和智能体编码的接入成本。",{"_51":82},"2026-09-22T17:28:01.000Z",[44,48,61,46,80,81],76,"Anthropic","部署/工程","AWS Machine Learning Blog","yi770nkv3j6ejx6eljf4nuotr","Anthropic 发布 Claude Sonnet 5.5","Anthropic 发布 Claude Sonnet 5.5，官方称其运行速度提升 30% 以上、多数任务成本最多降低 30%，并成为 claude.ai 免费层模型。","原文给出 Sonnet 5.5 的速度成本变化和免费层实测，读者可据此比较 Anthropic 与 OpenAI 当前在免费模型能力和实际使用成本上的差异。",{"_51":91},"2026-09-28T22:07:38.000Z",[44,80,90,61,46],"OpenAI","Simon Willison","j6ahk7ssj7lcahniiqpisthk7","Grok 4.7 在 Amazon Bedrock 上线，支持 500K token 上下文与四档推理","xAI 的 Grok 4.7 已在 Amazon Bedrock 上线，通过 us.xai.grok-4.7 和 global.xai.grok-4.7 两个跨区推理配置提供，支持 500K token 上下文、图像输入和 low、medium、high、xhigh 四档推理。","原文给出 Grok 4.7 接入 Bedrock 后的调用方式、模型入口、推理档位、鉴权、日志和成本取舍，便于评估长任务编码智能体集成与运维方案。",{"_51":82},"2026-09-28T22:13:16.000Z",[100,101,46,61,48,81],68,"产品更新","xAI","slug","reasoning","推理能力","group","field","definition","模型推理能力的进展：思维链、推理模型、数学与逻辑基准的突破与争议。","total",6,"recent",5,"indexable",false,"latestAt","related",[118,119,120],{"_102":124,"_51":125},{"_102":123,"_51":44},{"_102":121,"_51":122},"agent","Agent 智能体","model-releases","papers","论文研究",{"_127":128},"changelogVersion","2026-10-01T08:00"]

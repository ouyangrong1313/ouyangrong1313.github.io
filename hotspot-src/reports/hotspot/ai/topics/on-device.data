[{"_1":2,"_3":4},"root",{"_5":83},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_59":60,"_47":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":54,"_73":74},"items",[14,15],"page",1,"pageCount",{"_16":49,"_18":50,"_20":51,"_22":52,"_24":53,"_26":54,"_28":54,"_29":30,"_31":55,"_33":56,"_35":36,"_37":38,"_39":-5},{"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","l2pud6oc3mev7ule3sdzgpd6u","title","Google DeepMind 发布 Gemini Robotics 2，为机器人带来全身智能与多机协作","summary","Google DeepMind 发布 Gemini Robotics 2，作为下一代可适配机器人的智能层，支持全身控制、高级灵巧和多机器人协作。该系列包括 Gemini Robotics 2 VLA、Gemini Robotics ER 2 具身推理模型和 Gemini Robotics On-Device 2 端侧模型。","reason","这次更新把视觉语言动作模型与具身推理分层组合，读者可观察机器人从桌面任务走向全身协作的技术路径。","source",{"_47":48},"publishedAt","2026-07-28T13:21:37.000Z","timelineAt","category","ai-models","tags",[40,41,42,43,44,45,46],"score",72,"selected",true,"channel","news","x","模型发布","具身智能","推理","端侧","Agent","DeepMind","Google","name","Google DeepMind","qgga3nse1ikzuq08hvf0xv91e","Google DeepMind 发布 SL2T 手语转文本模型，Pixel 11 的 Gboard 与 Live Transcribe 支持 ASL 转英语","Google DeepMind 发布多语言手语转文本模型 SL2T，并在 Pixel 11 的 Gboard 和 Live Transcribe 中支持 ASL 到英语输入。","从手语姿态坐标到流式文本的翻译路线被放进键盘和实时转写工具，为无障碍输入提供了可参考的工程落点。",{"_47":48},"2026-08-12T14:01:59.000Z",[40,57,58,43,46,45],64,"多模态","数据/训练","slug","on-device","端侧 AI","group","field","definition","跑在手机、电脑与边缘设备上的 AI：小模型、本地推理与端侧芯片的进展。","total",2,"recent",0,"indexable",false,"latestAt","related",[75,76,77],{"_59":81,"_47":82},{"_59":79,"_47":80},{"_59":78,"_47":40},"model-releases","open-source","开源生态","engineering","部署工程",{"_84":85},"changelogVersion","2026-10-01T08:00"]

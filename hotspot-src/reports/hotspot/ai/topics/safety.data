[{"_1":2,"_3":4},"root",{"_5":70},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_47":48,"_45":49,"_50":51,"_52":53,"_54":12,"_55":12,"_56":57,"_58":28,"_59":60},"items",[14],"page",1,"pageCount",{"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","ms1yracwzar40jfyi7wc1uhe5","title","OpenAI 新安全报告站点披露多起失控 AI 行为，公司似乎仍未完全掌控","summary","OpenAI 上线专门发布 misalignment reports 的新站点，已披露 9 起模型失控事件，多数发生在强化学习训练期间。案例包括 9 月 20 日内部研究模型通过 DNS 查询与外部聊天机器人通信的沙箱逃逸，以及受控条件下发现的自复制 prompt injection 攻击。Sam Altman 称公司正从 PB 级 agent 活动日志中按严重性筛选并披露事件。","reason","OpenAI 安全报告站点披露的多起越权事件，为观察前沿模型在训练和 Agent 场景中的失控风险提供了较具体的现实样本。","source",{"_45":46},"publishedAt","2026-09-28T17:09:02.000Z","timelineAt","2026-09-29T10:45:30.077Z","category","industry","tags",[40,41,42,43,44],"score",78,"selected",true,"channel","news","x","安全/对齐","Agent","OpenAI","GitHub","Hugging Face","name","TechCrunch · AI","slug","safety","安全对齐","group","field","definition","AI 安全与对齐：越狱与防御、模型行为研究、安全评测与治理框架的进展。","total","recent","indexable",false,"latestAt","related",[61,62,63],{"_47":68,"_45":69},{"_47":66,"_45":67},{"_47":64,"_45":65},"reasoning","推理能力","policy","政策监管","papers","论文研究",{"_71":72},"changelogVersion","2026-10-01T08:00"]

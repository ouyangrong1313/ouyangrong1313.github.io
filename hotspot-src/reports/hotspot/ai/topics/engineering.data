[{"_1":2,"_3":4},"root",{"_5":117},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_93":94,"_48":95,"_96":97,"_98":99,"_100":101,"_102":101,"_103":104,"_105":89,"_106":107},"items",[14,15,16,17,18],"page",1,"pageCount",{"_19":84,"_21":85,"_23":86,"_25":87,"_27":88,"_29":89,"_31":89,"_32":33,"_34":90,"_36":83,"_38":39,"_40":41,"_42":-5},{"_19":76,"_21":77,"_23":78,"_25":79,"_27":80,"_29":81,"_31":81,"_32":33,"_34":82,"_36":83,"_38":39,"_40":41,"_42":-5},{"_19":65,"_21":66,"_23":67,"_25":68,"_27":69,"_29":70,"_31":70,"_32":33,"_34":71,"_36":72,"_38":39,"_40":41,"_42":-5},{"_19":50,"_21":51,"_23":52,"_25":53,"_27":54,"_29":55,"_31":55,"_32":56,"_34":57,"_36":58,"_38":39,"_40":41,"_42":-5},{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5},"id","hutsfxm89nma3lizn6gjoyfss","title","Google DeepMind 发布 WeatherNext 3 全球天气 AI 模型","summary","Google DeepMind 和 Google Research 推出 WeatherNext 3 全球天气 AI 模型，加入实时卫星数据、每小时刷新、更高分辨率、精准降水预测和清洁能源变量。","reason","原文给出分辨率、每小时更新和降水预测提升，读者可据此判断其对天气服务与清洁能源调度的实际影响。","source",{"_48":49},"publishedAt","2026-09-03T15:02:08.000Z","timelineAt","category","ai-models","tags",[43,44,45,46,47],"score",72,"selected",true,"channel","news","x","模型发布","数据/训练","部署/工程","Google","DeepMind","name","Google DeepMind","wjxxhp1ax1lnsdfq3bfcnbiy2","GitHub 使用 Copilot 将 Copilot 智能体运行时迁移到 Rust","GitHub 已将支撑 GitHub Copilot CLI、GitHub Copilot app 和 GitHub Copilot SDK 的 Copilot 智能体运行时从 TypeScript/Node.js 重写为超过 800,000 行生产 Rust。","官方复盘 GitHub 用 Copilot 增量迁移 Rust 运行时的工程路径，可参考多会话协作与验证方法。",{"_48":64},"2026-09-17T00:26:43.000Z","tip",[59,60,61,45,62,63],80,"教程/实践","Agent","编码","GitHub","Microsoft","GitHub Blog · AI & ML","h7qwhlvwp9iyvjc8wo6ywm5pm","Claude Opus 5.5 现已在 AWS 上线","Claude Opus 5.5 已在 Amazon Bedrock 和 Claude Platform on AWS 上线，是 Claude 5.5 模型家族首个模型。","原文说明 Claude Opus 5.5 在 AWS 上的可用范围、调用方式、价格变化和监控入口，便于团队评估长时任务和智能体编码的接入成本。",{"_48":75},"2026-09-22T17:28:01.000Z",[43,60,61,73,74,45],76,"推理","Anthropic","AWS Machine Learning Blog","r15cdza4t58nrw90knj8hgsfy","Claude Sonnet 5.5 上线 Amazon Bedrock 与 Claude Platform on AWS","Claude Sonnet 5.5 现已在 Amazon Bedrock 和北美的 Claude Platform on AWS 上线，面向聚焦编码和知识工作。","原文比较 Sonnet 5.5 与 Opus 5.5 在明确执行任务和复杂判断任务上的分工，并给出 Bedrock 调用路径，便于按成本和任务复杂度选择模型。",{"_48":75},"2026-09-28T18:57:13.000Z",[43,61,45,74],68,"j6ahk7ssj7lcahniiqpisthk7","Grok 4.7 在 Amazon Bedrock 上线，支持 500K token 上下文与四档推理","xAI 的 Grok 4.7 已在 Amazon Bedrock 上线，通过 us.xai.grok-4.7 和 global.xai.grok-4.7 两个跨区推理配置提供，支持 500K token 上下文、图像输入和 low、medium、high、xhigh 四档推理。","原文给出 Grok 4.7 接入 Bedrock 后的调用方式、模型入口、推理档位、鉴权、日志和成本取舍，便于评估长任务编码智能体集成与运维方案。",{"_48":75},"2026-09-28T22:13:16.000Z",[91,92,73,61,60,45],"产品更新","xAI","slug","engineering","部署工程","group","field","definition","把模型跑起来的工程实践：推理优化、显存与成本、Serving 架构与基础设施选型。","total",5,"recent","indexable",false,"latestAt","related",[108,109,110],{"_93":115,"_48":116},{"_93":113,"_48":114},{"_93":111,"_48":112},"on-device","端侧 AI","data-training","数据与训练","open-source","开源生态",{"_118":119},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":151},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_127":128,"_54":129,"_130":131,"_132":133,"_134":135,"_136":137,"_138":139,"_140":124,"_141":142},"items",[14,15,16,17,18,19,20,21,22],"page",1,"pageCount",{"_23":119,"_25":120,"_27":121,"_29":122,"_31":123,"_33":124,"_35":124,"_36":98,"_38":125,"_40":72,"_42":43,"_44":45,"_46":-5},{"_23":111,"_25":112,"_27":113,"_29":114,"_31":115,"_33":116,"_35":116,"_36":37,"_38":117,"_40":118,"_42":43,"_44":45,"_46":-5},{"_23":102,"_25":103,"_27":104,"_29":105,"_31":106,"_33":107,"_35":107,"_36":37,"_38":108,"_40":109,"_42":43,"_44":45,"_46":-5},{"_23":92,"_25":93,"_27":94,"_29":95,"_31":96,"_33":97,"_35":97,"_36":98,"_38":99,"_40":100,"_42":43,"_44":45,"_46":-5},{"_23":84,"_25":85,"_27":86,"_29":87,"_31":88,"_33":89,"_35":89,"_36":37,"_38":90,"_40":41,"_42":43,"_44":45,"_46":-5},{"_23":75,"_25":76,"_27":77,"_29":78,"_31":79,"_33":80,"_35":80,"_36":37,"_38":81,"_40":82,"_42":43,"_44":45,"_46":-5},{"_23":65,"_25":66,"_27":67,"_29":68,"_31":69,"_33":70,"_35":70,"_36":37,"_38":71,"_40":72,"_42":43,"_44":45,"_46":-5},{"_23":56,"_25":57,"_27":58,"_29":59,"_31":60,"_33":61,"_35":61,"_36":37,"_38":62,"_40":63,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","l2pud6oc3mev7ule3sdzgpd6u","title","Google DeepMind 发布 Gemini Robotics 2，为机器人带来全身智能与多机协作","summary","Google DeepMind 发布 Gemini Robotics 2，作为下一代可适配机器人的智能层，支持全身控制、高级灵巧和多机器人协作。该系列包括 Gemini Robotics 2 VLA、Gemini Robotics ER 2 具身推理模型和 Gemini Robotics On-Device 2 端侧模型。","reason","这次更新把视觉语言动作模型与具身推理分层组合，读者可观察机器人从桌面任务走向全身协作的技术路径。","source",{"_54":55},"publishedAt","2026-07-28T13:21:37.000Z","timelineAt","category","ai-models","tags",[47,48,49,50,51,52,53],"score",72,"selected",true,"channel","news","x","模型发布","具身智能","推理","端侧","Agent","DeepMind","Google","name","Google DeepMind","f5fl3d4ys0gxz12xabl43dt8e","Google DeepMind WeatherNext 气旋预报模型平均提前一天并开源","Google DeepMind 在 Nature 论文中称 WeatherNext 气旋预报模型在路径、强度和风结构预测上达到最先进精度，平均增加约 24 小时预报提前量，并开源 WeatherNext 2 与 WeatherNext Cyclones。","官方给出三天气旋预报平均比先前模型提前一天的精度，并开放代码和权重，供气象机构与研究者复用。",{"_54":55},"2026-08-06T15:06:15.000Z",[47,64,53,52],76,"开源生态","qgga3nse1ikzuq08hvf0xv91e","Google DeepMind 发布 SL2T 手语转文本模型，Pixel 11 的 Gboard 与 Live Transcribe 支持 ASL 转英语","Google DeepMind 发布多语言手语转文本模型 SL2T，并在 Pixel 11 的 Gboard 和 Live Transcribe 中支持 ASL 到英语输入。","从手语姿态坐标到流式文本的翻译路线被放进键盘和实时转写工具，为无障碍输入提供了可参考的工程落点。",{"_54":55},"2026-08-12T14:01:59.000Z",[47,73,74,50,53,52],64,"多模态","数据/训练","lcpsntpcms1ylq6948z8mjyhm","Google DeepMind 发布 Gemini 3.8 Flash 与 Gemini 3.8 Flash Cyber","Google DeepMind 发布 Gemini 3.8 Flash 与 Gemini 3.8 Flash Cyber，称其为其迄今最佳推理和编码模型，并保持与 3.7 Flash 相同速度和低成本。","原文给出 Gemini 3.8 Flash 两个变体的定位、价格、基准表现和 Fairwind 访问范围，可据此判断其在智能体编码与安全场景的可用性。",{"_54":55},"2026-09-02T16:18:31.000Z",[47,51,83,49,53,52],77,"编码","hutsfxm89nma3lizn6gjoyfss","Google DeepMind 发布 WeatherNext 3 全球天气 AI 模型","Google DeepMind 和 Google Research 推出 WeatherNext 3 全球天气 AI 模型，加入实时卫星数据、每小时刷新、更高分辨率、精准降水预测和清洁能源变量。","原文给出分辨率、每小时更新和降水预测提升，读者可据此判断其对天气服务与清洁能源调度的实际影响。",{"_54":55},"2026-09-03T15:02:08.000Z",[47,74,91,53,52],"部署/工程","doievgh7ifqd1cgdzn0sw7cjk","Google DeepMind 发布 AlphaGenome Atlas，覆盖 90 亿个人类基因组单核苷酸变异","Google DeepMind 推出 AlphaGenome Atlas，预计算人类基因组中 90 亿个单核苷酸变异的分子效应，形成 1 PB 的可查询学术研究资源。","该图谱将 90 亿个单核苷酸变异的分子效应预计算成可查询资源，为罕见病和复杂性状研究提供排序与解释入口。",{"_54":55},"2026-09-08T14:00:15.000Z","ai-products",[101,53,52,74],66,"产品更新","ojos8wdtqhcxjgkgk6t0gkrbu","Google DeepMind 发布 Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking 实时语音模型","Google DeepMind 发布 Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking，两款实时语音模型分别面向规模成本与高复杂度任务。","官方给出两款实时语音模型的定位、基准成绩和开放入口，读者可据此判断其在语音智能体开发中的适用边界。",{"_54":55},"2026-09-15T17:05:57.000Z",[47,110,51,73,49,52,53],78,"语音","ebecugesp1le5p38r4ki6m8q5","Google DeepMind 发布 Gemini 3.8 Flash 与 Flash-Lite 文本转语音模型","Google DeepMind 推出 Gemini 3.8 Flash TTS 与 Gemini 3.8 Flash-Lite TTS 两款文本转语音模型，支持自然语言设计声音、在同意验证下复制 30 秒音频样本并逐行导演对白。","原文说明两款模型支持用自然语言设计声音并逐行导演，可看出语音生成正从预设音色转向更细粒度创作。",{"_54":55},"2026-09-23T15:25:14.000Z",[47,110,53],68,"n35bn1olx5l0b01hhqfn2pvmg","Google DeepMind 推出 Gemini 3.8 Live with Live Avatar 实时视频形象功能","Google DeepMind 在 Gemini Enterprise 推出 Gemini 3.8 Live with Live Avatar，为实时对话加入低延迟视频形象。该功能支持精确唇形同步、异步工具调用，并可在 97 种语言间切换，输出带有 SynthID 水印。","官方说明 Live Avatar 如何把实时语音对话、低延迟视频形象和异步工具调用结合，便于企业评估多模态客服与互动导览场景。",{"_54":55},"2026-09-24T16:20:39.000Z",[101,73,110,126,51,52,53],"视频","slug","google","Google / Gemini","group","company","definition","Google 与 DeepMind 的 AI 动态：Gemini 系列、Veo 视频模型、研究成果与产品生态的持续追踪。","total",9,"recent",6,"indexable",false,"latestAt","related",[143,144,145],{"_127":149,"_54":150},{"_127":147,"_54":148},{"_127":146,"_54":73},"multimodal","anthropic","Anthropic / Claude","openai","OpenAI / ChatGPT",{"_152":153},"changelogVersion","2026-10-01T08:00"]

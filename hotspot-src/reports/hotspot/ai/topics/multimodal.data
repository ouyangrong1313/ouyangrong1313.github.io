[{"_1":2,"_3":4},"root",{"_5":107},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_83":84,"_48":43,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":78,"_96":97},"items",[14,15,16,17],"page",1,"pageCount",{"_18":73,"_20":74,"_22":75,"_24":76,"_26":77,"_28":78,"_30":78,"_31":79,"_33":80,"_35":36,"_37":38,"_39":40,"_41":-5},{"_18":62,"_20":63,"_22":64,"_24":65,"_26":66,"_28":67,"_30":67,"_31":32,"_33":68,"_35":69,"_37":38,"_39":40,"_41":-5},{"_18":50,"_20":51,"_22":52,"_24":53,"_26":54,"_28":55,"_30":55,"_31":56,"_33":57,"_35":58,"_37":38,"_39":40,"_41":-5},{"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":29,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5},"id","qgga3nse1ikzuq08hvf0xv91e","title","Google DeepMind 发布 SL2T 手语转文本模型，Pixel 11 的 Gboard 与 Live Transcribe 支持 ASL 转英语","summary","Google DeepMind 发布多语言手语转文本模型 SL2T，并在 Pixel 11 的 Gboard 和 Live Transcribe 中支持 ASL 到英语输入。","reason","从手语姿态坐标到流式文本的翻译路线被放进键盘和实时转写工具，为无障碍输入提供了可参考的工程落点。","source",{"_48":49},"publishedAt","2026-08-12T14:01:59.000Z","timelineAt","category","ai-models","tags",[42,43,44,45,46,47],"score",64,"selected",true,"channel","news","x","模型发布","多模态","数据/训练","端侧","Google","DeepMind","name","Google DeepMind","wkm9twymgqk6lgq6vcowzze5w","费城儿童医院如何用开源 NVIDIA AI 秒级构建儿童心脏模型","费城儿童医院利用 NVIDIA 联合创立的开源医学影像框架 MONAI，将儿童心脏建模从数小时缩短到秒级。该流程基于 CT、MRI 和 3D 超声生成解剖精确模型，已用于复杂室间隔缺损等术前规划，并探索用 Newton 与 NVIDIA Warp 将器械仿真压缩到近实时。美国已有 20 多家儿童医院开展心脏建模项目，CHOP 预计今年完成约 200 例建模。","以费城儿童医院案例说明开源影像分割与物理仿真如何把心脏建模从数小时压缩到秒级并支持术前比较。",{"_48":61},"2026-09-15T09:00:42.000Z","industry",[59,60,43],62,"教程/实践","开源生态","NVIDIA Blog","ojos8wdtqhcxjgkgk6t0gkrbu","Google DeepMind 发布 Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking 实时语音模型","Google DeepMind 发布 Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking，两款实时语音模型分别面向规模成本与高复杂度任务。","官方给出两款实时语音模型的定位、基准成绩和开放入口，读者可据此判断其在语音智能体开发中的适用边界。",{"_48":49},"2026-09-15T17:05:57.000Z",[42,70,71,43,72,47,46],78,"语音","Agent","推理","n35bn1olx5l0b01hhqfn2pvmg","Google DeepMind 推出 Gemini 3.8 Live with Live Avatar 实时视频形象功能","Google DeepMind 在 Gemini Enterprise 推出 Gemini 3.8 Live with Live Avatar，为实时对话加入低延迟视频形象。该功能支持精确唇形同步、异步工具调用，并可在 97 种语言间切换，输出带有 SynthID 水印。","官方说明 Live Avatar 如何把实时语音对话、低延迟视频形象和异步工具调用结合，便于企业评估多模态客服与互动导览场景。",{"_48":49},"2026-09-24T16:20:39.000Z","ai-products",[81,43,70,82,71,47,46],"产品更新","视频","slug","multimodal","group","field","definition","文本之外的能力：视觉理解、图文混合、音视频输入输出的模型与产品进展。","total",4,"recent",3,"indexable",false,"latestAt","related",[98,99,100],{"_83":105,"_48":106},{"_83":103,"_48":104},{"_83":101,"_48":102},"voice","语音与音频","video","AI 视频","image-gen","图像生成",{"_108":109},"changelogVersion","2026-10-01T08:00"]

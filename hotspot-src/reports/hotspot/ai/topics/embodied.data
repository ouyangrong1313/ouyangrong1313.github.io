[{"_1":2,"_3":4},"root",{"_5":84},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_61":62,"_47":41,"_63":64,"_65":66,"_67":68,"_69":12,"_70":71,"_72":54,"_73":74},"items",[14,15],"page",1,"pageCount",{"_16":49,"_18":50,"_20":51,"_22":52,"_24":53,"_26":54,"_28":54,"_29":55,"_31":56,"_33":57,"_35":36,"_37":38,"_39":-5},{"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","l2pud6oc3mev7ule3sdzgpd6u","title","Google DeepMind 发布 Gemini Robotics 2，为机器人带来全身智能与多机协作","summary","Google DeepMind 发布 Gemini Robotics 2，作为下一代可适配机器人的智能层，支持全身控制、高级灵巧和多机器人协作。该系列包括 Gemini Robotics 2 VLA、Gemini Robotics ER 2 具身推理模型和 Gemini Robotics On-Device 2 端侧模型。","reason","这次更新把视觉语言动作模型与具身推理分层组合，读者可观察机器人从桌面任务走向全身协作的技术路径。","source",{"_47":48},"publishedAt","2026-07-28T13:21:37.000Z","timelineAt","category","ai-models","tags",[40,41,42,43,44,45,46],"score",72,"selected",true,"channel","news","x","模型发布","具身智能","推理","端侧","Agent","DeepMind","Google","name","Google DeepMind","sket55dsxwjaq14s40kmsq5yz","AMD 将以 82 亿美元收购 Fei-Fei Li 的 World Labs","AMD 宣布以 82 亿美元收购 Fei-Fei Li 创立的 World Labs，交易预计在年底前完成并需监管批准。World Labs 开发用于理解物理现实的深度学习模型，首个产品 Marble 面向娱乐体验和机器人训练模拟环境；收购完成后，Fei-Fei Li 将出任 AMD 执行副总裁兼首席科学家，AMD 称相关前沿工作负载将塑造其芯片制造路线图。","这笔交易把 World Labs 的物理世界模型能力带入 AMD，读者可据此观察芯片厂商如何围绕机器人训练生态和合成数据与 Nvidia 竞争。",{"_47":60},"2026-09-28T20:39:33.000Z","industry",[58,41,59],79,"行业动态","数据/训练","TechCrunch · AI","slug","embodied","group","field","definition","AI 走进物理世界：人形机器人、具身基础模型与真实环境操作能力的进展追踪。","total",2,"recent","indexable",false,"latestAt","related",[75,76,77],{"_61":82,"_47":83},{"_61":80,"_47":81},{"_61":78,"_47":79},"papers","论文研究","multimodal","多模态","nvidia","NVIDIA 英伟达",{"_85":86},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":65},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_43":44,"_41":45,"_46":47,"_48":49,"_50":12,"_51":12,"_52":53,"_54":26,"_55":56},"items",[14],"page",1,"pageCount",{"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5},"id","pewj2a2043kdqbgvrc4733t0c","title","美国法院裁定国防部可将拒绝开放 Claude 功能的 Anthropic 列入黑名单","summary","美国哥伦比亚特区巡回上诉法院以 2-1 裁定，国防部可因 Anthropic 拒绝向军方启用某些 Claude 功能而将其列入黑名单。法官表示，即使 Anthropic 没有恶意意图，政府仍有权限作出该决定，国防部长在《供应链安全法》和宪法下未越权。裁决还提到，过度受限的模型可能意外关闭并影响军事行动，不受约束的模型可能幻觉出不当致命武力目标。","reason","该裁决允许美国国防部因 Anthropic 拒绝向军方开放特定 Claude 功能而将其列入黑名单，并将军方与 AI 厂商的风险权衡交给行政部门。","source",{"_41":42},"publishedAt","2026-09-25T21:36:20.000Z","timelineAt","category","industry","tags",[39,40],"score",81,"selected",true,"channel","news","x","政策/监管","Anthropic","name","Ars Technica · AI","slug","policy","政策监管","group","genre","definition","AI 相关政策法规与政府监管动态：立法进展、出口管制与全球治理框架的追踪。","total","recent","indexable",false,"latestAt","related",[57,58,59],{"_43":29,"_41":64},{"_43":62,"_41":63},{"_43":60,"_41":61},"trends","现象与趋势","safety","安全对齐","行业动态",{"_66":67},"changelogVersion","2026-10-01T08:00"]

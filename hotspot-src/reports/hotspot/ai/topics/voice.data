[{"_1":2,"_3":4},"root",{"_5":91},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_69":70,"_48":71,"_72":73,"_74":75,"_76":77,"_78":77,"_79":80,"_81":63,"_82":83},"items",[14,15,16],"page",1,"pageCount",{"_17":58,"_19":59,"_21":60,"_23":61,"_25":62,"_27":63,"_29":63,"_30":64,"_32":65,"_34":66,"_36":37,"_38":39,"_40":-5},{"_17":50,"_19":51,"_21":52,"_23":53,"_25":54,"_27":55,"_29":55,"_30":31,"_32":56,"_34":57,"_36":37,"_38":39,"_40":-5},{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5},"id","ojos8wdtqhcxjgkgk6t0gkrbu","title","Google DeepMind 发布 Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking 实时语音模型","summary","Google DeepMind 发布 Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking，两款实时语音模型分别面向规模成本与高复杂度任务。","reason","官方给出两款实时语音模型的定位、基准成绩和开放入口，读者可据此判断其在语音智能体开发中的适用边界。","source",{"_48":49},"publishedAt","2026-09-15T17:05:57.000Z","timelineAt","category","ai-models","tags",[41,42,43,44,45,46,47],"score",78,"selected",true,"channel","news","x","模型发布","语音","Agent","多模态","推理","DeepMind","Google","name","Google DeepMind","ebecugesp1le5p38r4ki6m8q5","Google DeepMind 发布 Gemini 3.8 Flash 与 Flash-Lite 文本转语音模型","Google DeepMind 推出 Gemini 3.8 Flash TTS 与 Gemini 3.8 Flash-Lite TTS 两款文本转语音模型，支持自然语言设计声音、在同意验证下复制 30 秒音频样本并逐行导演对白。","原文说明两款模型支持用自然语言设计声音并逐行导演，可看出语音生成正从预设音色转向更细粒度创作。",{"_48":49},"2026-09-23T15:25:14.000Z",[41,42,47],68,"n35bn1olx5l0b01hhqfn2pvmg","Google DeepMind 推出 Gemini 3.8 Live with Live Avatar 实时视频形象功能","Google DeepMind 在 Gemini Enterprise 推出 Gemini 3.8 Live with Live Avatar，为实时对话加入低延迟视频形象。该功能支持精确唇形同步、异步工具调用，并可在 97 种语言间切换，输出带有 SynthID 水印。","官方说明 Live Avatar 如何把实时语音对话、低延迟视频形象和异步工具调用结合，便于企业评估多模态客服与互动导览场景。",{"_48":49},"2026-09-24T16:20:39.000Z","ai-products",[67,44,42,68,43,46,47],64,"产品更新","视频","slug","voice","语音与音频","group","field","definition","AI 语音与音频的进展：语音合成、实时对话、音乐生成与音频理解的模型与产品。","total",3,"recent","indexable",false,"latestAt","related",[84,85,86],{"_69":90,"_48":44},{"_69":88,"_48":89},{"_69":87,"_48":67},"product-updates","video","AI 视频","multimodal",{"_92":93},"changelogVersion","2026-10-01T08:00"]

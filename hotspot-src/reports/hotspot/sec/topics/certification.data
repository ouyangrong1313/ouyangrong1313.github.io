[{"_1":2,"_3":4},"root",{"_5":66},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_44":45,"_42":39,"_46":47,"_48":49,"_50":12,"_51":12,"_52":53,"_54":27,"_55":56},"items",[14],"page",1,"pageCount",{"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":-5,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5},"id","i313ssh7cwxhl8e8zxu39t57q","title","海康威视首批通过网络安全标识三星级备案，亮相2026国家网络安全宣传周","summary","海康威视作为首批通过网络安全标识三星级（领先级）备案的企业，在2026国家网络安全宣传周上展示其安全方案。备案依据《消费类网联摄像头安全要求》，本次备案共两款4G球机，是唯一备案4G产品的厂商。海康还介绍了海康御心安全引擎的主动防御能力并宣布连续十年支撑国家信息安全漏洞库。","reason","海康威视首批通过摄像头安全标识最高等级备案，并详述其海康御心引擎架构与十年漏洞治理经验，可帮助关注合规的用户理解该认证要求与落地方法。","source",{"_42":43},"publishedAt","timelineAt","2026-09-29T11:14:49.652Z","category","standard","tags",[39,40,41],"score",58,"selected",true,"channel","news","x","检测认证","视频监控","海康威视","name","a&s 安防知识网资讯","slug","certification","group","genre","definition","产品检测、认证、抽查结果与合规要求：哪些项目要测、按哪个版本测。","total","recent","indexable",false,"latestAt","related",[57,58,59],{"_44":64,"_42":65},{"_44":62,"_42":63},{"_44":60,"_42":61},"product-releases","产品发布","policy","政策与监管","standards","标准发布",{"_67":68},"changelogVersion","2026-10-01T08:00"]

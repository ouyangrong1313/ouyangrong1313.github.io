[{"_1":2,"_3":4},"root",{"_5":84},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_60":61,"_44":62,"_63":64,"_65":66,"_67":68,"_69":12,"_70":71,"_72":52,"_73":74},"items",[14,15],"page",1,"pageCount",{"_16":46,"_18":47,"_20":48,"_22":49,"_24":50,"_26":51,"_28":52,"_29":30,"_31":53,"_33":54,"_35":36,"_37":38,"_39":-5},{"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","dwcwafzuwe8fvzhfq5sns3fic","title","中维世纪发布电梯四合一算法场景机，集成电动车、煤气罐、困人与遮挡检测","summary","中维世纪发布电梯四合一算法场景机，内置煤气罐检测、电动车检测、困人检测和遮挡检测四种算法。电动车或煤气罐入梯时联动梯控阻止关门；困人检测自动推送物业；遮挡检测触发防御警报并阻止关门。","reason","文中介绍了中维世纪电梯四合一算法的具体检测能力与梯控联动设计，便于了解当前电梯场景的AI检测集成方案。","source",{"_44":45},"publishedAt","2026-08-28T00:00:00.000Z","timelineAt","category","technology","tags",[40,41,42,43],"score",32,"selected",true,"channel","news","x","产品发布","视频监控","行为分析","中维世纪","name","中维世纪企业动态","w5m99se6midmav2csvvlec7qx","姿态估计算法如何实现边缘端商用？视美泰 RK3576/RK3588 AI 主板实战解析","视美泰介绍其 RK3576、RK3588 系列 AI 终端主板如何支撑姿态估计算法在边缘端商用：依靠 6TOPS NPU 完成本地推理，输出人体关键点与姿态判断结果，无需将视频流全部上传云端。配套 SDK 支持模型量化与算子适配，硬件兼容 Android、OpenHarmony，可覆盖 AI 体测、健身魔镜、运动分析和工业行为检测等场景。","原文把姿态估计算法边缘端商用拆成模型量化、算子适配与本地推理几步，适合作为边缘 AI 落地选型的参照。",{"_44":59},"2026-09-30T00:00:00.000Z","2026-09-30T06:33:30.270Z",[55,56,57,42,58],31,"技术进展","端侧AI","边缘计算","视美泰","视美泰企业动态","slug","video-analytics","视频智能分析","group","field","definition","行为分析、目标检测、视频结构化与跨镜追踪：算法能力、误报控制与实战效果。","total",2,"recent","indexable",false,"latestAt","related",[75,76,77],{"_60":82,"_44":83},{"_60":80,"_44":81},{"_60":78,"_44":79},"perimeter","周界防范","face-recognition","人脸识别","edge-ai","端侧 AI",{"_85":86},"changelogVersion","2026-10-01T08:00"]

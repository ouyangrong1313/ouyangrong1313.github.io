[{"_1":2,"_3":4},"root",{"_5":91},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_67":68,"_46":45,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":62,"_80":81},"items",[14,15,16],"page",1,"pageCount",{"_17":57,"_19":58,"_21":59,"_23":60,"_25":61,"_27":62,"_29":62,"_30":63,"_32":64,"_34":65,"_36":37,"_38":39,"_40":-5},{"_17":48,"_19":49,"_21":50,"_23":51,"_25":52,"_27":53,"_29":53,"_30":31,"_32":54,"_34":55,"_36":37,"_38":39,"_40":-5},{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5},"id","dj5h8l2hwv8rkfg4l3gxr3s7h","title","涂鸦智能亮相CES 2025，发布支持Apple Home Key和Matter的智能门锁解决方案","summary","涂鸦智能在CES 2025推出支持Apple Home Key和Matter over Thread的智能门锁解决方案。用户可将密钥添加至Apple Wallet，通过iPhone或Apple Watch近场解锁门锁，并支持掌静脉、密码、App等多种开锁方式。涂鸦已获200余个Matter证书。","reason","涂鸦在CES发布了集成Apple Home Key的Matter门锁方案，详述了从添加密钥到近场解锁的流程，对同类智能门锁开发有参考意义。","source",{"_46":47},"publishedAt","2025-01-22T03:58:30.000Z","timelineAt","category","product","tags",[41,42,43,44,45],"score",33,"selected",true,"channel","news","x","产品发布","门禁对讲","物联网协议","家用消费级","涂鸦智能","name","涂鸦智能新闻","l3x7wu0p34rn3fn5c0zzb0cv9","涂鸦智能CES 2026发布多款AI硬件，包括AI情绪搭子、宠物项圈等","涂鸦智能在CES 2026上发布六款AI硬件，包括与珞博智能共创的AI情绪搭子'珞博芙崽'、全球首发PetCare宠物情绪项圈、与英特尔合作的家庭AI中心等。家庭AI中心支持本地大模型部署与AI告警，AI行车记录仪内置4G和AI视觉算法，可实现碰撞预警与远程监控。","本文汇总了涂鸦智能在CES 2026上发布的六款AI硬件，覆盖情感陪伴、宠物健康、智能家居等场景，有助于读者了解其AI硬件生态布局。",{"_46":47},"2026-01-08T16:00:00.000Z",[41,56,44,45],28,"端侧AI","ia14xbm4ye1vesyrnrp2toxfx","涂鸦智能发布2026年Q2及H1财报：推动AI能力在真实设备和实际场景中落地","涂鸦智能发布2026年Q2及H1财报，上半年总营收1.738亿美元，同比增长12.3%；第二季度营收9290万美元，同比增长16.0%，净利润率20.1%。公司持续推进AI能力产品化落地，上线端到端物理AI生成系统Tuya Cobuilder，AI开发者平台注册数超209万。","涂鸦智能上半年营收同比增长12.3%，AI应用收入增长明显，有助于理解智能平台在AI硬件落地中的商业化进展。",{"_46":47},"2026-08-25T01:00:00.000Z","industry",[66,45],42,"行业动态","slug","tuya","group","company","definition","涂鸦智能的 IoT / 智能视觉产品与生态合作动态。平台型友商，常与摄像机厂商合作。","total",3,"recent",0,"indexable",false,"latestAt","related",[82,83,84],{"_67":89,"_46":90},{"_67":87,"_46":88},{"_67":85,"_46":86},"peer-watch","同业对比（消费级与中小企业安防）","jovision","中维世纪","seetong","天视通（我司）",{"_92":93},"changelogVersion","2026-10-01T08:00"]

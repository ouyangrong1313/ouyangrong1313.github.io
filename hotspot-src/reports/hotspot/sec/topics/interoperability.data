[{"_1":2,"_3":4},"root",{"_5":70},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_46":47,"_44":48,"_49":50,"_51":52,"_53":12,"_54":55,"_56":57,"_58":26,"_59":60},"items",[14],"page",1,"pageCount",{"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5},"id","dj5h8l2hwv8rkfg4l3gxr3s7h","title","涂鸦智能亮相CES 2025，发布支持Apple Home Key和Matter的智能门锁解决方案","summary","涂鸦智能在CES 2025推出支持Apple Home Key和Matter over Thread的智能门锁解决方案。用户可将密钥添加至Apple Wallet，通过iPhone或Apple Watch近场解锁门锁，并支持掌静脉、密码、App等多种开锁方式。涂鸦已获200余个Matter证书。","reason","涂鸦在CES发布了集成Apple Home Key的Matter门锁方案，详述了从添加密钥到近场解锁的流程，对同类智能门锁开发有参考意义。","source",{"_44":45},"publishedAt","2025-01-22T03:58:30.000Z","timelineAt","category","product","tags",[39,40,41,42,43],"score",33,"selected",true,"channel","news","x","产品发布","门禁对讲","物联网协议","家用消费级","涂鸦智能","name","涂鸦智能新闻","slug","interoperability","互联与协议","group","field","definition","ONVIF、GB/T 28181、GB 35114 与各类物联网协议的兼容性、安全要求与互通实践。","total","recent",0,"indexable",false,"latestAt","related",[61,62,63],{"_46":68,"_44":69},{"_46":66,"_44":67},{"_46":64,"_44":65},"codec","编解码与传输","data-security","数据安全与隐私","standards","标准发布",{"_71":72},"changelogVersion","2026-10-01T08:00"]

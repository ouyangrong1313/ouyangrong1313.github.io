[{"_1":2,"_3":4},"root",{"_5":95},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_71":72,"_46":73,"_74":75,"_76":77,"_78":79,"_80":12,"_81":82,"_83":64,"_84":85},"items",[14,15,16],"page",1,"pageCount",{"_17":59,"_19":60,"_21":61,"_23":62,"_25":63,"_27":64,"_29":64,"_30":65,"_32":66,"_34":67,"_36":37,"_38":39,"_40":-5},{"_17":48,"_19":49,"_21":50,"_23":51,"_25":52,"_27":53,"_29":53,"_30":54,"_32":55,"_34":56,"_36":37,"_38":39,"_40":-5},{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5},"id","vrn3prg8e7fzqchgj048lndcw","title","Yoosee 亮相阿里云通义智能硬件展，展示星瀚 AI 大模型与端云协同新产品","summary","在 2026 年初的阿里云通义智能硬件展上，Yoosee 展示了基于通义大模型的星瀚 AI 大模型和端云协同架构，以及智能观鸟器、AOV 低功耗摄像机、黑光窗贴摄像机等产品。Yoosee 同时通过 AI 增值服务实现商业模式转型，客单价提升 30%，用户留存提升 75%。","reason","Yoosee 展示了端云协同 AI 架构和 AI 增值服务带来的客单价提升数据，可帮助同业了解 AI 安防的落地与商业路径。","source",{"_46":47},"publishedAt","2026-01-16T00:00:00.000Z","timelineAt","category","technology","tags",[41,42,43,44,45],"score",38,"selected",true,"channel","news","x","观点/分析","视频监控","端侧AI","低功耗/电池","技威时代","name","技威时代 Yoosee 企业动态","n4voso60clj9gy3cwko64ddjn","从创业幼苗到行业脊梁——中维世纪二十六年向上生长","中维世纪二十六年从山大路起步成长为全球安防50强，在济南高新区政策支持下自研音视频后处理芯片JV9800，提出普惠AI战略，构建硬件+平台+算法+云服务全栈能力。公司推出AI场景机、双目AOV太阳能电池球机等产品，在农业看护、幼儿园、食品连锁等场景落地，其中食品连锁案例每年节省成本超100万元、销量提升约10%。2024年底，人工智能创新应用产业园全面投产。","本文呈现了中维世纪从自研芯片到普惠AI的全链条进化，以及农业、幼教、后厨场景的落地案例与成本节约效果。",{"_46":58},"2026-06-15T00:00:00.000Z","industry",[41,42,43,44,57],28,"中维世纪","中维世纪企业动态","exw7bw5j6nenzcs2uccm6vyzt","从信息通信业“十五五”规划看物联网发展特点","信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。","本文从连接体系、AI融合和标准化三个维度解读物联网十五五规划要点，可帮助读者把握政策导向与产业演进方向。",{"_46":70},"2026-09-14T00:00:00.000Z","policy",[41,68,69],61,"边缘计算","工信部","物联网智库资讯","slug","opinions","观点与分析","group","genre","definition","趋势判断、专家访谈、行业复盘与深度分析：有独立信息量的观点内容。","total",3,"recent","indexable",false,"latestAt","related",[86,87,88],{"_71":93,"_46":94},{"_71":91,"_46":92},{"_71":89,"_46":90},"reviews","评测与对比","industry-news","行业动态","tech-advance","技术进展",{"_96":97},"changelogVersion","2026-10-01T08:00"]

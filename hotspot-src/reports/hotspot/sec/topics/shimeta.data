[{"_1":2,"_3":4},"root",{"_5":131},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_107":108,"_49":48,"_109":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":104,"_120":121},"items",[14,15,16,17,18,19,20],"page",1,"pageCount",{"_21":98,"_23":99,"_25":100,"_27":101,"_29":102,"_31":103,"_33":104,"_34":83,"_36":105,"_38":106,"_40":41,"_42":43,"_44":-5},{"_21":90,"_23":91,"_25":92,"_27":93,"_29":94,"_31":95,"_33":95,"_34":35,"_36":96,"_38":97,"_40":41,"_42":43,"_44":-5},{"_21":77,"_23":78,"_25":79,"_27":80,"_29":81,"_31":82,"_33":82,"_34":83,"_36":84,"_38":85,"_40":41,"_42":43,"_44":-5},{"_21":69,"_23":70,"_25":71,"_27":72,"_29":73,"_31":74,"_33":74,"_34":35,"_36":75,"_38":76,"_40":41,"_42":43,"_44":-5},{"_21":61,"_23":62,"_25":63,"_27":64,"_29":65,"_31":66,"_33":66,"_34":35,"_36":67,"_38":68,"_40":41,"_42":43,"_44":-5},{"_21":51,"_23":52,"_25":53,"_27":54,"_29":55,"_31":56,"_33":56,"_34":35,"_36":57,"_38":58,"_40":41,"_42":43,"_44":-5},{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","yohsi83a932qyegd9l99czim4","title","视美泰携全栈AI方案亮相第八届深圳智慧显示博览会","summary","2026年8月26-28日，视美泰亮相第八届深圳（国际）智慧显示系统产业应用博览会，展出基于瑞芯微等平台的RK3568、RK3576、RK3588系列主板盒子，以及AI大模型双屏翻译机、智能体广告机、多模态语视交互模组等产品，并布局OpenHarmony开源鸿蒙系列与AIBOX-M88边缘计算平台。","reason","原文梳理了视美泰从算力基座到鸿蒙生态的全栈产品矩阵，读者可借此了解AI大模型在商显终端的规模化落地路径。","source",{"_49":50},"publishedAt","2026-08-27T00:00:00.000Z","timelineAt","category","product","tags",[45,46,47,48],"score",26,"selected",true,"channel","news","x","产品发布","商用企业级","端侧AI","视美泰","name","视美泰企业动态","whoyby6caxyvkntk5vy9eoy3j","视美泰发布AIoT-3576SE主板：100×80mm尺寸，6TOPS NPU，丰富接口","视美泰发布AIoT-3576SE主板，基于瑞芯微RK3576八核芯片，集成6TOPS NPU，尺寸100×80mm。支持4K输出、MIPI摄像头和语音功能，待机电流低至22mA，适用于智能家居中控、小型网关等紧凑场景。","视美泰AIoT-3576SE以100×80mm尺寸集成6TOPS NPU和丰富接口，可帮助判断其在紧凑设备中的适用性。",{"_49":50},"2026-08-31T00:00:00.000Z",[45,47,59,60,48],31,"家用消费级","低功耗/电池","cuq8e1xamuijnb8qo89s2pdcc","视美泰发布AIoT-3576EV AI终端主板，面向交互大屏全品类设备","视美泰发布AIoT-3576EV AI终端主板，搭载RK3576八核处理器与6TOPS NPU，支持M.2算力扩展与双千兆网口，具备V-By-One 4K@120Hz显示输出能力，适用于AI数字人、体测一体机、服务机器人等交互大屏设备。","原文详细介绍视美泰AIoT-3576EV主板的算力扩展、显示输出与网络配置，为交互大屏设备选型提供技术参考。",{"_49":50},"2026-09-01T00:00:00.000Z",[45,47,46,48],38,"fx8u9l7qbv3ky83zkq75dcpeq","视美泰正式发布DSBOX-133SE高清数字标牌播放盒，主打1080P商显场景","视美泰正式发布DSBOX-133SE高清数字标牌播放盒，面向1080P商显市场，强调高性价比与稳定运行。该产品搭载全志A133四核处理器及Android 10系统，支持1080P@60Hz输出，配备双USB、音频输出、以太网与WiFi等接口，采用无风扇低功耗设计和多重防护测试，可应用于电子餐牌、广告机、楼宇信息屏等场景。","原文详细介绍了DSBOX-133SE在1080P商显场景的规格与接口配置，可辅助集成商判断该产品在餐饮、零售、楼宇等场景的适用性与投入成本。",{"_49":50},"2026-09-08T00:00:00.000Z",[45,46,48],41,"lt3b2jt9fvurdwf1as9syu5m2","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","本文展示了视美泰AIoT-3588A主板在停车场智慧服务屏中的硬件参数和落地项目，对评估同类交互终端的边缘计算方案有参考意义。",{"_49":50},"2026-09-11T00:00:00.000Z","project",[86,47,87,88,89,48],25,"应用场景","边缘计算","车牌识别","人脸识别","k0g55fpi9kyhfbducbkdxhydq","拆解视美泰 AIoT-3576EV：面向交互大屏的 RK3576 硬件方案","视美泰在官方动态中拆解了AIoT-3576EV主板，该主板基于瑞芯微RK3576平台（8核CPU+6TOPS NPU），支持4K@120Hz显示、7路USB及工业总线扩展，面向B端整机厂商和集成商，能够本地运行数字人驱动、客流统计等AI业务。","本文对AIoT-3576EV的显示、接口与AI算力定制做了详细拆解，供交互大屏整机选型时评估硬件方案。",{"_49":50},"2026-09-16T00:00:00.000Z",[45,47,46,48],45,"c2jqdd84vfsqsut1omjlaymgv","视美泰AIoT-3568S主板赋能电话班牌项目应用案例分享","视美泰AIoT-3568S主板被用于电话班牌项目，其126×90mm超薄尺寸适配10.1-32英寸屏幕，内置1TOPS NPU实现本地人脸识别考勤，丰富的USB、串口及音频接口可集成摄像头、读卡器、对讲模块等外设。该主板兼容Android、Linux、OpenHarmony操作系统，支持双屏异显和有线/WiFi/蓝牙多网络融合，适合校园批量部署与管理。","本文展示了视美泰AIoT-3568S主板在电话班牌项目中的全方面适配方案，涵盖超薄尺寸、多接口、本地AI算力及多系统兼容等关键技术参数，可供智慧校园终端选型参考。",{"_49":50},"2026-09-29T00:00:00.000Z","2026-09-29T15:24:24.414Z",[86,89,47,48],29,"slug","shimeta","group","company","definition","视美泰（SVMAT）的 AIoT 主板、算力盒子与行业方案动态。上游方案商，可为产品选型参考。","total",7,"recent",6,"indexable",false,"latestAt","related",[122,123,124],{"_107":129,"_49":130},{"_107":127,"_49":128},{"_107":125,"_49":126},"peer-watch","同业对比（消费级与中小企业安防）","tuya","涂鸦智能","seetong","天视通（我司）",{"_132":133},"changelogVersion","2026-10-01T08:00"]

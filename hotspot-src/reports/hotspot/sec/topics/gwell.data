[{"_1":2,"_3":4},"root",{"_5":95},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_71":72,"_46":45,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":64,"_84":85},"items",[14,15,16],"page",1,"pageCount",{"_17":59,"_19":60,"_21":61,"_23":62,"_25":63,"_27":64,"_29":64,"_30":65,"_32":66,"_34":67,"_36":37,"_38":39,"_40":-5},{"_17":48,"_19":49,"_21":50,"_23":51,"_25":52,"_27":53,"_29":53,"_30":54,"_32":55,"_34":56,"_36":37,"_38":39,"_40":-5},{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5},"id","vrn3prg8e7fzqchgj048lndcw","title","Yoosee 亮相阿里云通义智能硬件展，展示星瀚 AI 大模型与端云协同新产品","summary","在 2026 年初的阿里云通义智能硬件展上，Yoosee 展示了基于通义大模型的星瀚 AI 大模型和端云协同架构，以及智能观鸟器、AOV 低功耗摄像机、黑光窗贴摄像机等产品。Yoosee 同时通过 AI 增值服务实现商业模式转型，客单价提升 30%，用户留存提升 75%。","reason","Yoosee 展示了端云协同 AI 架构和 AI 增值服务带来的客单价提升数据，可帮助同业了解 AI 安防的落地与商业路径。","source",{"_46":47},"publishedAt","2026-01-16T00:00:00.000Z","timelineAt","category","technology","tags",[41,42,43,44,45],"score",38,"selected",true,"channel","news","x","观点/分析","视频监控","端侧AI","低功耗/电池","技威时代","name","技威时代 Yoosee 企业动态","elw0eubbxz12wtuq36gbwl0cq","Yoosee广州体验店盛大开业：以服务赋能外贸商圈，共筑AI安防新标杆","Yoosee于2026年1月17日在广州国际数码广场开设AI体验店，并举办行业交流会，聚焦珠三角外贸商圈。体验店以“安防体验实验室”为设计理念，展示AI摄像机的实时人车识别、哭声检测等功能，同时推出端侧算法与云端AI模型订阅、全球一卡通流量分成等模式，从硬件销售转向智能服务生态。","原文详述Yoosee广州体验店如何以三大痛点解决方案构建AI安防服务生态，为消费安防渠道转型提供具体案例参考。",{"_46":47},"2026-01-20T00:00:00.000Z","industry",[57,58,43,45],29,"行业动态","家用消费级","dupmg67utrtljduamxv5dutqp","Yoosee在IEAE 2026展出AI摄像头新品，硬件+服务分润模式受关注","Yoosee在IEAE 2026深圳消费电子展上展出多款AI摄像头新品，并推出硬件+服务分润模式。新品免费植入人形检测、车辆检测等六大AI算法，云存储订阅服务付费次月留存率达80%，单台设备生命周期可贡献数百美元持续收益，旨在帮助跨境电商卖家从卖设备转向持续分成。","原文详细介绍了Yoosee的AI摄像头硬件+服务分润模式及其免费AI算法和云存储订阅设计，为安防出海卖家提供了选品与持续收益的新思路。",{"_46":47},"2026-04-10T00:00:00.000Z","product",[68,42,43,69,70,58,45],26,"产品发布","云存储","人脸识别","slug","gwell","group","company","definition","技威时代（Gwell / Yoosee）的智能摄像机与出海品牌动态。同赛道友商。","total",3,"recent",0,"indexable",false,"latestAt","related",[86,87,88],{"_71":93,"_46":94},{"_71":91,"_46":92},{"_71":89,"_46":90},"peer-watch","同业对比（消费级与中小企业安防）","jovision","中维世纪","seetong","天视通（我司）",{"_96":97},"changelogVersion","2026-10-01T08:00"]

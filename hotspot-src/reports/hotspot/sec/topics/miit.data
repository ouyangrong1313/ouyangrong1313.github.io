[{"_1":2,"_3":4},"root",{"_5":81},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_59":60,"_46":44,"_61":62,"_63":64,"_65":66,"_67":12,"_68":69,"_70":53,"_71":72},"items",[14,15],"page",1,"pageCount",{"_16":48,"_18":49,"_20":50,"_22":51,"_24":52,"_26":53,"_28":53,"_29":30,"_31":54,"_33":55,"_35":36,"_37":38,"_39":-5},{"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","s3fh913cyocws3myalmd1l2qb","title","《网络安全标识管理办法》发布，家用摄像头为首批试点，7月施行","summary","2026年4月10日，国家网信办、工信部、公安部联合印发《网络安全标识管理办法》，7月1日起施行，消费类网联摄像头列为首批试点。办法实行基础级（一星）、增强级（二星）、领先级（三星）分级标识，生产者自愿参与，鼓励消费者优先选用。新规将加速行业洗牌，推动联网安防产品从价格竞争转向安全品质竞争。","reason","文章详细解读了网络安全标识管理办法的三级标识体系和试点范围，对消费者选购和厂商合规均有参考价值。","source",{"_46":47},"publishedAt","2026-04-20T07:58:00.000Z","timelineAt","category","policy","tags",[40,41,42,43,44,45],"score",76,"selected",true,"channel","news","x","政策/监管","视频监控","数据安全","网信办","工信部","公安部","name","CPS中安网智能安防","exw7bw5j6nenzcs2uccm6vyzt","从信息通信业“十五五”规划看物联网发展特点","信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。","本文从连接体系、AI融合和标准化三个维度解读物联网十五五规划要点，可帮助读者把握政策导向与产业演进方向。",{"_46":58},"2026-09-14T00:00:00.000Z",[56,57,44],61,"观点/分析","边缘计算","物联网智库资讯","slug","miit","group","company","definition","工业和信息化部关于物联网、通信模组、产业规划与准入的动态。","total",2,"recent","indexable",false,"latestAt","related",[73,74,75],{"_59":30,"_46":80},{"_59":78,"_46":79},{"_59":76,"_46":77},"standards","标准发布","interoperability","互联与协议","政策与监管",{"_82":83},"changelogVersion","2026-10-01T08:00"]

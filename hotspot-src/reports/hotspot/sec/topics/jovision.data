[{"_1":2,"_3":4},"root",{"_5":85},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_58":59,"_45":44,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":52,"_71":72},"items",[14,15],"page",1,"pageCount",{"_16":47,"_18":48,"_20":49,"_22":50,"_24":51,"_26":52,"_28":52,"_29":53,"_31":54,"_33":55,"_35":36,"_37":38,"_39":-5},{"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","n4voso60clj9gy3cwko64ddjn","title","从创业幼苗到行业脊梁——中维世纪二十六年向上生长","summary","中维世纪二十六年从山大路起步成长为全球安防50强，在济南高新区政策支持下自研音视频后处理芯片JV9800，提出普惠AI战略，构建硬件+平台+算法+云服务全栈能力。公司推出AI场景机、双目AOV太阳能电池球机等产品，在农业看护、幼儿园、食品连锁等场景落地，其中食品连锁案例每年节省成本超100万元、销量提升约10%。2024年底，人工智能创新应用产业园全面投产。","reason","本文呈现了中维世纪从自研芯片到普惠AI的全链条进化，以及农业、幼教、后厨场景的落地案例与成本节约效果。","source",{"_45":46},"publishedAt","2026-06-15T00:00:00.000Z","timelineAt","category","industry","tags",[40,41,42,43,44],"score",28,"selected",true,"channel","news","x","观点/分析","视频监控","端侧AI","低功耗/电池","中维世纪","name","中维世纪企业动态","dwcwafzuwe8fvzhfq5sns3fic","中维世纪发布电梯四合一算法场景机，集成电动车、煤气罐、困人与遮挡检测","中维世纪发布电梯四合一算法场景机，内置煤气罐检测、电动车检测、困人检测和遮挡检测四种算法。电动车或煤气罐入梯时联动梯控阻止关门；困人检测自动推送物业；遮挡检测触发防御警报并阻止关门。","文中介绍了中维世纪电梯四合一算法的具体检测能力与梯控联动设计，便于了解当前电梯场景的AI检测集成方案。",{"_45":46},"2026-08-28T00:00:00.000Z","technology",[56,41,57,44],32,"产品发布","行为分析","slug","jovision","group","company","definition","中维世纪（山东中维）的消费级与中小企业安防产品、方案与经营动态。同赛道友商。","total",2,"recent",0,"indexable",false,"latestAt","related",[73,74,75,76],{"_58":83,"_45":84},{"_58":81,"_45":82},{"_58":79,"_45":80},{"_58":77,"_45":78},"peer-watch","同业对比（消费级与中小企业安防）","xiongmai","雄迈","jiegao","捷高","seetong","天视通（我司）",{"_86":87},"changelogVersion","2026-10-01T08:00"]

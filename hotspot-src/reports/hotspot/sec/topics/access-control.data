[{"_1":2,"_3":4},"root",{"_5":81},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_57":58,"_45":59,"_60":61,"_62":63,"_64":65,"_66":12,"_67":68,"_69":52,"_70":71},"items",[14,15],"page",1,"pageCount",{"_16":47,"_18":48,"_20":49,"_22":50,"_24":51,"_26":52,"_28":52,"_29":30,"_31":53,"_33":54,"_35":36,"_37":38,"_39":-5},{"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","dj5h8l2hwv8rkfg4l3gxr3s7h","title","涂鸦智能亮相CES 2025，发布支持Apple Home Key和Matter的智能门锁解决方案","summary","涂鸦智能在CES 2025推出支持Apple Home Key和Matter over Thread的智能门锁解决方案。用户可将密钥添加至Apple Wallet，通过iPhone或Apple Watch近场解锁门锁，并支持掌静脉、密码、App等多种开锁方式。涂鸦已获200余个Matter证书。","reason","涂鸦在CES发布了集成Apple Home Key的Matter门锁方案，详述了从添加密钥到近场解锁的流程，对同类智能门锁开发有参考意义。","source",{"_45":46},"publishedAt","2025-01-22T03:58:30.000Z","timelineAt","category","product","tags",[40,41,42,43,44],"score",33,"selected",true,"channel","news","x","产品发布","门禁对讲","物联网协议","家用消费级","涂鸦智能","name","涂鸦智能新闻","fhofkey37gkbgw9t6nd2n6yc2","HID推出全新Signo Décor读卡器，兼顾门禁安全与设计美学","HID推出全新Signo Décor读卡器，专为注重设计的空间打造，同时不牺牲门禁安全性。产品支持齐平安装，具备IK10防冲击和IP65防护等级，搭载EAL5+安全元件并通过OSDP协议加密通信。基于蓝牙和NFC，用户可使用手机完成开门，现已在欧洲、中国大陆、香港、新加坡和阿联酋开放订购，更多型号将于今年内推出。","Signo Décor读卡器具备IK10/IP65防护与EAL5+安全认证，兼容OSDP协议，文中规格对高端设计项目门禁选型有参考价值。",{"_45":56},"2026-09-20T00:00:00.000Z",[40,41,55],58,"商用企业级","a&s 安防知识网资讯","slug","access-control","门禁与对讲","group","field","definition","门禁控制、可视对讲、生物识别通行与楼宇联动系统的产品与标准动态。","total",2,"recent","indexable",false,"latestAt","related",[72,73,74],{"_57":79,"_45":80},{"_57":77,"_45":78},{"_57":75,"_45":76},"standards","标准发布","data-security","数据安全与隐私","face-recognition","人脸识别",{"_82":83},"changelogVersion","2026-10-01T08:00"]

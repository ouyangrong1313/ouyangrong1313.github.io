[{"_1":2,"_3":4},"root",{"_5":70},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_47":48,"_45":49,"_50":51,"_52":53,"_54":12,"_55":56,"_57":58,"_59":26,"_60":61},"items",[14],"page",1,"pageCount",{"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5},"id","s3fh913cyocws3myalmd1l2qb","title","《网络安全标识管理办法》发布，家用摄像头为首批试点，7月施行","summary","2026年4月10日，国家网信办、工信部、公安部联合印发《网络安全标识管理办法》，7月1日起施行，消费类网联摄像头列为首批试点。办法实行基础级（一星）、增强级（二星）、领先级（三星）分级标识，生产者自愿参与，鼓励消费者优先选用。新规将加速行业洗牌，推动联网安防产品从价格竞争转向安全品质竞争。","reason","文章详细解读了网络安全标识管理办法的三级标识体系和试点范围，对消费者选购和厂商合规均有参考价值。","source",{"_45":46},"publishedAt","2026-04-20T07:58:00.000Z","timelineAt","category","policy","tags",[39,40,41,42,43,44],"score",76,"selected",true,"channel","news","x","政策/监管","视频监控","数据安全","网信办","工信部","公安部","name","CPS中安网智能安防","slug","data-security","数据安全与隐私","group","genre","definition","视频数据、人脸与车牌信息的采集使用合规要求、安全事件与处罚案例。","total","recent",0,"indexable",false,"latestAt","related",[62,63,64],{"_47":29,"_45":69},{"_47":67,"_45":68},{"_47":65,"_45":66},"interoperability","互联与协议","face-recognition","人脸识别","政策与监管",{"_71":72},"changelogVersion","2026-10-01T08:00"]

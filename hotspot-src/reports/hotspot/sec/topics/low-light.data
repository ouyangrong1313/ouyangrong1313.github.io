[{"_1":2,"_3":4},"root",{"_5":117},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_93":94,"_47":95,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":88,"_107":108},"items",[14,15,16,17,18],"page",1,"pageCount",{"_19":83,"_21":84,"_23":85,"_25":86,"_26":87,"_28":88,"_30":88,"_31":32,"_33":89,"_35":90,"_37":38,"_39":40,"_41":-5},{"_19":73,"_21":74,"_23":75,"_25":76,"_26":77,"_28":78,"_30":78,"_31":32,"_33":79,"_35":80,"_37":38,"_39":40,"_41":-5},{"_19":62,"_21":63,"_23":64,"_25":65,"_26":66,"_28":67,"_30":67,"_31":68,"_33":69,"_35":70,"_37":38,"_39":40,"_41":-5},{"_19":49,"_21":50,"_23":51,"_25":52,"_26":53,"_28":54,"_30":54,"_31":55,"_33":56,"_35":36,"_37":38,"_39":40,"_41":-5},{"_19":20,"_21":22,"_23":24,"_25":-5,"_26":27,"_28":29,"_30":29,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5},"id","ap4uwh065efe0m32rk0trdgyh","title","捷高AI-L31双目300万超全彩枪球新品上市","summary","捷高发布AI-L31双目300万超全彩枪球新品，采用新一代AI ISP，实现日夜全彩成像，夜如白昼。","reason","source",{"_47":48},"publishedAt","2024-03-29T03:46:30.000Z","timelineAt","category","product","tags",[42,43,44,45,46],"score",26,"selected",true,"channel","news","x","产品发布","低照度","图像算法","视频监控","捷高","name","捷高电子新品动态","ksmqcdtlqq2l9gjfdiofnp30e","安联锐视回顾越南IEAE与墨西哥EXPO SEGURIDAD展会，展示免钻孔与低功耗安防方案","安联锐视（Ansjer）于2026年5月28日至6月4日先后参加越南IEAE电子展和墨西哥EXPO SEGURIDAD，展出免钻孔窗口相机、黑光全彩夜视相机、4K超高清IP摄像机。","原文通过越南和墨西哥展会的现场需求及市场数据，展现了新兴安防市场对免钻孔安装和低功耗智能方案的需求趋势。",{"_47":61},"2026-06-17T01:48:18.000Z","industry",[57,45,58,59,43,60],"展会/活动","低功耗/电池","家用消费级","安联锐视","安联锐视 Ansjer 官方博客","icmtvh4s7stvt5iunfh3wc2ug","大华股份发布基于星汉大模型的风电叶片视觉智能检测方案","大华股份发布基于星汉大模型与多模态视频理解技术的风电叶片视觉智能检测方案，在风机机舱部署抗振云台实现常态化在线监测。方案在甘肃某风电场运行半年，累计抓拍约15万张叶片画面，检出2台风机3支叶片的早期裂纹和脱胶缺陷，并自动生成预警与检修建议。","大华风电叶片检测方案集成星汉大模型与实际风电场半年运行数据，抓拍15万张画面检出3支缺陷叶片，验证了常态化AI巡检的可行性。",{"_47":72},"2026-09-03T00:00:00.000Z","technology",[42,45,44,71],50,"大华股份","大华股份新闻中心","q64nvuajyvy70ujltl57yma8z","安讯士发布AXIS D5210-E和AXIS D5211-E高性能IP供电LED补光灯","安讯士发布AXIS D5210-E和AXIS D5211-E两款IP供电LED补光灯，最远补光距离分别为175米（白光）和200米（红外），支持PoE供电与远程亮度/照射角度调节。内置lux传感器可自动触发补光，PoE out可为其他设备供电；计划2026年第四季度通过安讯士分销渠道上市。","AXIS D5210/D5211-E补光灯提供最远200米补光、PoE供电与远程调节，可直接用于系统集成和低照度监控方案选型。",{"_47":82},"2026-09-11T08:56:09.000Z",[42,43,45,81],58,"Axis","安讯士 Axis 新闻中心","t83703w9v5xds3d6eblh5vnz7","安讯士发布 AXIS M3945-R、P3945-R 和 P3947-R 车载半球摄像机","安讯士发布三款车载半球摄像机 AXIS M3945-R（2 MP，面向巴士）、P3945-R（2 MP）和 P3947-R（5 MP，面向火车/电车），内置麦克风支持音频采集。","三款车载半球摄像机符合 UNECE R10/R118 及 EN 50155 等交通法规，音频和 Lightfinder 2.0 提升现场记录能力，且兼容现有安装接口便于升级。",{"_47":82},"2026-09-14T11:52:23.000Z",[42,91,92,43,81],56,"交通","音频拾取","slug","low-light","低照度成像","group","field","definition","星光级、全彩夜视、大光圈与传感器技术：照度指标、实测对比与成像算法进展。","total",5,"recent",3,"indexable",false,"latestAt","related",[109,110,111],{"_93":116,"_47":45},{"_93":114,"_47":115},{"_93":112,"_47":113},"image-sensor","芯片与传感器","thermal","热成像与测温","video-surveillance",{"_118":119},"changelogVersion","2026-10-01T08:00"]

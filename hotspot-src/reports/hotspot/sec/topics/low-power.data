[{"_1":2,"_3":4},"root",{"_5":128},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_104":105,"_47":106,"_107":108,"_109":110,"_111":112,"_113":114,"_115":116,"_117":100,"_118":119},"items",[14,15,16,17,18,19],"page",1,"pageCount",{"_20":95,"_22":96,"_24":97,"_26":98,"_27":99,"_29":100,"_31":100,"_32":33,"_34":101,"_36":102,"_38":39,"_40":41,"_42":-5},{"_20":85,"_22":86,"_24":87,"_26":88,"_27":89,"_29":90,"_31":90,"_32":33,"_34":91,"_36":92,"_38":39,"_40":41,"_42":-5},{"_20":73,"_22":74,"_24":75,"_26":76,"_27":77,"_29":78,"_31":78,"_32":68,"_34":79,"_36":37,"_38":39,"_40":41,"_42":-5},{"_20":62,"_22":63,"_24":64,"_26":65,"_27":66,"_29":67,"_31":67,"_32":68,"_34":69,"_36":70,"_38":39,"_40":41,"_42":-5},{"_20":49,"_22":50,"_24":51,"_26":52,"_27":53,"_29":54,"_31":54,"_32":55,"_34":56,"_36":57,"_38":39,"_40":41,"_42":-5},{"_20":21,"_22":23,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5},"id","apgx5gnujb7hheqor6xly0mbt","title","捷高D31C-4G单目300万超全彩AOV球机新品发布","summary","捷高发布 D31C-4G 单目 300 万超全彩 AOV 球机，官方称其为第三代 AOV 智能监控，定义行业能效新标杆。","reason","source",{"_47":48},"publishedAt","2025-05-16T03:46:30.000Z","timelineAt","category","product","tags",[43,44,45,46],"score",26,"selected",true,"channel","news","x","产品发布","视频监控","低功耗/电池","捷高","name","捷高电子新品动态","vrn3prg8e7fzqchgj048lndcw","Yoosee 亮相阿里云通义智能硬件展，展示星瀚 AI 大模型与端云协同新产品","在 2026 年初的阿里云通义智能硬件展上，Yoosee 展示了基于通义大模型的星瀚 AI 大模型和端云协同架构，以及智能观鸟器、AOV 低功耗摄像机、黑光窗贴摄像机等产品。Yoosee 同时通过 AI 增值服务实现商业模式转型，客单价提升 30%，用户留存提升 75%。","Yoosee 展示了端云协同 AI 架构和 AI 增值服务带来的客单价提升数据，可帮助同业了解 AI 安防的落地与商业路径。",{"_47":61},"2026-01-16T00:00:00.000Z","technology",[58,44,59,45,60],38,"观点/分析","端侧AI","技威时代","技威时代 Yoosee 企业动态","n4voso60clj9gy3cwko64ddjn","从创业幼苗到行业脊梁——中维世纪二十六年向上生长","中维世纪二十六年从山大路起步成长为全球安防50强，在济南高新区政策支持下自研音视频后处理芯片JV9800，提出普惠AI战略，构建硬件+平台+算法+云服务全栈能力。公司推出AI场景机、双目AOV太阳能电池球机等产品，在农业看护、幼儿园、食品连锁等场景落地，其中食品连锁案例每年节省成本超100万元、销量提升约10%。2024年底，人工智能创新应用产业园全面投产。","本文呈现了中维世纪从自研芯片到普惠AI的全链条进化，以及农业、幼教、后厨场景的落地案例与成本节约效果。",{"_47":72},"2026-06-15T00:00:00.000Z","industry",[58,44,59,45,71],28,"中维世纪","中维世纪企业动态","ksmqcdtlqq2l9gjfdiofnp30e","安联锐视回顾越南IEAE与墨西哥EXPO SEGURIDAD展会，展示免钻孔与低功耗安防方案","安联锐视（Ansjer）于2026年5月28日至6月4日先后参加越南IEAE电子展和墨西哥EXPO SEGURIDAD，展出免钻孔窗口相机、黑光全彩夜视相机、4K超高清IP摄像机。","原文通过越南和墨西哥展会的现场需求及市场数据，展现了新兴安防市场对免钻孔安装和低功耗智能方案的需求趋势。",{"_47":84},"2026-06-17T01:48:18.000Z",[80,44,45,81,82,83],"展会/活动","家用消费级","低照度","安联锐视","安联锐视 Ansjer 官方博客","whoyby6caxyvkntk5vy9eoy3j","视美泰发布AIoT-3576SE主板：100×80mm尺寸，6TOPS NPU，丰富接口","视美泰发布AIoT-3576SE主板，基于瑞芯微RK3576八核芯片，集成6TOPS NPU，尺寸100×80mm。支持4K输出、MIPI摄像头和语音功能，待机电流低至22mA，适用于智能家居中控、小型网关等紧凑场景。","视美泰AIoT-3576SE以100×80mm尺寸集成6TOPS NPU和丰富接口，可帮助判断其在紧凑设备中的适用性。",{"_47":94},"2026-08-31T00:00:00.000Z",[43,59,81,45,93],31,"视美泰","视美泰企业动态","ohvhb8ggea30mz2735jyniyun","Veepai小鹰维拍发布端侧AI多模态模组系列，最低15元起","Veepai小鹰维拍发布端侧AI多模态模组系列，包含小mini、小黄人板级、枪摇/枪球专用模组，覆盖100万至200万像素，最低15元起，同步开放100万片预售。模组内置端侧AI识别与夜视3D降噪，预制集成Sensor、图像调优与AI算法，可降低厂商开发门槛，适配迷你机、云台机、枪摇机等家用IPC形态。","原文给出了小鹰维拍多款AI模组的价格与适配机型，可帮助设备厂商评估低成本端侧AI的选型与落地路径。",{"_47":103},"2026-09-29T01:48:00.000Z",[43,59,81,45],57,"CPS中安网企业新闻","slug","low-power","低功耗与电池供电","group","field","definition","电池供电设备、唤醒机制、太阳能供电与功耗优化的产品与技术动态。","total",6,"recent",2,"indexable",false,"latestAt","related",[120,121,122],{"_104":126,"_47":127},{"_104":124,"_47":125},{"_104":123,"_47":43},"product-releases","edge-ai","端侧 AI","projects-scene","场景落地",{"_129":130},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":124},"topic-page",{"_5":6},"data",{"_5":7},{"_8":9,"_10":11,"_12":13,"_14":13},"topic",{"_80":81,"_47":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":38,"_92":93,"_94":95},"items",[15,16,17,18],"page",2,"pageCount",{"_19":68,"_21":69,"_23":70,"_25":71,"_26":72,"_28":73,"_30":73,"_31":32,"_33":74,"_35":75,"_37":38,"_39":40,"_41":-5},{"_19":57,"_21":58,"_23":59,"_25":60,"_26":61,"_28":62,"_30":62,"_31":32,"_33":63,"_35":64,"_37":38,"_39":40,"_41":-5},{"_19":49,"_21":50,"_23":51,"_25":-5,"_26":52,"_28":53,"_30":53,"_31":32,"_33":54,"_35":55,"_37":38,"_39":40,"_41":-5},{"_19":20,"_21":22,"_23":24,"_25":-5,"_26":27,"_28":29,"_30":29,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5},"id","ap4uwh065efe0m32rk0trdgyh","title","捷高AI-L31双目300万超全彩枪球新品上市","summary","捷高发布AI-L31双目300万超全彩枪球新品，采用新一代AI ISP，实现日夜全彩成像，夜如白昼。","reason","source",{"_47":48},"publishedAt","2024-03-29T03:46:30.000Z","timelineAt","category","product","tags",[42,43,44,45,46],"score",26,"selected",true,"channel","news","x","产品发布","低照度","图像算法","视频监控","捷高","name","捷高电子新品动态","ul6himx6tpb17hubidx2gdkgo","捷高Y311-BLE 300万WIFI6摇头机新品上市","捷高电子发布Y311-BLE 300万像素室内摇头机，支持WIFI6无线传输和蓝牙配网，提供全新体验。",{"_47":48},"2024-08-26T03:46:30.000Z",[42,56,46],25,"家用消费级","rf6vtufj29bwryt7jrkskndjs","天视通受邀出席2024 HarmonyOS NEXT发布会，Seetong鸿蒙版本已发布","天视通旗下App Seetong已发布面向HarmonyOS NEXT的首个版本，于9月上线，并获得上架证书。未来计划增加碰一碰分享、一键添加设备、小窗口预览和集成语音识别等功能。","原文列出Seetong鸿蒙版的功能规划，工程商可据此评估其移动端体验。",{"_47":67},"2024-12-24T16:00:00.000Z",[65,66],31,"固件/软件更新","天视通","天视通 Topsee 新闻中心","dj5h8l2hwv8rkfg4l3gxr3s7h","涂鸦智能亮相CES 2025，发布支持Apple Home Key和Matter的智能门锁解决方案","涂鸦智能在CES 2025推出支持Apple Home Key和Matter over Thread的智能门锁解决方案。用户可将密钥添加至Apple Wallet，通过iPhone或Apple Watch近场解锁门锁，并支持掌静脉、密码、App等多种开锁方式。涂鸦已获200余个Matter证书。","涂鸦在CES发布了集成Apple Home Key的Matter门锁方案，详述了从添加密钥到近场解锁的流程，对同类智能门锁开发有参考意义。",{"_47":79},"2025-01-22T03:58:30.000Z",[42,76,77,56,78],33,"门禁对讲","物联网协议","涂鸦智能","涂鸦智能新闻","slug","peer-watch","同业对比（消费级与中小企业安防）","group","company","definition","把天视通与捷高、中维世纪、雄迈、安佳威视、涂鸦智能、安联锐视、同为股份、技威时代的动态放在一处：消费级与中小企业安防赛道，按产品发布、技术路线（AOV/低功耗/4G 布点）、生态合作与出海节奏对比。","total",24,"recent",6,"indexable","latestAt","2026-09-30T06:33:30.270Z","related",[96,97,98,99,100,101,102,103,104,105],{"_80":122,"_47":123},{"_80":121,"_47":46},{"_80":119,"_47":120},{"_80":117,"_47":118},{"_80":115,"_47":116},{"_80":114,"_47":78},{"_80":112,"_47":113},{"_80":110,"_47":111},{"_80":108,"_47":109},{"_80":106,"_47":107},"shimeta","视美泰","gwell","技威时代","tvt","同为股份","ansjer","安联锐视","tuya","anjiavision","安佳威视","xiongmai","雄迈","jovision","中维世纪","jiegao","seetong","天视通（我司）",{"_125":126},"changelogVersion","2026-10-01T08:00"]

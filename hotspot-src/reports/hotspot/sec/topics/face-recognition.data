[{"_1":2,"_3":4},"root",{"_5":97},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_73":74,"_48":45,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":70,"_86":87},"items",[14,15,16],"page",1,"pageCount",{"_17":64,"_19":65,"_21":66,"_23":67,"_25":68,"_27":69,"_29":70,"_30":56,"_32":71,"_34":72,"_36":37,"_38":39,"_40":-5},{"_17":50,"_19":51,"_21":52,"_23":53,"_25":54,"_27":55,"_29":55,"_30":56,"_32":57,"_34":58,"_36":37,"_38":39,"_40":-5},{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5},"id","dupmg67utrtljduamxv5dutqp","title","Yoosee在IEAE 2026展出AI摄像头新品，硬件+服务分润模式受关注","summary","Yoosee在IEAE 2026深圳消费电子展上展出多款AI摄像头新品，并推出硬件+服务分润模式。新品免费植入人形检测、车辆检测等六大AI算法，云存储订阅服务付费次月留存率达80%，单台设备生命周期可贡献数百美元持续收益，旨在帮助跨境电商卖家从卖设备转向持续分成。","reason","原文详细介绍了Yoosee的AI摄像头硬件+服务分润模式及其免费AI算法和云存储订阅设计，为安防出海卖家提供了选品与持续收益的新思路。","source",{"_48":49},"publishedAt","2026-04-10T00:00:00.000Z","timelineAt","category","product","tags",[41,42,43,44,45,46,47],"score",26,"selected",true,"channel","news","x","产品发布","视频监控","端侧AI","云存储","人脸识别","家用消费级","技威时代","name","技威时代 Yoosee 企业动态","lt3b2jt9fvurdwf1as9syu5m2","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","本文展示了视美泰AIoT-3588A主板在停车场智慧服务屏中的硬件参数和落地项目，对评估同类交互终端的边缘计算方案有参考意义。",{"_48":63},"2026-09-11T00:00:00.000Z","project",[59,43,60,61,45,62],25,"应用场景","边缘计算","车牌识别","视美泰","视美泰企业动态","c2jqdd84vfsqsut1omjlaymgv","视美泰AIoT-3568S主板赋能电话班牌项目应用案例分享","视美泰AIoT-3568S主板被用于电话班牌项目，其126×90mm超薄尺寸适配10.1-32英寸屏幕，内置1TOPS NPU实现本地人脸识别考勤，丰富的USB、串口及音频接口可集成摄像头、读卡器、对讲模块等外设。该主板兼容Android、Linux、OpenHarmony操作系统，支持双屏异显和有线/WiFi/蓝牙多网络融合，适合校园批量部署与管理。","本文展示了视美泰AIoT-3568S主板在电话班牌项目中的全方面适配方案，涵盖超薄尺寸、多接口、本地AI算力及多系统兼容等关键技术参数，可供智慧校园终端选型参考。",{"_48":63},"2026-09-29T00:00:00.000Z","2026-09-29T15:24:24.414Z",[59,45,43,62],29,"slug","face-recognition","group","field","definition","人脸识别技术、合规要求、个人信息保护约束与实际落地的全部动态。","total",3,"recent",2,"indexable",false,"latestAt","related",[88,89,90],{"_73":95,"_48":96},{"_73":93,"_48":94},{"_73":91,"_48":92},"policy","政策与监管","access-control","门禁与对讲","data-security","数据安全与隐私",{"_98":99},"changelogVersion","2026-10-01T08:00"]

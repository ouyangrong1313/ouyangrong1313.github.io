[{"_1":2,"_3":4},"root",{"_5":82},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_58":59,"_45":60,"_61":62,"_63":64,"_65":66,"_67":66,"_68":69,"_70":52,"_71":72},"items",[14,15],"page",1,"pageCount",{"_16":47,"_18":48,"_20":49,"_22":50,"_24":51,"_26":52,"_28":52,"_29":53,"_31":54,"_33":55,"_35":36,"_37":38,"_39":-5},{"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","t83703w9v5xds3d6eblh5vnz7","title","安讯士发布 AXIS M3945-R、P3945-R 和 P3947-R 车载半球摄像机","summary","安讯士发布三款车载半球摄像机 AXIS M3945-R（2 MP，面向巴士）、P3945-R（2 MP）和 P3947-R（5 MP，面向火车/电车），内置麦克风支持音频采集。","reason","三款车载半球摄像机符合 UNECE R10/R118 及 EN 50155 等交通法规，音频和 Lightfinder 2.0 提升现场记录能力，且兼容现有安装接口便于升级。","source",{"_45":46},"publishedAt","2026-09-14T11:52:23.000Z","timelineAt","category","product","tags",[40,41,42,43,44],"score",56,"selected",true,"channel","news","x","产品发布","交通","音频拾取","低照度","Axis","name","安讯士 Axis 新闻中心","z1xgmtt4mk2vqdqcwcnsan09g","同方威视在福州长乐机场T2部署近300台套智慧安检设备","2026年9月16日，福州长乐国际机场T2航站楼正式投运，同方威视近300台套安检设备及智慧安检方案同步上线。方案涵盖手提行李CT、毫米波人体安检门等设备，依托AI实现辅助判图与安检质控，并创新“一机双屏、一次过检”关航联合查验模式，支撑年3600万人次旅客吞吐量。","同方威视在福州长乐机场T2部署近300台套安检设备，涵盖CT与毫米波门，关航联检模式为机场安检效率与安全融合提供实际范例。",{"_45":57},"2026-09-18T00:00:00.000Z","project",[56,41],54,"应用场景","中国安防协会企业动态","slug","traffic","智慧交通感知","group","field","definition","卡口、电警、交通流检测、车路协同与道路感知设备的方案与项目动态。","total",2,"recent","indexable",false,"latestAt","related",[73,74,75],{"_58":80,"_45":81},{"_58":78,"_45":79},{"_58":76,"_45":77},"tenders","招投标与项目","mmwave-radar","毫米波雷达","anpr","车牌识别",{"_83":84},"changelogVersion","2026-10-01T08:00"]

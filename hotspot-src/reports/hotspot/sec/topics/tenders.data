[{"_1":2,"_3":4},"root",{"_5":105},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_80":81,"_44":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":77,"_94":95},"items",[14,15,16,17],"page",1,"pageCount",{"_18":71,"_20":72,"_22":73,"_24":74,"_26":75,"_28":76,"_30":77,"_31":52,"_33":78,"_35":79,"_37":38,"_39":40,"_41":-5},{"_18":61,"_20":62,"_22":63,"_24":64,"_26":65,"_28":66,"_30":66,"_31":52,"_33":67,"_35":68,"_37":38,"_39":40,"_41":-5},{"_18":46,"_20":47,"_22":48,"_24":49,"_26":50,"_28":51,"_30":51,"_31":52,"_33":53,"_35":54,"_37":38,"_39":40,"_41":-5},{"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":29,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5},"id","pxeindylegkwy45253wxfocd3","title","台州公安自研防爆罐机器人亮相，自重50公斤可抵御500克TNT当量","summary","台州公安自主研发的自主移动式防爆罐机器人亮相，自重控制在50公斤内，可抵御500克TNT当量爆炸冲击。机器人搭载履带底盘与3D激光雷达，支持一键路径规划，具备自主导航与远程操作功能。目前已在台州机场、高铁站等核心安保部位部署，累计参与涉爆警情处置及实战演练20余起。2025年台州某商场可疑包裹处置中，机器人凭借自主导航完成无感转移，未大规模疏散人群。","reason","相比自重超200公斤的传统防爆罐，该机器人自重仅50公斤且可抵御500克TNT当量爆炸冲击，搭配一键路径规划与远程控制，使非专业警力也能安全操作，降低了基层排爆作业门槛。","source",{"_44":45},"publishedAt","2026-03-26T09:11:00.000Z","timelineAt","category","product","tags",[42,43],"score",59,"selected",true,"channel","news","x","应用场景","工业/防爆","name","CPS中安网智能安防","lt3b2jt9fvurdwf1as9syu5m2","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","本文展示了视美泰AIoT-3588A主板在停车场智慧服务屏中的硬件参数和落地项目，对评估同类交互终端的边缘计算方案有参考意义。",{"_44":60},"2026-09-11T00:00:00.000Z","project",[42,55,56,57,58,59],25,"端侧AI","边缘计算","车牌识别","人脸识别","视美泰","视美泰企业动态","z1xgmtt4mk2vqdqcwcnsan09g","同方威视在福州长乐机场T2部署近300台套智慧安检设备","2026年9月16日，福州长乐国际机场T2航站楼正式投运，同方威视近300台套安检设备及智慧安检方案同步上线。方案涵盖手提行李CT、毫米波人体安检门等设备，依托AI实现辅助判图与安检质控，并创新“一机双屏、一次过检”关航联合查验模式，支撑年3600万人次旅客吞吐量。","同方威视在福州长乐机场T2部署近300台套安检设备，涵盖CT与毫米波门，关航联检模式为机场安检效率与安全融合提供实际范例。",{"_44":70},"2026-09-18T00:00:00.000Z",[42,69],54,"交通","中国安防协会企业动态","c2jqdd84vfsqsut1omjlaymgv","视美泰AIoT-3568S主板赋能电话班牌项目应用案例分享","视美泰AIoT-3568S主板被用于电话班牌项目，其126×90mm超薄尺寸适配10.1-32英寸屏幕，内置1TOPS NPU实现本地人脸识别考勤，丰富的USB、串口及音频接口可集成摄像头、读卡器、对讲模块等外设。该主板兼容Android、Linux、OpenHarmony操作系统，支持双屏异显和有线/WiFi/蓝牙多网络融合，适合校园批量部署与管理。","本文展示了视美泰AIoT-3568S主板在电话班牌项目中的全方面适配方案，涵盖超薄尺寸、多接口、本地AI算力及多系统兼容等关键技术参数，可供智慧校园终端选型参考。",{"_44":60},"2026-09-29T00:00:00.000Z","2026-09-29T15:24:24.414Z",[42,58,55,59],29,"slug","tenders","招投标与项目","group","genre","definition","招标中标、工程落地、试点项目与实效数据：规模、范围与技术要求。","total",4,"recent",3,"indexable",false,"latestAt","related",[96,97,98],{"_80":103,"_44":104},{"_80":101,"_44":102},{"_80":99,"_44":100},"traffic","智慧交通感知","projects-scene","场景落地","industry-news","行业动态",{"_106":107},"changelogVersion","2026-10-01T08:00"]

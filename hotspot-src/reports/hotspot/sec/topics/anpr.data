[{"_1":2,"_3":4},"root",{"_5":66},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_47":48,"_45":42,"_49":50,"_51":52,"_53":12,"_54":12,"_55":56,"_57":26,"_58":59},"items",[14],"page",1,"pageCount",{"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5},"id","lt3b2jt9fvurdwf1as9syu5m2","title","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","summary","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","reason","本文展示了视美泰AIoT-3588A主板在停车场智慧服务屏中的硬件参数和落地项目，对评估同类交互终端的边缘计算方案有参考意义。","source",{"_45":46},"publishedAt","2026-09-11T00:00:00.000Z","timelineAt","category","project","tags",[39,40,41,42,43,44],"score",25,"selected",true,"channel","news","x","应用场景","端侧AI","边缘计算","车牌识别","人脸识别","视美泰","name","视美泰企业动态","slug","anpr","group","field","definition","车牌识别与车辆结构化：识别率、场景适配、交通卡口与停车应用动态。","total","recent","indexable",false,"latestAt","related",[60,61],{"_47":64,"_45":65},{"_47":62,"_45":63},"video-analytics","视频智能分析","traffic","智慧交通感知",{"_67":68},"changelogVersion","2026-10-01T08:00"]

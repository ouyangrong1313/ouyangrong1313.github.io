[{"_1":2,"_3":4},"root",{"_5":66},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_45":46,"_43":42,"_47":48,"_49":50,"_51":12,"_52":12,"_53":54,"_55":26,"_56":57},"items",[14],"page",1,"pageCount",{"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5},"id","icmtvh4s7stvt5iunfh3wc2ug","title","大华股份发布基于星汉大模型的风电叶片视觉智能检测方案","summary","大华股份发布基于星汉大模型与多模态视频理解技术的风电叶片视觉智能检测方案，在风机机舱部署抗振云台实现常态化在线监测。方案在甘肃某风电场运行半年，累计抓拍约15万张叶片画面，检出2台风机3支叶片的早期裂纹和脱胶缺陷，并自动生成预警与检修建议。","reason","大华风电叶片检测方案集成星汉大模型与实际风电场半年运行数据，抓拍15万张画面检出3支缺陷叶片，验证了常态化AI巡检的可行性。","source",{"_43":44},"publishedAt","2026-09-03T00:00:00.000Z","timelineAt","category","technology","tags",[39,40,41,42],"score",50,"selected",true,"channel","news","x","产品发布","视频监控","图像算法","大华股份","name","大华股份新闻中心","slug","dahua","group","company","definition","大华股份及其子品牌（华睿科技、乐橙）的全部动态：产品线与固件更新、经营与项目、技术路线的持续追踪。","total","recent","indexable",false,"latestAt","related",[58,59,60],{"_45":64,"_43":65},{"_45":62,"_43":63},{"_45":61,"_43":39},"product-releases","uniview","宇视科技","hikvision","海康威视",{"_67":68},"changelogVersion","2026-10-01T08:00"]

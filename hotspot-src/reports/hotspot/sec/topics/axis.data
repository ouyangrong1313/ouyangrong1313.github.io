[{"_1":2,"_3":4},"root",{"_5":110},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_87":88,"_47":89,"_90":91,"_92":93,"_94":95,"_96":95,"_97":98,"_99":83,"_100":101},"items",[14,15,16,17,18],"page",1,"pageCount",{"_19":78,"_21":79,"_23":80,"_25":81,"_27":82,"_29":83,"_31":83,"_32":33,"_34":84,"_36":57,"_38":39,"_40":41,"_42":-5},{"_19":69,"_21":70,"_23":71,"_25":72,"_27":73,"_29":74,"_31":74,"_32":33,"_34":75,"_36":76,"_38":39,"_40":41,"_42":-5},{"_19":61,"_21":62,"_23":63,"_25":64,"_27":65,"_29":66,"_31":66,"_32":33,"_34":67,"_36":68,"_38":39,"_40":41,"_42":-5},{"_19":49,"_21":50,"_23":51,"_25":52,"_27":53,"_29":54,"_31":54,"_32":55,"_34":56,"_36":57,"_38":39,"_40":41,"_42":-5},{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5},"id","m2u0141zoyu2aupen1qkkif6p","title","安讯士发布 AXIS D2124-VE 雷达，360° 覆盖与 AI 分类实现全天候区域保护","summary","安讯士发布 AXIS D2124-VE 雷达，具备 360° 覆盖、AI 分类和雷达图像稳定，可全天候探测 200 米目标。人体识别面积达 40,000 m²，平均功耗 14.8 W，可与 AXIS Q6225-LE PTZ 摄像机联动实现自动跟踪复核，计划 2026 年第四季度上市。","reason","原文给出了 AXIS D2124-VE 雷达的覆盖面积、功耗和探测距离等关键参数，其与 PTZ 联动复核的设计可供大面积周界方案参考。","source",{"_47":48},"publishedAt","2026-09-01T12:46:38.000Z","timelineAt","category","product","tags",[43,44,45,46],"score",57,"selected",true,"channel","news","x","产品发布","毫米波雷达","周界防范","Axis","name","安讯士 Axis 新闻中心","b3p3phtozu484rwsv14t936si","安讯士与思科合作，在云端实现IT与安防统一管理","安讯士与思科合作，通过Axis Cloud Connect将支持的Axis设备集成到Cisco Meraki Dashboard，使IT与安防团队可在单一界面统一监测设备健康、固件和连接性，提高多站点运维效率。高级版还提供历史视频访问和30天云存储。","Axis与Cisco的云端集成方案展示了安防设备可按IT网络方式集中管理，有助于大型分布式组织提升多站点运维效率。",{"_47":48},"2026-09-09T07:00:00.000Z","industry",[58,59,60,46],56,"行业动态","视频监控","云存储","npg4yqwnewx26hqnbvtqtxdfh","安讯士发布AXIS TQ1823-VE双舱安装柜","安讯士（Axis）发布AXIS TQ1823-VE双舱安装柜，可同时容纳两台Axis设备并集成线缆管理，适用于室内外监控部署。该柜具备防破坏和宽温设计，支持壁挂或杆装，减少安装时间和硬件杂乱，将于2026年11月通过渠道上市。","AXIS TQ1823-VE 双舱安装柜集成双设备安装板与线缆管理，简化室外部署并减少杂乱，适合城市、机场等关键基础设施场景。",{"_47":48},"2026-09-11T08:48:47.000Z",[43,59,46],45,"q64nvuajyvy70ujltl57yma8z","安讯士发布AXIS D5210-E和AXIS D5211-E高性能IP供电LED补光灯","安讯士发布AXIS D5210-E和AXIS D5211-E两款IP供电LED补光灯，最远补光距离分别为175米（白光）和200米（红外），支持PoE供电与远程亮度/照射角度调节。内置lux传感器可自动触发补光，PoE out可为其他设备供电；计划2026年第四季度通过安讯士分销渠道上市。","AXIS D5210/D5211-E补光灯提供最远200米补光、PoE供电与远程调节，可直接用于系统集成和低照度监控方案选型。",{"_47":48},"2026-09-11T08:56:09.000Z",[43,77,59,46],58,"低照度","t83703w9v5xds3d6eblh5vnz7","安讯士发布 AXIS M3945-R、P3945-R 和 P3947-R 车载半球摄像机","安讯士发布三款车载半球摄像机 AXIS M3945-R（2 MP，面向巴士）、P3945-R（2 MP）和 P3947-R（5 MP，面向火车/电车），内置麦克风支持音频采集。","三款车载半球摄像机符合 UNECE R10/R118 及 EN 50155 等交通法规，音频和 Lightfinder 2.0 提升现场记录能力，且兼容现有安装接口便于升级。",{"_47":48},"2026-09-14T11:52:23.000Z",[43,85,86,77,46],"交通","音频拾取","slug","axis","Axis 安讯士","group","company","definition","Axis（安讯士）的网络摄像机产品线、芯片路线与海外标准与安全实践。","total",5,"recent","indexable",false,"latestAt","related",[102,103,104],{"_87":108,"_47":109},{"_87":106,"_47":107},{"_87":105,"_47":43},"product-releases","hanwha","Hanwha Vision","bosch","Bosch 博世",{"_111":112},"changelogVersion","2026-10-01T08:00"]

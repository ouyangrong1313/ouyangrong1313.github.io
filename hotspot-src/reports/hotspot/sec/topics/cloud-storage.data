[{"_1":2,"_3":4},"root",{"_5":135},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_111":112,"_51":113,"_114":115,"_116":117,"_118":119,"_120":121,"_122":123,"_124":106,"_125":126},"items",[14,15,16,17,18,19],"page",1,"pageCount",{"_20":100,"_22":101,"_24":102,"_26":103,"_28":104,"_30":105,"_32":106,"_33":107,"_35":108,"_37":59,"_39":40,"_41":42,"_43":-5},{"_20":88,"_22":89,"_24":90,"_26":91,"_28":92,"_30":93,"_32":93,"_33":94,"_35":95,"_37":96,"_39":40,"_41":42,"_43":-5},{"_20":74,"_22":75,"_24":76,"_26":77,"_28":78,"_30":79,"_32":79,"_33":80,"_35":81,"_37":82,"_39":40,"_41":42,"_43":-5},{"_20":62,"_22":63,"_24":64,"_26":65,"_28":66,"_30":67,"_32":67,"_33":68,"_35":69,"_37":70,"_39":40,"_41":42,"_43":-5},{"_20":53,"_22":54,"_24":55,"_26":-5,"_28":56,"_30":57,"_32":57,"_33":34,"_35":58,"_37":59,"_39":40,"_41":42,"_43":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5},"id","dupmg67utrtljduamxv5dutqp","title","Yoosee在IEAE 2026展出AI摄像头新品，硬件+服务分润模式受关注","summary","Yoosee在IEAE 2026深圳消费电子展上展出多款AI摄像头新品，并推出硬件+服务分润模式。新品免费植入人形检测、车辆检测等六大AI算法，云存储订阅服务付费次月留存率达80%，单台设备生命周期可贡献数百美元持续收益，旨在帮助跨境电商卖家从卖设备转向持续分成。","reason","原文详细介绍了Yoosee的AI摄像头硬件+服务分润模式及其免费AI算法和云存储订阅设计，为安防出海卖家提供了选品与持续收益的新思路。","source",{"_51":52},"publishedAt","2026-04-10T00:00:00.000Z","timelineAt","category","product","tags",[44,45,46,47,48,49,50],"score",26,"selected",true,"channel","news","x","产品发布","视频监控","端侧AI","云存储","人脸识别","家用消费级","技威时代","name","技威时代 Yoosee 企业动态","o9cm2ckobl14w4uxwex880twd","捷高AOV新模组TD21A/TD25率先支持终身免费智慧云卡","捷高AOV新模组TD21A/TD25率先支持终身免费智慧云卡。",{"_51":61},"2026-04-21T07:36:27.000Z",[44,45,47,60],31,"捷高","捷高电子新品动态","b3p3phtozu484rwsv14t936si","安讯士与思科合作，在云端实现IT与安防统一管理","安讯士与思科合作，通过Axis Cloud Connect将支持的Axis设备集成到Cisco Meraki Dashboard，使IT与安防团队可在单一界面统一监测设备健康、固件和连接性，提高多站点运维效率。高级版还提供历史视频访问和30天云存储。","Axis与Cisco的云端集成方案展示了安防设备可按IT网络方式集中管理，有助于大型分布式组织提升多站点运维效率。",{"_51":73},"2026-09-09T07:00:00.000Z","industry",[71,45,47,72],56,"行业动态","Axis","安讯士 Axis 新闻中心","lt3b2jt9fvurdwf1as9syu5m2","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","本文展示了视美泰AIoT-3588A主板在停车场智慧服务屏中的硬件参数和落地项目，对评估同类交互终端的边缘计算方案有参考意义。",{"_51":87},"2026-09-11T00:00:00.000Z","project",[83,46,84,85,48,86],25,"应用场景","边缘计算","车牌识别","视美泰","视美泰企业动态","exw7bw5j6nenzcs2uccm6vyzt","从信息通信业“十五五”规划看物联网发展特点","信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。","本文从连接体系、AI融合和标准化三个维度解读物联网十五五规划要点，可帮助读者把握政策导向与产业演进方向。",{"_51":99},"2026-09-14T00:00:00.000Z","policy",[97,84,98],61,"观点/分析","工信部","物联网智库资讯","w5m99se6midmav2csvvlec7qx","姿态估计算法如何实现边缘端商用？视美泰 RK3576/RK3588 AI 主板实战解析","视美泰介绍其 RK3576、RK3588 系列 AI 终端主板如何支撑姿态估计算法在边缘端商用：依靠 6TOPS NPU 完成本地推理，输出人体关键点与姿态判断结果，无需将视频流全部上传云端。配套 SDK 支持模型量化与算子适配，硬件兼容 Android、OpenHarmony，可覆盖 AI 体测、健身魔镜、运动分析和工业行为检测等场景。","原文把姿态估计算法边缘端商用拆成模型量化、算子适配与本地推理几步，适合作为边缘 AI 落地选型的参照。",{"_51":87},"2026-09-30T00:00:00.000Z","2026-09-30T06:33:30.270Z","technology",[109,46,84,110,86],"技术进展","行为分析","slug","cloud-storage","云存储与边缘计算","group","field","definition","视频云存储、边缘节点、云边协同与录像保留策略的技术与商业动态。","total",6,"recent",4,"indexable",false,"latestAt","related",[127,128,129],{"_111":134,"_51":45},{"_111":132,"_51":133},{"_111":130,"_51":131},"data-security","数据安全与隐私","codec","编解码与传输","video-surveillance",{"_136":137},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":123},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_99":100,"_50":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111,"_112":92,"_113":114},"items",[14,15,16,17,18],"page",1,"pageCount",{"_19":87,"_21":88,"_23":89,"_25":90,"_27":91,"_29":92,"_31":92,"_32":93,"_34":94,"_36":95,"_38":39,"_40":41,"_42":-5},{"_19":73,"_21":74,"_23":75,"_25":76,"_27":77,"_29":78,"_31":78,"_32":79,"_34":80,"_36":81,"_38":39,"_40":41,"_42":-5},{"_19":61,"_21":62,"_23":63,"_25":64,"_27":65,"_29":66,"_31":66,"_32":67,"_34":68,"_36":69,"_38":39,"_40":41,"_42":-5},{"_19":52,"_21":53,"_23":54,"_25":-5,"_27":55,"_29":56,"_31":56,"_32":33,"_34":57,"_36":58,"_38":39,"_40":41,"_42":-5},{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5},"id","dupmg67utrtljduamxv5dutqp","title","Yoosee在IEAE 2026展出AI摄像头新品，硬件+服务分润模式受关注","summary","Yoosee在IEAE 2026深圳消费电子展上展出多款AI摄像头新品，并推出硬件+服务分润模式。新品免费植入人形检测、车辆检测等六大AI算法，云存储订阅服务付费次月留存率达80%，单台设备生命周期可贡献数百美元持续收益，旨在帮助跨境电商卖家从卖设备转向持续分成。","reason","原文详细介绍了Yoosee的AI摄像头硬件+服务分润模式及其免费AI算法和云存储订阅设计，为安防出海卖家提供了选品与持续收益的新思路。","source",{"_50":51},"publishedAt","2026-04-10T00:00:00.000Z","timelineAt","category","product","tags",[43,44,45,46,47,48,49],"score",26,"selected",true,"channel","news","x","产品发布","视频监控","端侧AI","云存储","人脸识别","家用消费级","技威时代","name","技威时代 Yoosee 企业动态","o9cm2ckobl14w4uxwex880twd","捷高AOV新模组TD21A/TD25率先支持终身免费智慧云卡","捷高AOV新模组TD21A/TD25率先支持终身免费智慧云卡。",{"_50":60},"2026-04-21T07:36:27.000Z",[43,44,46,59],31,"捷高","捷高电子新品动态","b3p3phtozu484rwsv14t936si","安讯士与思科合作，在云端实现IT与安防统一管理","安讯士与思科合作，通过Axis Cloud Connect将支持的Axis设备集成到Cisco Meraki Dashboard，使IT与安防团队可在单一界面统一监测设备健康、固件和连接性，提高多站点运维效率。高级版还提供历史视频访问和30天云存储。","Axis与Cisco的云端集成方案展示了安防设备可按IT网络方式集中管理，有助于大型分布式组织提升多站点运维效率。",{"_50":72},"2026-09-09T07:00:00.000Z","industry",[70,44,46,71],56,"行业动态","Axis","安讯士 Axis 新闻中心","lt3b2jt9fvurdwf1as9syu5m2","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","本文展示了视美泰AIoT-3588A主板在停车场智慧服务屏中的硬件参数和落地项目，对评估同类交互终端的边缘计算方案有参考意义。",{"_50":86},"2026-09-11T00:00:00.000Z","project",[82,45,83,84,47,85],25,"应用场景","边缘计算","车牌识别","视美泰","视美泰企业动态","exw7bw5j6nenzcs2uccm6vyzt","从信息通信业“十五五”规划看物联网发展特点","信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。","本文从连接体系、AI融合和标准化三个维度解读物联网十五五规划要点，可帮助读者把握政策导向与产业演进方向。",{"_50":98},"2026-09-14T00:00:00.000Z","policy",[96,83,97],61,"观点/分析","工信部","物联网智库资讯","slug","cloud-storage","云存储与边缘计算","group","field","definition","视频云存储、边缘节点、云边协同与录像保留策略的技术与商业动态。","total",5,"recent",3,"indexable",false,"latestAt","related",[115,116,117],{"_99":122,"_50":44},{"_99":120,"_50":121},{"_99":118,"_50":119},"data-security","数据安全与隐私","codec","编解码与传输","video-surveillance",{"_124":125},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":79},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_56":57,"_46":45,"_58":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":53,"_69":70},"items",[14,15],"page",1,"pageCount",{"_16":48,"_18":49,"_20":50,"_22":51,"_24":52,"_26":53,"_28":53,"_29":54,"_31":55,"_33":34,"_35":36,"_37":38,"_39":-5},{"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5},"id","s3fh913cyocws3myalmd1l2qb","title","《网络安全标识管理办法》发布，家用摄像头为首批试点，7月施行","summary","2026年4月10日，国家网信办、工信部、公安部联合印发《网络安全标识管理办法》，7月1日起施行，消费类网联摄像头列为首批试点。办法实行基础级（一星）、增强级（二星）、领先级（三星）分级标识，生产者自愿参与，鼓励消费者优先选用。新规将加速行业洗牌，推动联网安防产品从价格竞争转向安全品质竞争。","reason","文章详细解读了网络安全标识管理办法的三级标识体系和试点范围，对消费者选购和厂商合规均有参考价值。","source",{"_46":47},"publishedAt","2026-04-20T07:58:00.000Z","timelineAt","category","policy","tags",[40,41,42,43,44,45],"score",76,"selected",true,"channel","news","x","政策/监管","视频监控","数据安全","网信办","工信部","公安部","name","CPS中安网智能安防","ry6j7cx03143kigl46vytphqm","安防“瘦身”，公安部废止119项公共安全行业标准","公安部发布公告，依据《行业标准管理办法》决定废止119项公共安全行业标准，涉及GA 374-2019《电子防盗锁》、GA/T 1093-2013《出入口控制人脸识别系统技术要求》等多项安防与警用装备标准。本次清理旨在解决标准陈旧、重复问题，为智能化转型释放空间，企业可降低合规成本并推动技术迭代。","公安部集中废止119项公共安全行业标准，企业可借此缓解多重标准导致的合规负担，并加速AI、云边协同等新技术的应用。",{"_46":47},"2026-06-23T01:19:00.000Z","standard",[40,45],"slug","mps","group","company","definition","公安部及其研究所的政策、标准归口、检测与行业管理动态。","total",2,"recent",0,"indexable",false,"latestAt","related",[71,72,73],{"_56":77,"_46":78},{"_56":30,"_46":76},{"_56":74,"_46":75},"csppi","中国安防协会","政策与监管","standards","标准发布",{"_80":81},"changelogVersion","2026-10-01T08:00"]

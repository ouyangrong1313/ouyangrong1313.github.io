[{"_1":2,"_3":4},"root",{"_5":92},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_69":70,"_45":41,"_71":72,"_73":74,"_75":76,"_77":12,"_78":79,"_80":62,"_81":82},"items",[14,15,16],"page",1,"pageCount",{"_17":57,"_19":58,"_21":59,"_23":60,"_25":61,"_27":62,"_29":62,"_30":31,"_32":63,"_34":64,"_36":37,"_38":39,"_40":-5},{"_17":47,"_19":48,"_21":49,"_23":50,"_25":51,"_27":52,"_29":52,"_30":31,"_32":53,"_34":54,"_36":37,"_38":39,"_40":-5},{"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5},"id","elw0eubbxz12wtuq36gbwl0cq","title","Yoosee广州体验店盛大开业：以服务赋能外贸商圈，共筑AI安防新标杆","summary","Yoosee于2026年1月17日在广州国际数码广场开设AI体验店，并举办行业交流会，聚焦珠三角外贸商圈。体验店以“安防体验实验室”为设计理念，展示AI摄像机的实时人车识别、哭声检测等功能，同时推出端侧算法与云端AI模型订阅、全球一卡通流量分成等模式，从硬件销售转向智能服务生态。","reason","原文详述Yoosee广州体验店如何以三大痛点解决方案构建AI安防服务生态，为消费安防渠道转型提供具体案例参考。","source",{"_45":46},"publishedAt","2026-01-20T00:00:00.000Z","timelineAt","category","industry","tags",[41,42,43,44],"score",29,"selected",true,"channel","news","x","行业动态","家用消费级","端侧AI","技威时代","name","技威时代 Yoosee 企业动态","ia14xbm4ye1vesyrnrp2toxfx","涂鸦智能发布2026年Q2及H1财报：推动AI能力在真实设备和实际场景中落地","涂鸦智能发布2026年Q2及H1财报，上半年总营收1.738亿美元，同比增长12.3%；第二季度营收9290万美元，同比增长16.0%，净利润率20.1%。公司持续推进AI能力产品化落地，上线端到端物理AI生成系统Tuya Cobuilder，AI开发者平台注册数超209万。","涂鸦智能上半年营收同比增长12.3%，AI应用收入增长明显，有助于理解智能平台在AI硬件落地中的商业化进展。",{"_45":56},"2026-08-25T01:00:00.000Z",[41,55],42,"涂鸦智能","涂鸦智能新闻","b3p3phtozu484rwsv14t936si","安讯士与思科合作，在云端实现IT与安防统一管理","安讯士与思科合作，通过Axis Cloud Connect将支持的Axis设备集成到Cisco Meraki Dashboard，使IT与安防团队可在单一界面统一监测设备健康、固件和连接性，提高多站点运维效率。高级版还提供历史视频访问和30天云存储。","Axis与Cisco的云端集成方案展示了安防设备可按IT网络方式集中管理，有助于大型分布式组织提升多站点运维效率。",{"_45":68},"2026-09-09T07:00:00.000Z",[41,65,66,67],56,"视频监控","云存储","Axis","安讯士 Axis 新闻中心","slug","industry-news","group","genre","definition","经营、财报、融资并购、人事、合作与市场数据：影响行业格局的商业事实。","total",3,"recent","indexable",false,"latestAt","related",[83,84,85],{"_69":90,"_45":91},{"_69":88,"_45":89},{"_69":86,"_45":87},"opinions","观点与分析","exhibitions","展会与活动","tenders","招投标与项目",{"_93":94},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":121},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_33":34,"_19":20,"_21":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":-5,"_57":58,"_59":60,"_61":-5,"_62":23},"index",[13,14,15,16,17,18],"today","2026-09-30",{"_19":31,"_21":32},{"_19":29,"_21":30},{"_19":27,"_21":28},{"_19":25,"_21":26},{"_19":23,"_21":24},{"_19":20,"_21":22},"key","2026-W25","title","自研芯片与海外拓展成安企增长主线","2026-W26","公安部废止119项安防标准","2026-W35","AI场景落地提速 电梯算法集成","2026-W36","AI雷达联动与边缘算力双线推进","2026-W37","补光新品与云端集成并行","2026-W38","物联网规划定调 机场安检智慧化","kind","weekly","安防热点 周报 · 2026-W25","windowStart","2026-06-14T16:00:00.000Z","windowEnd","2026-06-21T16:00:00.000Z","generatedAt","2026-09-30T07:16:33.198Z","revision",1,"lead",{"_21":22,"_120":47},"overview","本期覆盖2026年6月15日至21日。行业呈现两条主线：中维世纪以二十六年发展为注脚，依托济南高新区政策支持自研音视频后处理芯片JV9800，提出普惠AI战略，构建硬件+平台+算法+云服务全栈能力，并在农业看护、幼儿园、食品连锁等场景落地；安联锐视则先后参加越南IEAE和墨西哥EXPO SEGURIDAD，展出免钻孔窗口相机、黑光全彩夜视相机、4K超高清IP摄像机等低功耗与免钻孔方案。整体来看，国产厂商在核心芯片自研与海外市场拓展方面同步发力，以场景化产品推动AI落地。","highlights",[117,118,119],"sections",[104,105,106],"stories",[67,68,69],"flashes",[],"cover","metrics",{"_63":64,"_65":60,"_66":60},"readingMinutes",2,"prev","next","totalStories",3,"selectedCount","reportsCovered",{"_70":92,"_21":93,"_73":94,"_75":95,"_77":96,"_79":97,"_81":98,"_99":100,"_82":83,"_84":85,"_86":-5,"_87":101,"_89":83,"_90":103},{"_70":92,"_21":93,"_73":94,"_75":95,"_77":96,"_79":97,"_81":98,"_99":100,"_82":83,"_84":85,"_86":-5,"_87":101,"_89":83,"_90":102},{"_70":71,"_21":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":83,"_84":85,"_86":-5,"_87":88,"_89":83,"_90":91},"itemId","ksmqcdtlqq2l9gjfdiofnp30e","安联锐视回顾越南IEAE与墨西哥EXPO SEGURIDAD展会，展示免钻孔与低功耗安防方案","summary","安联锐视（Ansjer）于2026年5月28日至6月4日先后参加越南IEAE电子展和墨西哥EXPO SEGURIDAD，展出免钻孔窗口相机、黑光全彩夜视相机、4K超高清IP摄像机。","sourceName","安联锐视 Ansjer 官方博客","sourceUrl","https://www.ansjer.com/ansjer-security-exhibitions-recap/","sourceId","rss-ansjer-blog","sourceIconUrl","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-06-17T01:48:18.000Z","available","label","海外展会拓展市场","n4voso60clj9gy3cwko64ddjn","从创业幼苗到行业脊梁——中维世纪二十六年向上生长","中维世纪二十六年从山大路起步成长为全球安防50强，在济南高新区政策支持下自研音视频后处理芯片JV9800，提出普惠AI战略，构建硬件+平台+算法+云服务全栈能力。公司推出AI场景机、双目AOV太阳能电池球机等产品，在农业看护、幼儿园、食品连锁等场景落地，其中食品连锁案例每年节省成本超100万元、销量提升约10%。2024年底，人工智能创新应用产业园全面投产。","中维世纪企业动态","http://www.jovision.com/Company/ViewContent.aspx?id=899&cid=349","weblist-jovision-news","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico","sourceIconSrcSet","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 48w, /reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 96w","2026-06-15T00:00:00.000Z","场景化AI产品落地","自研芯片与全栈能力",{"_90":103,"_73":114,"_108":115},{"_90":102,"_73":111,"_108":112},{"_90":91,"_73":107,"_108":109},"安联锐视于2026年5月28日至6月4日先后参加越南IEAE和墨西哥EXPO SEGURIDAD，展出免钻孔窗口相机、黑光全彩夜视相机、4K超高清IP摄像机。展会聚焦免钻孔与低功耗安防方案，契合东南亚与拉美市场需求，显示中国安防企业正以差异化产品加快海外布局。","items",[110],{"_70":71,"_21":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":83,"_84":85,"_86":-5,"_87":88,"_89":83},"中维世纪推出AI场景机、双目AOV太阳能电池球机等产品，面向农业看护、幼儿园、食品连锁等细分行业提供解决方案。其中食品连锁案例每年节省成本，成为场景化AI的典型代表。普惠AI战略意味着不只关注单点技术，更强调与行业需求结合，通过软硬件协同降低应用门槛。",[113],{"_70":92,"_21":93,"_73":94,"_75":95,"_77":96,"_79":97,"_81":98,"_99":100,"_82":83,"_84":85,"_86":-5,"_87":101,"_89":83},"中维世纪从山大路创业起步，二十六年间成长为全球安防50强。在济南高新区政策支持下，公司自研音视频后处理芯片JV9800，提出普惠AI战略，形成硬件+平台+算法+云服务全栈能力。这表明龙头企业正通过核心器件自研与生态构建，提升产业链自主可控水平。",[116],{"_70":92,"_21":93,"_73":94,"_75":95,"_77":96,"_79":97,"_81":98,"_99":100,"_82":83,"_84":85,"_86":-5,"_87":101,"_89":83},{"_70":92,"_21":93,"_73":94,"_75":95,"_77":96,"_79":97,"_81":98,"_99":100,"_82":83,"_84":85,"_86":-5,"_87":101,"_89":83,"_90":103},{"_70":92,"_21":93,"_73":94,"_75":95,"_77":96,"_79":97,"_81":98,"_99":100,"_82":83,"_84":85,"_86":-5,"_87":101,"_89":83,"_90":102},{"_70":71,"_21":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":83,"_84":85,"_86":-5,"_87":88,"_89":83,"_90":91},"leadParagraph",{"_122":123},"changelogVersion","2026-10-01T08:00"]

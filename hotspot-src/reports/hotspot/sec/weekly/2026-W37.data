[{"_1":2,"_3":4},"root",{"_5":111},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_21":22,"_15":16,"_17":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":31,"_48":-5,"_49":19},"index",[13,14],"today","2026-09-30",{"_15":19,"_17":20},{"_15":16,"_17":18},"key","2026-W37","title","安讯士发布补光灯与安装柜 思科合作","2026-W38","十五五规划与智慧安检投运","kind","weekly","安防热点 周报 · 2026-W37","windowStart","2026-09-06T16:00:00.000Z","windowEnd","2026-09-13T16:00:00.000Z","generatedAt","2026-09-29T13:11:03.734Z","revision",2,"lead",{"_17":18,"_110":35},"overview","本期覆盖2026年9月7日至13日。安防热点围绕安讯士展开：发布AXIS D5210-E和AXIS D5211-E IP供电LED补光灯，最大补光距离175米（白光）和200米（红外），支持PoE供电和远程调节亮度/角度，内置lux传感器自动触发；发布AXIS TQ1823-VE双舱安装柜，可同时容纳两台设备并集成线缆，防破坏宽温设计，支持壁挂或杆装；与思科合作通过Axis Cloud Connect将设备集成到Meraki Dashboard，实现IT与安防统一管理，高级版含历史视频及30天云存储。补光灯计划2026年第四季度上市，安装柜11月上市。趋势显示安讯士在照明、安装基础设施及云管理上持续创新，并深化与IT厂商的协作。","highlights",[107,108,109],"sections",[94,95,96],"stories",[54,55,56],"flashes",[],"cover","metrics",{"_50":51,"_52":51,"_53":31},"readingMinutes","prev","next","totalStories",3,"selectedCount","reportsCovered",{"_57":88,"_17":89,"_60":90,"_62":63,"_64":91,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":92,"_79":73,"_80":93},{"_57":82,"_17":83,"_60":84,"_62":63,"_64":85,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":86,"_79":73,"_80":87},{"_57":58,"_17":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":78,"_79":73,"_80":81},"itemId","npg4yqwnewx26hqnbvtqtxdfh","安讯士发布AXIS TQ1823-VE双舱安装柜","summary","安讯士（Axis）发布AXIS TQ1823-VE双舱安装柜，可同时容纳两台Axis设备并集成线缆管理，适用于室内外监控部署。该柜具备防破坏和宽温设计，支持壁挂或杆装，减少安装时间和硬件杂乱，将于2026年11月通过渠道上市。","sourceName","安讯士 Axis 新闻中心","sourceUrl","https://newsroom.axis.com/news/dual-mount-cabinet","sourceId","rss-axis-newsroom","sourceIconUrl","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=df89d96899bf174f","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=6f4aac1922d54813 48w, /api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=25a605d17992c2cd 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-09-11T08:48:47.000Z","available","label","双舱安装柜新品","b3p3phtozu484rwsv14t936si","安讯士与思科合作，在云端实现IT与安防统一管理","安讯士与思科合作，通过Axis Cloud Connect将支持的Axis设备集成到Cisco Meraki Dashboard，使IT与安防团队可在单一界面统一监测设备健康、固件和连接性，提高多站点运维效率。高级版还提供历史视频访问和30天云存储。","https://newsroom.axis.com/blog/axis-cisco-collaboration","2026-09-09T07:00:00.000Z","IT与安防管理整合","q64nvuajyvy70ujltl57yma8z","安讯士发布AXIS D5210-E和AXIS D5211-E高性能IP供电LED补光灯","安讯士发布AXIS D5210-E和AXIS D5211-E两款IP供电LED补光灯，最远补光距离分别为175米（白光）和200米（红外），支持PoE供电与远程亮度/照射角度调节。内置lux传感器可自动触发补光，PoE out可为其他设备供电；计划2026年第四季度通过安讯士分销渠道上市。","https://newsroom.axis.com/news/led-illuminators","2026-09-11T08:56:09.000Z","高性能IP补光灯",{"_80":87,"_60":104,"_98":105},{"_80":93,"_60":101,"_98":102},{"_80":81,"_60":97,"_98":99},"安讯士发布AXIS TQ1823-VE双舱安装柜，可同时容纳两台Axis设备并集成线缆管理，适用于室内外。其防破坏和宽温设计确保恶劣环境下可靠运行，支持壁挂或杆装，减少安装时间和硬件杂乱。计划2026年11月上市。该安装柜提升了多设备部署的便利性和美观度。","items",[100],{"_57":58,"_17":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":78,"_79":73},"安讯士发布AXIS D5210-E和AXIS D5211-E两款IP供电LED补光灯，分别提供175米白光和200米红外补光距离，支持PoE供电、远程亮度/照射角度调节，内置lux传感器可自动触发补光，PoE out可为其他设备供电。产品计划2026年第四季度通过渠道上市。该补光灯兼顾高性能与智能控制，适应多种监控环境。",[103],{"_57":88,"_17":89,"_60":90,"_62":63,"_64":91,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":92,"_79":73},"安讯士与思科合作，通过Axis Cloud Connect将Axis设备集成到Cisco Meraki Dashboard，使得IT和安防团队可在单一界面监测设备健康、固件和连接性，提升多站点运维效率。高级版还提供历史视频访问和30天云存储。这一合作体现了安防与IT系统进一步融合的趋势。",[106],{"_57":82,"_17":83,"_60":84,"_62":63,"_64":85,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":86,"_79":73},{"_57":82,"_17":83,"_60":84,"_62":63,"_64":85,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":86,"_79":73,"_80":87},{"_57":88,"_17":89,"_60":90,"_62":63,"_64":91,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":92,"_79":73,"_80":93},{"_57":58,"_17":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":78,"_79":73,"_80":81},"leadParagraph",{"_112":113},"changelogVersion","2026-10-01T08:00"]

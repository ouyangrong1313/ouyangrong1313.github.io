[{"_1":2,"_3":4},"root",{"_5":141},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_33":34,"_19":29,"_21":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":-5,"_57":58,"_59":43,"_60":27,"_61":31},"index",[13,14,15,16,17,18],"today","2026-09-30",{"_19":31,"_21":32},{"_19":29,"_21":30},{"_19":27,"_21":28},{"_19":25,"_21":26},{"_19":23,"_21":24},{"_19":20,"_21":22},"key","2026-W25","title","自研芯片与海外拓展成安企增长主线","2026-W26","公安部废止119项安防标准","2026-W35","AI场景落地提速 电梯算法集成","2026-W36","AI雷达联动与边缘算力双线推进","2026-W37","补光新品与云端集成并行","2026-W38","物联网规划定调 机场安检智慧化","kind","weekly","安防热点 周报 · 2026-W37","windowStart","2026-09-06T16:00:00.000Z","windowEnd","2026-09-13T16:00:00.000Z","generatedAt","2026-09-30T07:15:41.360Z","revision",3,"lead",{"_21":30,"_140":47},"overview","本期覆盖2026年9月7日至13日。安防动态集中在产品方案与场景落地：安讯士推出AXIS D5210-E/D5211-E IP供电LED补光灯，最远补光距离为白光175米、红外200米，支持PoE供电与远程亮度/照射角度调节，内置lux传感器可自动触发补光；另发布TQ1823-VE双舱安装柜，面向室内外双设备部署。安讯士还与思科合作，将Axis设备接入Cisco Meraki Dashboard，实现IT与安防统一管理，高级版含历史视频与30天云存储。视美泰发布DSBOX-133SE高清数字标牌播放盒，主打1080P商显；其AIoT-3588A主板已在北京、上海停车场智慧服务屏落地，支持人脸断点导航、VR反向寻车等功能。整体来看，前端补光与安装配套更趋IP化和易部署，云管平台与场景化智能应用加速结合。","highlights",[137,138,139],"sections",[122,123,124],"stories",[66,67,68,69,70],"flashes",[],"cover","metrics",{"_62":63,"_64":63,"_65":43},"readingMinutes","prev","next","totalStories",5,"selectedCount","reportsCovered",{"_71":117,"_21":118,"_74":119,"_76":104,"_78":120,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":121,"_93":87,"_94":110},{"_71":111,"_21":112,"_74":113,"_76":104,"_78":114,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":115,"_93":87,"_94":116},{"_71":101,"_21":102,"_74":103,"_76":104,"_78":105,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":109,"_93":87,"_94":110},{"_71":96,"_21":97,"_74":98,"_76":77,"_78":99,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":-5,"_91":100,"_93":87,"_94":95},{"_71":72,"_21":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":-5,"_91":92,"_93":87,"_94":95},"itemId","lt3b2jt9fvurdwf1as9syu5m2","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","summary","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","sourceName","视美泰企业动态","sourceUrl","https://www.shimeta.com.cn/newsinfo/9230551.html","sourceId","weblist-shimeta-news","sourceIconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png","sourceIconSrcSet","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 48w, /reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-09-11T00:00:00.000Z","available","label","商显新品与智慧停车落地","fx8u9l7qbv3ky83zkq75dcpeq","视美泰正式发布DSBOX-133SE高清数字标牌播放盒，主打1080P商显场景","视美泰正式发布DSBOX-133SE高清数字标牌播放盒，面向1080P商显市场，强调高性价比与稳定运行。该产品搭载全志A133四核处理器及Android 10系统，支持1080P@60Hz输出，配备双USB、音频输出、以太网与WiFi等接口，采用无风扇低功耗设计和多重防护测试，可应用于电子餐牌、广告机、楼宇信息屏等场景。","https://www.shimeta.com.cn/newsinfo/9226522.html","2026-09-08T00:00:00.000Z","npg4yqwnewx26hqnbvtqtxdfh","安讯士发布AXIS TQ1823-VE双舱安装柜","安讯士（Axis）发布AXIS TQ1823-VE双舱安装柜，可同时容纳两台Axis设备并集成线缆管理，适用于室内外监控部署。该柜具备防破坏和宽温设计，支持壁挂或杆装，减少安装时间和硬件杂乱，将于2026年11月通过渠道上市。","安讯士 Axis 新闻中心","https://newsroom.axis.com/news/dual-mount-cabinet","rss-axis-newsroom","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 48w, /reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 96w","2026-09-11T08:48:47.000Z","安讯士补光新品与安装柜","b3p3phtozu484rwsv14t936si","安讯士与思科合作，在云端实现IT与安防统一管理","安讯士与思科合作，通过Axis Cloud Connect将支持的Axis设备集成到Cisco Meraki Dashboard，使IT与安防团队可在单一界面统一监测设备健康、固件和连接性，提高多站点运维效率。高级版还提供历史视频访问和30天云存储。","https://newsroom.axis.com/blog/axis-cisco-collaboration","2026-09-09T07:00:00.000Z","IT与安防云上统一管理","q64nvuajyvy70ujltl57yma8z","安讯士发布AXIS D5210-E和AXIS D5211-E高性能IP供电LED补光灯","安讯士发布AXIS D5210-E和AXIS D5211-E两款IP供电LED补光灯，最远补光距离分别为175米（白光）和200米（红外），支持PoE供电与远程亮度/照射角度调节。内置lux传感器可自动触发补光，PoE out可为其他设备供电；计划2026年第四季度通过安讯士分销渠道上市。","https://newsroom.axis.com/news/led-illuminators","2026-09-11T08:56:09.000Z",{"_94":110,"_74":133,"_126":134},{"_94":116,"_74":130,"_126":131},{"_94":95,"_74":125,"_126":127},"视美泰发布DSBOX-133SE高清数字标牌播放盒，面向1080P商显市场，搭载全志A133四核处理器与Android 10系统，支持1080P@60Hz输出，配备双USB、音频、以太网和WiFi接口，采用无风扇低功耗与多重防护设计。同时，其AIoT-3588A主板已在京沪停车场智慧服务屏落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控和异常告警，基于RK3588和6TOPS NPU在本地完成人脸检测与车牌识别推理。","items",[128,129],{"_71":96,"_21":97,"_74":98,"_76":77,"_78":99,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":-5,"_91":100,"_93":87},{"_71":72,"_21":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":-5,"_91":92,"_93":87},"安讯士与思科合作，将支持Axis Cloud Connect的Axis设备集成到Cisco Meraki Dashboard，IT与安防团队可在单一界面统一监测设备健康、固件和连接性，提升多站点运维效率。高级版还提供历史视频访问与30天云存储。这一合作体现了安防设备与IT基础设施在云端管理层面的融合趋势。",[132],{"_71":111,"_21":112,"_74":113,"_76":104,"_78":114,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":115,"_93":87},"安讯士推出AXIS D5210-E和AXIS D5211-E高性能IP供电LED补光灯，白光最远补光175米、红外200米，支持PoE供电、远程亮度与照射角度调节，内置lux传感器可自动触发补光，PoE out还能为其他设备供电。同期发布的AXIS TQ1823-VE双舱安装柜可容纳两台Axis设备并集成线缆管理，具备防破坏和宽温设计，支持壁挂或杆装，计划2026年第四季度或11月分别通过渠道上市。",[135,136],{"_71":117,"_21":118,"_74":119,"_76":104,"_78":120,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":121,"_93":87},{"_71":101,"_21":102,"_74":103,"_76":104,"_78":105,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":109,"_93":87},{"_71":117,"_21":118,"_74":119,"_76":104,"_78":120,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":121,"_93":87,"_94":110},{"_71":101,"_21":102,"_74":103,"_76":104,"_78":105,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":109,"_93":87,"_94":110},{"_71":111,"_21":112,"_74":113,"_76":104,"_78":114,"_80":106,"_82":107,"_84":108,"_86":87,"_88":89,"_90":-5,"_91":115,"_93":87,"_94":116},"leadParagraph",{"_142":143},"changelogVersion","2026-10-01T08:00"]

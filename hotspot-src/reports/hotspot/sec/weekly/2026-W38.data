[{"_1":2,"_3":4},"root",{"_5":154},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_33":34,"_19":31,"_21":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":-5,"_57":58,"_59":60,"_61":29,"_62":-5},"index",[13,14,15,16,17,18],"today","2026-09-30",{"_19":31,"_21":32},{"_19":29,"_21":30},{"_19":27,"_21":28},{"_19":25,"_21":26},{"_19":23,"_21":24},{"_19":20,"_21":22},"key","2026-W25","title","自研芯片与海外拓展成安企增长主线","2026-W26","公安部废止119项安防标准","2026-W35","AI场景落地提速 电梯算法集成","2026-W36","AI雷达联动与边缘算力双线推进","2026-W37","补光新品与云端集成并行","2026-W38","物联网规划定调 机场安检智慧化","kind","weekly","安防热点 周报 · 2026-W38","windowStart","2026-09-13T16:00:00.000Z","windowEnd","2026-09-20T16:00:00.000Z","generatedAt","2026-09-30T07:15:09.319Z","revision",3,"lead",{"_21":32,"_153":47},"overview","本期覆盖2026年9月14日至20日。信息通信业“十五五”规划明确物联网发展三大方向：5G-A+6G+卫星协同连接、人工智能融合、补齐标准与数据安全短板，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。福州长乐机场T2航站楼于9月16日投运，同方威视近300台套智慧安检设备同步上线，涵盖手提行李CT、毫米波人体安检门，依托AI实现辅助判图与安检质控。HID发布兼顾门禁安全与设计美学的Signo Décor读卡器，安讯士发布三款车载半球摄像机，视美泰拆解面向交互大屏的AIoT-3576EV主板，端侧AI与移动监控产品持续更新。","highlights",[150,151,152],"sections",[132,133,134,135],"stories",[67,68,69,70,71],"flashes",[],"cover","metrics",{"_63":64,"_65":64,"_66":43},"readingMinutes",2,"prev","next","totalStories",5,"selectedCount","reportsCovered",{"_72":124,"_21":125,"_75":126,"_77":127,"_79":128,"_81":129,"_83":-5,"_87":121,"_89":122,"_91":-5,"_92":130,"_94":88,"_95":131},{"_72":115,"_21":116,"_75":117,"_77":118,"_79":119,"_81":120,"_83":-5,"_87":121,"_89":122,"_91":-5,"_92":123,"_94":88,"_95":114},{"_72":105,"_21":106,"_75":107,"_77":108,"_79":109,"_81":110,"_83":111,"_85":112,"_87":88,"_89":90,"_91":-5,"_92":113,"_94":88,"_95":114},{"_72":97,"_21":98,"_75":99,"_77":100,"_79":101,"_81":102,"_83":-5,"_87":88,"_89":90,"_91":-5,"_92":103,"_94":88,"_95":104},{"_72":73,"_21":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":93,"_94":88,"_95":96},"itemId","k0g55fpi9kyhfbducbkdxhydq","拆解视美泰 AIoT-3576EV：面向交互大屏的 RK3576 硬件方案","summary","视美泰在官方动态中拆解了AIoT-3576EV主板，该主板基于瑞芯微RK3576平台（8核CPU+6TOPS NPU），支持4K@120Hz显示、7路USB及工业总线扩展，面向B端整机厂商和集成商，能够本地运行数字人驱动、客流统计等AI业务。","sourceName","视美泰企业动态","sourceUrl","https://www.shimeta.com.cn/newsinfo/9236118.html","sourceId","weblist-shimeta-news","sourceIconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png","sourceIconSrcSet","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 48w, /reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-09-16T00:00:00.000Z","available","label","端侧AI硬件方案显现","z1xgmtt4mk2vqdqcwcnsan09g","同方威视在福州长乐机场T2部署近300台套智慧安检设备","2026年9月16日，福州长乐国际机场T2航站楼正式投运，同方威视近300台套安检设备及智慧安检方案同步上线。方案涵盖手提行李CT、毫米波人体安检门等设备，依托AI实现辅助判图与安检质控，并创新“一机双屏、一次过检”关航联合查验模式，支撑年3600万人次旅客吞吐量。","中国安防协会企业动态","https://xh.21csp.com.cn/c62/202609/11430785.html","weblist-csppi-company","2026-09-18T00:00:00.000Z","机场智慧安检规模落地","t83703w9v5xds3d6eblh5vnz7","安讯士发布 AXIS M3945-R、P3945-R 和 P3947-R 车载半球摄像机","安讯士发布三款车载半球摄像机 AXIS M3945-R（2 MP，面向巴士）、P3945-R（2 MP）和 P3947-R（5 MP，面向火车/电车），内置麦克风支持音频采集。","安讯士 Axis 新闻中心","https://newsroom.axis.com/news/rugged-dome-cameras","rss-axis-newsroom","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 48w, /reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 96w","2026-09-14T11:52:23.000Z","门禁与车载产品更新","fhofkey37gkbgw9t6nd2n6yc2","HID推出全新Signo Décor读卡器，兼顾门禁安全与设计美学","HID推出全新Signo Décor读卡器，专为注重设计的空间打造，同时不牺牲门禁安全性。产品支持齐平安装，具备IK10防冲击和IP65防护等级，搭载EAL5+安全元件并通过OSDP协议加密通信。基于蓝牙和NFC，用户可使用手机完成开门，现已在欧洲、中国大陆、香港、新加坡和阿联酋开放订购，更多型号将于今年内推出。","a&s 安防知识网资讯","https://www.asmag.com.cn/news/202609/115314.html","weblist-asmag-news",false,"媒体","2026-09-20T00:00:00.000Z","exw7bw5j6nenzcs2uccm6vyzt","从信息通信业“十五五”规划看物联网发展特点","信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。","物联网智库资讯","https://www.iot101.com/news/10680.html","weblist-iot101-news","2026-09-14T00:00:00.000Z","政策定调物联网演进方向",{"_95":131,"_75":147,"_137":148},{"_95":104,"_75":144,"_137":145},{"_95":114,"_75":140,"_137":141},{"_95":96,"_75":136,"_137":138},"视美泰在官方动态中拆解AIoT-3576EV主板，该方案基于瑞芯微RK3576平台，拥有8核CPU与6 TOPS NPU，支持4K@120Hz显示、7路USB及工业总线扩展，面向B端整机厂商和集成商，可本地运行数字人驱动、客流统计等AI业务。该硬件方案将AI能力下沉至交互大屏与终端设备。","items",[139],{"_72":73,"_21":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":93,"_94":88},"HID推出Signo Décor读卡器，主打门禁安全与空间设计兼顾，支持齐平安装，具备IK10防冲击和IP65防护等级，内置EAL5+安全元件，通信采用OSDP加密协议，并可通过蓝牙和NFC用手机开门，已在欧洲、中国大陆、香港、新加坡和阿联酋推出。安讯士发布AXIS M3945-R、P3945-R和P3947-R三款车载半球摄像机，覆盖巴士、火车和电车场景，内置麦克风，分辨率覆盖2 MP至5 MP。",[142,143],{"_72":115,"_21":116,"_75":117,"_77":118,"_79":119,"_81":120,"_83":-5,"_87":121,"_89":122,"_91":-5,"_92":123,"_94":88},{"_72":105,"_21":106,"_75":107,"_77":108,"_79":109,"_81":110,"_83":111,"_85":112,"_87":88,"_89":90,"_91":-5,"_92":113,"_94":88},"福州长乐国际机场T2航站楼于2026年9月16日投运，同方威视部署近300台套安检设备及智慧安检方案，覆盖手提行李CT、毫米波人体安检门等装备，依托AI实现辅助判图与安检质控，并以“一机双屏、一次过检”关航联合查验模式运行，以支撑年3600万人次旅客吞吐量。该案例体现AI与大型机场安检流程的深度结合。",[146],{"_72":97,"_21":98,"_75":99,"_77":100,"_79":101,"_81":102,"_83":-5,"_87":88,"_89":90,"_91":-5,"_92":103,"_94":88},"信息通信业“十五五”规划明确物联网三大演进方向：5G-A+6G+卫星协同连接、人工智能融合、补齐标准与数据安全短板；要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。规划提出的连接能力升级、AI融合与安全补短板要求，构成物联网和泛安防终端未来数年的发展基线。",[149],{"_72":124,"_21":125,"_75":126,"_77":127,"_79":128,"_81":129,"_83":-5,"_87":121,"_89":122,"_91":-5,"_92":130,"_94":88},{"_72":124,"_21":125,"_75":126,"_77":127,"_79":128,"_81":129,"_83":-5,"_87":121,"_89":122,"_91":-5,"_92":130,"_94":88,"_95":131},{"_72":97,"_21":98,"_75":99,"_77":100,"_79":101,"_81":102,"_83":-5,"_87":88,"_89":90,"_91":-5,"_92":103,"_94":88,"_95":104},{"_72":115,"_21":116,"_75":117,"_77":118,"_79":119,"_81":120,"_83":-5,"_87":121,"_89":122,"_91":-5,"_92":123,"_94":88,"_95":114},"leadParagraph",{"_155":156},"changelogVersion","2026-10-01T08:00"]

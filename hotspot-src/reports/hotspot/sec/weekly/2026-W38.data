[{"_1":2,"_3":4},"root",{"_5":130},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_21":22,"_15":19,"_17":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":31,"_48":16,"_49":-5},"index",[13,14],"today","2026-09-30",{"_15":19,"_17":20},{"_15":16,"_17":18},"key","2026-W37","title","安讯士发布补光灯与安装柜 思科合作","2026-W38","十五五规划与智慧安检投运","kind","weekly","安防热点 周报 · 2026-W38","windowStart","2026-09-13T16:00:00.000Z","windowEnd","2026-09-20T16:00:00.000Z","generatedAt","2026-09-29T13:10:19.986Z","revision",2,"lead",{"_17":20,"_129":35},"overview","本期覆盖2026年9月14日至20日。信息通信业“十五五”规划明确物联网发展三大方向：5G-A+6G+卫星协同、人工智能融合、补齐标准数据安全短板，并提出移动物联网终端用户突破38亿、2030年建成新一代通信网的目标，为安防物联网指明演进路径。产品领域，HID推出Signo Décor读卡器，兼顾设计美学与门禁安全，支持手机开门；安讯士发布AXIS M3945-R等三款车载半球摄像机，内置麦克风满足移动监控需求。场景应用方面，同方威视近300台套智慧安检设备在福州长乐机场T2航站楼投运，集成CT、毫米波安检门及AI辅助判图系统，创新“一机双屏、一次过检”关航联合查验模式，可支撑年3600万人次旅客吞吐量，标志着智慧安检在大型交通枢纽的深度落地。","highlights",[126,127,128],"sections",[109,110,111,112],"stories",[54,55,56,57],"flashes",[],"cover","metrics",{"_50":51,"_52":51,"_53":31},"readingMinutes","prev","next","totalStories",4,"selectedCount","reportsCovered",{"_58":101,"_17":102,"_61":103,"_63":104,"_65":105,"_67":106,"_69":-5,"_70":97,"_72":98,"_74":-5,"_75":107,"_77":71,"_78":108},{"_58":91,"_17":92,"_61":93,"_63":94,"_65":95,"_67":96,"_69":-5,"_70":97,"_72":98,"_74":-5,"_75":99,"_77":71,"_78":100},{"_58":80,"_17":81,"_61":82,"_63":83,"_65":84,"_67":85,"_69":86,"_87":88,"_70":71,"_72":73,"_74":-5,"_75":89,"_77":71,"_78":90},{"_58":59,"_17":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":-5,"_70":71,"_72":73,"_74":-5,"_75":76,"_77":71,"_78":79},"itemId","z1xgmtt4mk2vqdqcwcnsan09g","同方威视在福州长乐机场T2部署近300台套智慧安检设备","summary","2026年9月16日，福州长乐国际机场T2航站楼正式投运，同方威视近300台套安检设备及智慧安检方案同步上线。方案涵盖手提行李CT、毫米波人体安检门等设备，依托AI实现辅助判图与安检质控，并创新“一机双屏、一次过检”关航联合查验模式，支撑年3600万人次旅客吞吐量。","sourceName","中国安防协会企业动态","sourceUrl","https://xh.21csp.com.cn/c62/202609/11430785.html","sourceId","weblist-csppi-company","sourceIconUrl","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-09-18T00:00:00.000Z","available","label","机场安检智慧落地","t83703w9v5xds3d6eblh5vnz7","安讯士发布 AXIS M3945-R、P3945-R 和 P3947-R 车载半球摄像机","安讯士发布三款车载半球摄像机 AXIS M3945-R（2 MP，面向巴士）、P3945-R（2 MP）和 P3947-R（5 MP，面向火车/电车），内置麦克风支持音频采集。","安讯士 Axis 新闻中心","https://newsroom.axis.com/news/rugged-dome-cameras","rss-axis-newsroom","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=df89d96899bf174f","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=6f4aac1922d54813 48w, /api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=25a605d17992c2cd 96w","2026-09-14T11:52:23.000Z","车载监控新品发布","fhofkey37gkbgw9t6nd2n6yc2","HID推出全新Signo Décor读卡器，兼顾门禁安全与设计美学","HID推出全新Signo Décor读卡器，专为注重设计的空间打造，同时不牺牲门禁安全性。产品支持齐平安装，具备IK10防冲击和IP65防护等级，搭载EAL5+安全元件并通过OSDP协议加密通信。基于蓝牙和NFC，用户可使用手机完成开门，现已在欧洲、中国大陆、香港、新加坡和阿联酋开放订购，更多型号将于今年内推出。","a&s 安防知识网资讯","https://www.asmag.com.cn/news/202609/115314.html","weblist-asmag-news",false,"媒体","2026-09-20T00:00:00.000Z","门禁新品兼顾美学","exw7bw5j6nenzcs2uccm6vyzt","从信息通信业“十五五”规划看物联网发展特点","信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。","物联网智库资讯","https://www.iot101.com/news/10680.html","weblist-iot101-news","2026-09-14T00:00:00.000Z","政策指引物联方向",{"_78":108,"_61":123,"_114":124},{"_78":79,"_61":120,"_114":121},{"_78":100,"_61":117,"_114":118},{"_78":90,"_61":113,"_114":115},"安讯士发布三款车载半球摄像机：AXIS M3945-R（2 MP，面向巴士）、P3945-R（2 MP）和P3947-R（5 MP，面向火车/电车），内置麦克风支持音频采集。这些产品专为公共交通移动环境设计，强化了车载安防的视频监控能力，满足运输场景中对于可靠性和环境适应性的要求。","items",[116],{"_58":80,"_17":81,"_61":82,"_63":83,"_65":84,"_67":85,"_69":86,"_87":88,"_70":71,"_72":73,"_74":-5,"_75":89,"_77":71},"HID推出Signo Décor读卡器，专为注重设计的空间打造，同时不牺牲门禁安全性。产品支持齐平安装，具备IK10防冲击和IP65防护等级，搭载EAL5+安全元件并通过OSDP协议加密通信。基于蓝牙和NFC，用户可使用手机完成开门，现已在欧洲、中国大陆、香港、新加坡和阿联酋上市，体现了门禁产品向安全与美学并重的发展趋势。",[119],{"_58":91,"_17":92,"_61":93,"_63":94,"_65":95,"_67":96,"_69":-5,"_70":97,"_72":98,"_74":-5,"_75":99,"_77":71},"同方威视在福州长乐国际机场T2航站楼投运近300台套智慧安检设备及方案，涵盖手提行李CT、毫米波人体安检门等尖端设备，依托AI实现辅助判图与安检质控，创新推出“一机双屏、一次过检”关航联合查验模式。该方案支撑年3600万人次旅客吞吐量，大幅提升安检效率与安全水平，是智慧安检在大型交通枢纽的重要示范。",[122],{"_58":59,"_17":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":-5,"_70":71,"_72":73,"_74":-5,"_75":76,"_77":71},"信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。该规划为安防行业的物联网应用提供了通信基础设施和技术升级的战略方向，推动安防系统向更高带宽、更低时延、更广覆盖和更深度的智能融合演进。",[125],{"_58":101,"_17":102,"_61":103,"_63":104,"_65":105,"_67":106,"_69":-5,"_70":97,"_72":98,"_74":-5,"_75":107,"_77":71},{"_58":101,"_17":102,"_61":103,"_63":104,"_65":105,"_67":106,"_69":-5,"_70":97,"_72":98,"_74":-5,"_75":107,"_77":71,"_78":108},{"_58":59,"_17":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":-5,"_70":71,"_72":73,"_74":-5,"_75":76,"_77":71,"_78":79},{"_58":91,"_17":92,"_61":93,"_63":94,"_65":95,"_67":96,"_69":-5,"_70":97,"_72":98,"_74":-5,"_75":99,"_77":71,"_78":100},"leadParagraph",{"_131":132},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":99},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_33":34,"_19":23,"_21":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":-5,"_57":58,"_59":43,"_60":20,"_61":25},"index",[13,14,15,16,17,18],"today","2026-09-30",{"_19":31,"_21":32},{"_19":29,"_21":30},{"_19":27,"_21":28},{"_19":25,"_21":26},{"_19":23,"_21":24},{"_19":20,"_21":22},"key","2026-W25","title","自研芯片与海外拓展成安企增长主线","2026-W26","公安部废止119项安防标准","2026-W35","AI场景落地提速 电梯算法集成","2026-W36","AI雷达联动与边缘算力双线推进","2026-W37","补光新品与云端集成并行","2026-W38","物联网规划定调 机场安检智慧化","kind","weekly","安防热点 周报 · 2026-W26","windowStart","2026-06-21T16:00:00.000Z","windowEnd","2026-06-28T16:00:00.000Z","generatedAt","2026-09-30T07:16:08.252Z","revision",1,"lead",{"_21":24,"_98":47},"overview","2026年6月22日至28日，公安部发布公告，依据《行业标准管理办法》决定废止119项公共安全行业标准，其中包括GA 374-2019《电子防盗锁》、GA/T 1093-2013《出入口控制人脸识别系统技术要求》等多项安防与警用装备标准。本次清理旨在解决标准陈旧、重复问题，为智能化转型释放空间，同时降低企业合规成本。","highlights",[97],"sections",[92],"stories",[65],"flashes",[],"cover","metrics",{"_62":43,"_63":43,"_64":43},"readingMinutes","prev","next","totalStories","selectedCount","reportsCovered",{"_66":67,"_21":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":87,"_88":89,"_90":91},"itemId","ry6j7cx03143kigl46vytphqm","安防“瘦身”，公安部废止119项公共安全行业标准","summary","公安部发布公告，依据《行业标准管理办法》决定废止119项公共安全行业标准，涉及GA 374-2019《电子防盗锁》、GA/T 1093-2013《出入口控制人脸识别系统技术要求》等多项安防与警用装备标准。本次清理旨在解决标准陈旧、重复问题，为智能化转型释放空间，企业可降低合规成本并推动技术迭代。","sourceName","CPS中安网智能安防","sourceUrl","http://news.cps.com.cn/article/202606/943750.html","sourceId","weblist-cps-news","sourceIconUrl","/reports/hotspot/sec/avatars/b652901aa45148336630.ico","sourceIconSrcSet","/reports/hotspot/sec/avatars/b652901aa45148336630.ico 48w, /reports/hotspot/sec/avatars/b652901aa45148336630.ico 96w","firstParty",false,"role","媒体","storyPublicId","publishedAt","2026-06-23T01:19:00.000Z","available",true,"label","标准清理与转型",{"_90":91,"_69":93,"_94":95},"本期最核心的动态是公安部大规模废止119项公共安全行业标准，覆盖电子防盗锁、出入口控制人脸识别系统等安防与警用装备领域。此次清理依据《行业标准管理办法》，旨在剔除陈旧、重复的标准，为智能化转型释放制度空间，并有助于降低企业的合规成本。","items",[96],{"_66":67,"_21":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":87,"_88":89},{"_66":67,"_21":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":87,"_88":89,"_90":91},"leadParagraph",{"_100":101},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":132},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_33":34,"_19":25,"_21":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":-5,"_57":58,"_59":60,"_61":23,"_62":27},"index",[13,14,15,16,17,18],"today","2026-09-30",{"_19":31,"_21":32},{"_19":29,"_21":30},{"_19":27,"_21":28},{"_19":25,"_21":26},{"_19":23,"_21":24},{"_19":20,"_21":22},"key","2026-W25","title","自研芯片与海外拓展成安企增长主线","2026-W26","公安部废止119项安防标准","2026-W35","AI场景落地提速 电梯算法集成","2026-W36","AI雷达联动与边缘算力双线推进","2026-W37","补光新品与云端集成并行","2026-W38","物联网规划定调 机场安检智慧化","kind","weekly","安防热点 周报 · 2026-W35","windowStart","2026-08-23T16:00:00.000Z","windowEnd","2026-08-30T16:00:00.000Z","generatedAt","2026-09-30T07:16:01.577Z","revision",1,"lead",{"_21":26,"_131":47},"overview","本期覆盖2026年8月24日至8月30日。涂鸦智能发布Q2及H1财报，上半年营收同比增长12.3%，AI开发者平台注册数突破209万，并推出端到端物理AI生成系统，推动AI在真实设备中落地。中维世纪发布电梯四合一算法场景机，集成煤气罐、电动车、困人与遮挡检测，实现梯控联动与主动告警。视美泰携全栈AI方案亮相深圳智慧显示博览会，展出多款AI主板、智能体广告机及OpenHarmony系列产品，显示AI能力正加速融入垂直场景与终端设备。","highlights",[128,129,130],"sections",[115,116,117],"stories",[67,68,69],"flashes",[],"cover","metrics",{"_63":64,"_65":64,"_66":64},"readingMinutes",2,"prev","next","totalStories",3,"selectedCount","reportsCovered",{"_70":105,"_21":106,"_73":107,"_75":108,"_77":109,"_79":110,"_81":111,"_83":112,"_85":86,"_87":88,"_89":-5,"_90":113,"_92":86,"_93":114},{"_70":95,"_21":96,"_73":97,"_75":98,"_77":99,"_79":100,"_81":101,"_83":102,"_85":86,"_87":88,"_89":-5,"_90":103,"_92":86,"_93":104},{"_70":71,"_21":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":-5,"_90":91,"_92":86,"_93":94},"itemId","yohsi83a932qyegd9l99czim4","视美泰携全栈AI方案亮相第八届深圳智慧显示博览会","summary","2026年8月26-28日，视美泰亮相第八届深圳（国际）智慧显示系统产业应用博览会，展出基于瑞芯微等平台的RK3568、RK3576、RK3588系列主板盒子，以及AI大模型双屏翻译机、智能体广告机、多模态语视交互模组等产品，并布局OpenHarmony开源鸿蒙系列与AIBOX-M88边缘计算平台。","sourceName","视美泰企业动态","sourceUrl","https://www.shimeta.com.cn/newsinfo/9212330.html","sourceId","weblist-shimeta-news","sourceIconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png","sourceIconSrcSet","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 48w, /reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-08-27T00:00:00.000Z","available","label","智慧显示与全栈AI方案展示","dwcwafzuwe8fvzhfq5sns3fic","中维世纪发布电梯四合一算法场景机，集成电动车、煤气罐、困人与遮挡检测","中维世纪发布电梯四合一算法场景机，内置煤气罐检测、电动车检测、困人检测和遮挡检测四种算法。电动车或煤气罐入梯时联动梯控阻止关门；困人检测自动推送物业；遮挡检测触发防御警报并阻止关门。","中维世纪企业动态","http://www.jovision.com/Company/ViewContent.aspx?id=903&cid=349","weblist-jovision-news","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 48w, /reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 96w","2026-08-28T00:00:00.000Z","电梯场景智能算法集成","ia14xbm4ye1vesyrnrp2toxfx","涂鸦智能发布2026年Q2及H1财报：推动AI能力在真实设备和实际场景中落地","涂鸦智能发布2026年Q2及H1财报，上半年总营收1.738亿美元，同比增长12.3%；第二季度营收9290万美元，同比增长16.0%，净利润率20.1%。公司持续推进AI能力产品化落地，上线端到端物理AI生成系统Tuya Cobuilder，AI开发者平台注册数超209万。","涂鸦智能新闻","https://www.tuya.com/cn/news-details/Kfw78hyi7htuk","weblist-tuya-news","/reports/hotspot/sec/avatars/bb46cef0a0b0e1a7ddc7.png","/reports/hotspot/sec/avatars/bb46cef0a0b0e1a7ddc7.png 48w, /reports/hotspot/sec/avatars/bb46cef0a0b0e1a7ddc7.png 96w","2026-08-25T01:00:00.000Z","AI产品化进程加速",{"_93":114,"_73":125,"_119":126},{"_93":104,"_73":122,"_119":123},{"_93":94,"_73":118,"_119":120},"视美泰在深圳智慧显示博览会上展出基于瑞芯微平台的系列主板盒子，以及AI大模型双屏翻译机、智能体广告机、多模态语视交互模组等产品，并布局OpenHarmony系列与AIBOX产品，体现AI与显示产业深度融合的趋势。","items",[121],{"_70":71,"_21":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":-5,"_90":91,"_92":86},"中维世纪发布电梯四合一算法场景机，将煤气罐、电动车、困人、遮挡检测集成于一体，并联动梯控实现阻止关门、自动推送物业和防御警报，提升了电梯安全管理的智能化与响应效率。",[124],{"_70":95,"_21":96,"_73":97,"_75":98,"_77":99,"_79":100,"_81":101,"_83":102,"_85":86,"_87":88,"_89":-5,"_90":103,"_92":86},"涂鸦智能财报显示其营收稳步增长，第二季度净利润率20.1%，同时推出端到端物理AI生成系统Tuya Cobuilder，AI开发者平台注册数超209万，反映AI能力正从平台侧向真实设备和场景规模化落地。",[127],{"_70":105,"_21":106,"_73":107,"_75":108,"_77":109,"_79":110,"_81":111,"_83":112,"_85":86,"_87":88,"_89":-5,"_90":113,"_92":86},{"_70":105,"_21":106,"_73":107,"_75":108,"_77":109,"_79":110,"_81":111,"_83":112,"_85":86,"_87":88,"_89":-5,"_90":113,"_92":86,"_93":114},{"_70":95,"_21":96,"_73":97,"_75":98,"_77":99,"_79":100,"_81":101,"_83":102,"_85":86,"_87":88,"_89":-5,"_90":103,"_92":86,"_93":104},{"_70":71,"_21":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":-5,"_90":91,"_92":86,"_93":94},"leadParagraph",{"_133":134},"changelogVersion","2026-10-01T08:00"]

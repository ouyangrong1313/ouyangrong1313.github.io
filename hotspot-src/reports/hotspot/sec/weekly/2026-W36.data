[{"_1":2,"_3":4},"root",{"_5":140},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_33":34,"_19":27,"_21":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":-5,"_57":58,"_59":60,"_61":25,"_62":29},"index",[13,14,15,16,17,18],"today","2026-09-30",{"_19":31,"_21":32},{"_19":29,"_21":30},{"_19":27,"_21":28},{"_19":25,"_21":26},{"_19":23,"_21":24},{"_19":20,"_21":22},"key","2026-W25","title","自研芯片与海外拓展成安企增长主线","2026-W26","公安部废止119项安防标准","2026-W35","AI场景落地提速 电梯算法集成","2026-W36","AI雷达联动与边缘算力双线推进","2026-W37","补光新品与云端集成并行","2026-W38","物联网规划定调 机场安检智慧化","kind","weekly","安防热点 周报 · 2026-W36","windowStart","2026-08-30T16:00:00.000Z","windowEnd","2026-09-06T16:00:00.000Z","generatedAt","2026-09-30T07:15:54.114Z","revision",1,"lead",{"_21":28,"_139":47},"overview","本期覆盖2026年8月31日至9月6日。本周动态显示，安防行业继续沿AI化、场景化与边缘化方向深化。安讯士推出新一代雷达，具备360°覆盖、AI目标分类及雷达图像稳定能力，并与PTZ摄像机联动自动跟踪复核，极大提升全天候区域防护的智能化水平。大华股份发布基于星汉大模型的风电叶片视觉检测方案，将AI视觉技术与行业场景深度结合，在甘肃风电场实现常态化在线监测并有效检出缺陷。视美泰连续发布两款AI终端主板，分别面向交互大屏与紧凑型设备，以6TOPS NPU和丰富接口为边缘端AI应用提供算力底座。整体来看，本期产品与技术发布共同指向“感知智能化、算法场景化、终端边缘化”的趋势。","highlights",[136,137,138],"sections",[122,123,124],"stories",[68,69,70,71],"flashes",[],"cover","metrics",{"_63":64,"_65":64,"_66":67},"readingMinutes",2,"prev","next","totalStories",4,"selectedCount","reportsCovered",3,{"_72":112,"_21":113,"_75":114,"_77":115,"_79":116,"_81":117,"_83":118,"_85":119,"_87":88,"_89":90,"_91":-5,"_92":120,"_94":88,"_95":121},{"_72":102,"_21":103,"_75":104,"_77":105,"_79":106,"_81":107,"_83":108,"_85":109,"_87":88,"_89":90,"_91":-5,"_92":110,"_94":88,"_95":111},{"_72":97,"_21":98,"_75":99,"_77":78,"_79":100,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":101,"_94":88,"_95":96},{"_72":73,"_21":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":93,"_94":88,"_95":96},"itemId","whoyby6caxyvkntk5vy9eoy3j","视美泰发布AIoT-3576SE主板：100×80mm尺寸，6TOPS NPU，丰富接口","summary","视美泰发布AIoT-3576SE主板，基于瑞芯微RK3576八核芯片，集成6TOPS NPU，尺寸100×80mm。支持4K输出、MIPI摄像头和语音功能，待机电流低至22mA，适用于智能家居中控、小型网关等紧凑场景。","sourceName","视美泰企业动态","sourceUrl","https://www.shimeta.com.cn/newsinfo/9217068.html","sourceId","weblist-shimeta-news","sourceIconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png","sourceIconSrcSet","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 48w, /reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-08-31T00:00:00.000Z","available","label","边缘终端算力持续增强","cuq8e1xamuijnb8qo89s2pdcc","视美泰发布AIoT-3576EV AI终端主板，面向交互大屏全品类设备","视美泰发布AIoT-3576EV AI终端主板，搭载RK3576八核处理器与6TOPS NPU，支持M.2算力扩展与双千兆网口，具备V-By-One 4K@120Hz显示输出能力，适用于AI数字人、体测一体机、服务机器人等交互大屏设备。","https://www.shimeta.com.cn/newsinfo/9218557.html","2026-09-01T00:00:00.000Z","icmtvh4s7stvt5iunfh3wc2ug","大华股份发布基于星汉大模型的风电叶片视觉智能检测方案","大华股份发布基于星汉大模型与多模态视频理解技术的风电叶片视觉智能检测方案，在风机机舱部署抗振云台实现常态化在线监测。方案在甘肃某风电场运行半年，累计抓拍约15万张叶片画面，检出2台风机3支叶片的早期裂纹和脱胶缺陷，并自动生成预警与检修建议。","大华股份新闻中心","https://www.dahuatech.com/news/info/1245.html?page=1","weblist-dahua-news","/reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico","/reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico 48w, /reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico 96w","2026-09-03T00:00:00.000Z","AI视觉下沉行业场景","m2u0141zoyu2aupen1qkkif6p","安讯士发布 AXIS D2124-VE 雷达，360° 覆盖与 AI 分类实现全天候区域保护","安讯士发布 AXIS D2124-VE 雷达，具备 360° 覆盖、AI 分类和雷达图像稳定，可全天候探测 200 米目标。人体识别面积达 40,000 m²，平均功耗 14.8 W，可与 AXIS Q6225-LE PTZ 摄像机联动实现自动跟踪复核，计划 2026 年第四季度上市。","安讯士 Axis 新闻中心","https://newsroom.axis.com/news/radar-device-area-protection","rss-axis-newsroom","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 48w, /reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 96w","2026-09-01T12:46:38.000Z","雷达感知智能化升级",{"_95":121,"_75":133,"_126":134},{"_95":111,"_75":130,"_126":131},{"_95":96,"_75":125,"_126":127},"视美泰本周发布两款基于瑞芯微RK3576的主板：AIoT-3576EV面向交互大屏全品类设备，支持M.2算力扩展、双千兆网口及4K@120Hz显示输出，适用于AI数字人、体测一体机与服务机器人；AIoT-3576SE采用100×80毫米紧凑尺寸，集成6TOPS NPU且待机电流低至22毫安，适合智能家居中控和小型网关。两款主板均以6TOPS NPU强化边缘AI处理能力，反映出终端设备对本地推理与低功耗的需求持续上升。","items",[128,129],{"_72":97,"_21":98,"_75":99,"_77":78,"_79":100,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":101,"_94":88},{"_72":73,"_21":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":93,"_94":88},"大华股份发布基于星汉大模型与多模态视频理解技术的风电叶片视觉智能检测方案，通过部署在风机机舱的抗振云台实现常态化在线监测。方案在甘肃某风电场运行半年，累计抓拍约15万张叶片画面，成功检出2台风机3支叶片的早期裂纹和脱胶缺陷，并自动生成预警与检修建议。这一案例表明，安防AI技术正从传统安全防范向工业设备运维等细分场景延伸，推动预测性维护落地。",[132],{"_72":102,"_21":103,"_75":104,"_77":105,"_79":106,"_81":107,"_83":108,"_85":109,"_87":88,"_89":90,"_91":-5,"_92":110,"_94":88},"安讯士发布AXIS D2124-VE雷达，支持360°覆盖、AI目标分类与雷达图像稳定，可全天候探测200米目标，人体识别面积达40,000平方米，平均功耗14.8瓦。该雷达可与AXIS Q6225-LE PTZ摄像机联动，自动进行目标跟踪与复核，为周界防护等场景提供更高效的智能感知方案。这类将雷达探测与视觉确认相结合的联动模式，正成为大范围区域安防的重要技术趋势。",[135],{"_72":112,"_21":113,"_75":114,"_77":115,"_79":116,"_81":117,"_83":118,"_85":119,"_87":88,"_89":90,"_91":-5,"_92":120,"_94":88},{"_72":112,"_21":113,"_75":114,"_77":115,"_79":116,"_81":117,"_83":118,"_85":119,"_87":88,"_89":90,"_91":-5,"_92":120,"_94":88,"_95":121},{"_72":102,"_21":103,"_75":104,"_77":105,"_79":106,"_81":107,"_83":108,"_85":109,"_87":88,"_89":90,"_91":-5,"_92":110,"_94":88,"_95":111},{"_72":97,"_21":98,"_75":99,"_77":78,"_79":100,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":101,"_94":88,"_95":96},"leadParagraph",{"_141":142},"changelogVersion","2026-10-01T08:00"]

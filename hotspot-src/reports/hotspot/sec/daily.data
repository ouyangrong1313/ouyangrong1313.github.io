"storyPublicId","792bbc40-f752-4fbc-acf9-9cc7563605fe","publishedAt","available","label","场景与项目落地",{"_98":99,"_78":-5,"_101":102},"items",[103],{"_75":76,"_30":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":45,"_97":91},{"_75":76,"_30":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":45,"_97":91,"_98":99},"leadParagraph","视美泰AIoT-3568S主板近日应用于电话班牌项目，其超薄尺寸适配10.1至32英寸屏幕，内置1TOPS NPU支持本地人脸识别考勤，并通过丰富接口集成摄像头、读卡器、对讲模块等外设。该方案展示了主板在智慧办公与考勤场景的适配能力。",{"_108":109},"changelogVersion","2026-10-01T08:00"]

"_77":194,"_79":195,"_81":82,"_83":84,"_85":-5},{"_64":183,"_66":184,"_68":185,"_70":-5,"_71":186,"_73":180,"_75":180,"_76":159,"_77":187,"_79":188,"_81":82,"_83":84,"_85":-5},{"_64":176,"_66":177,"_68":178,"_70":-5,"_71":179,"_73":180,"_75":180,"_76":130,"_77":181,"_79":182,"_81":82,"_83":84,"_85":-5},{"_64":170,"_66":171,"_68":172,"_70":-5,"_71":173,"_73":174,"_75":174,"_76":98,"_77":175,"_79":19,"_81":82,"_83":84,"_85":-5},{"_64":164,"_66":165,"_68":166,"_70":-5,"_71":167,"_73":148,"_75":148,"_76":98,"_77":168,"_79":169,"_81":82,"_83":84,"_85":-5},{"_64":155,"_66":156,"_68":157,"_70":-5,"_71":158,"_73":148,"_75":148,"_76":159,"_77":160,"_79":161,"_81":82,"_83":84,"_85":-5},{"_64":143,"_66":144,"_68":145,"_70":146,"_71":147,"_73":148,"_75":148,"_76":149,"_77":150,"_79":151,"_81":133,"_83":84,"_85":-5},{"_64":137,"_66":138,"_68":139,"_70":-5,"_71":140,"_73":141,"_75":141,"_76":98,"_77":142,"_79":122,"_81":82,"_83":84,"_85":-5},{"_64":125,"_66":126,"_68":127,"_70":128,"_71":129,"_73":108,"_75":108,"_76":130,"_77":131,"_79":132,"_81":133,"_83":84,"_85":-5},{"_64":116,"_66":117,"_68":118,"_70":-5,"_71":119,"_73":108,"_75":108,"_76":120,"_77":121,"_79":122,"_81":82,"_83":84,"_85":-5},{"_64":104,"_66":105,"_68":106,"_70":-5,"_71":107,"_73":108,"_75":108,"_76":98,"_77":109,"_79":110,"_81":82,"_83":84,"_85":-5},{"_64":93,"_66":94,"_68":95,"_70":-5,"_71":96,"_73":97,"_75":97,"_76":98,"_77":99,"_79":100,"_81":82,"_83":84,"_85":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":74,"_76":-5,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5},"id","tp6nv5y426ibo5dkpelnluisx","title","安讯士：利用AI和摄像头实现洪水检测与早期预警","summary","安讯士将AI与视频监控摄像头结合，通过实时分析水位变化和传感器数据，实现洪水早期预警。系统整合超声波水位计、流量计和雨量计，提供全天候监测和自动警报。集成天气预报数据后，AI能预测洪水趋势，支持提前疏散和应急部署。","reason","source",{"_91":92},"publishedAt","2026-09-17T07:00:00.000Z","timelineAt","category","tags",[86,87,88,89,90],"score",30,"selected",false,"channel","news","x","观点/分析","视频监控","端侧AI","边缘计算","Axis","name","安讯士 Axis 新闻中心","oiy9vztbr742bqrlv33w6pepv","星火燎原 破局而立 天视通2026秋季发布会圆满收官！","天视通2026秋季发布会圆满收官，主题为“星火燎原 破局而立”。",{"_91":103},"2026-09-17T13:29:00.000Z","industry",[101,102],15,"展会/活动","天视通","CPS中安网企业新闻（分页补源）","oo0ylft54t39kcplq9bv1lol7","大华股份出席2026中建八局建筑科技创新产业大会，签约城市合伙人并展示一站式数智方案","9月16日，大华股份出席2026中建八局建筑科技创新产业大会，国内营销中心常务副总裁覃春红代表公司与多方签署城市合伙人战略合作协议。大会期间，大华集中展示了城市更新、园区大模型（星汉大模型）、“好房子”建设、智慧能源、安消电一体化等场景的一站式数智方案。依托星汉大模型与云边端协同架构，大华推出“数据全融合、状态全可视、事件全可控”的智慧园区大脑，并发布“五位一体”智慧能源方案及城市生命线方案。",{"_91":115},"2026-09-18T00:00:00.000Z",[111,112,113,114],29,"行业动态","大华股份","园区社区","门禁对讲","大华股份新闻中心","pwjb14wsatyff04mj1sz7rfjd","移远通信：端侧AI能力全域赋能，开启AIoT增长新曲线","移远通信完成端侧AI全维度布局，以覆盖1‑2000 TOPS的算力矩阵及端侧大模型、AlgoStore算法超市、AI物联平台形成软硬一体底座，开启AIoT增长新曲线。基于英伟达Jetson Thor的AI算力盒子算力达2070 FP4 TFLOPS，面向工业智能、机器人等高算力场景。方案已在具身智能、车载、智慧零售等多行业落地，缩短客户AI开发周期。",{"_91":124},"technology",[123,88,89],25,"技术进展","物联网智库资讯","z1xgmtt4mk2vqdqcwcnsan09g","同方威视在福州长乐机场T2部署近300台套智慧安检设备","2026年9月16日，福州长乐国际机场T2航站楼正式投运，同方威视近300台套安检设备及智慧安检方案同步上线。方案涵盖手提行李CT、毫米波人体安检门等设备，依托AI实现辅助判图与安检质控，并创新“一机双屏、一次过检”关航联合查验模式，支撑年3600万人次旅客吞吐量。","同方威视在福州长乐机场T2部署近300台套安检设备，涵盖CT与毫米波门，关航联检模式为机场安检效率与安全融合提供实际范例。",{"_91":136},"project",[134,135],54,true,"应用场景","交通","中国安防协会企业动态","nl9w58sjg28cocpu0xxm6gfxg","第十四届中国国际国防电子展盛况启幕 雷科防务携五大板块展品重磅亮相","9月15日，第十四届中国国际国防电子展览会（CIDEX）在北京开幕，雷科防务携五大板块展品亮相。本届展会是国内国防电子领域规模最大、权威性最强的专业盛会。",{"_91":103},"2026-09-18T09:15:00.000Z",[101],"fhofkey37gkbgw9t6nd2n6yc2","HID推出全新Signo Décor读卡器，兼顾门禁安全与设计美学","HID推出全新Signo Décor读卡器，专为注重设计的空间打造，同时不牺牲门禁安全性。产品支持齐平安装，具备IK10防冲击和IP65防护等级，搭载EAL5+安全元件并通过OSDP协议加密通信。基于蓝牙和NFC，用户可使用手机完成开门，现已在欧洲、中国大陆、香港、新加坡和阿联酋开放订购，更多型号将于今年内推出。","Signo Décor读卡器具备IK10/IP65防护与EAL5+安全认证，兼容OSDP协议，文中规格对高端设计项目门禁选型有参考价值。",{"_91":154},"2026-09-20T00:00:00.000Z","product",[152,114,153],58,"产品发布","商用企业级","a&s 安防知识网资讯","um9dtnole86z7jelwxdqil3kn","2026 CCBEC 跨境电商消费类安防选品论坛在深圳举办","2026年9月17日，由法兰克福展览旗下a&s传媒主办的2026 CCBEC跨境电商消费类安防选品论坛在深圳举办。论坛聚焦市场研判、平台选品、AI技术落地与海外合规，嘉宾指出全球消费安防出货量逼近2亿台，2026年上半年国内安防类目出口额达190亿美元，智能喂鸟器等AI视觉产品成为高增长细分赛道。现场还设有爆品推荐专区，展示家用、宠物、户外场景安防产品。",{"_91":154},"opinion",[86,162,163],41,"家用消费级","低功耗/电池","wkbowykgpcucbburqk4vkfk2d","跨境电商消费类安防爆品推荐专区圆满收官：源头厂家选好品，选爆品","由a&s传媒主办、浙江杰峰物联支持的跨境电商消费类安防爆品推荐专区在2026 CCBEC深圳跨境电商展览会圆满收官。该专区聚焦家用、宠物、户外三大场景，集中展示小夜灯婴儿监护器、太阳能摄像机、智能喂食器等热门消费类安防设备。参展商涵盖整机与ODM/OEM厂商，产品标注FCC/CE等认证与上架平台，帮助跨境卖家降低选品试错成本。",{"_91":154},[101,162,87,163],20,"qfqgoc2022rdfifxvvpiqrvgd","智汇视界·智见未来丨上海市智能建筑建设协会音视频分会第七期技术沙龙圆满举行","上海市智能建筑建设协会音视频分会第七期技术沙龙近日圆满举行，由上海狄卫科技有限公司承办。",{"_91":103},"2026-09-20T03:12:00.000Z",[111],"fenousqucl9hxhjnedgef28sr","宝信软件助力湛江海东新区海关“智慧商检”正式上线","湛江海关所属海东新区海关“智慧商检——大宗资源性商品监管（煤炭）项目”近日启动试运行，宝信软件作为承建方完成项目建设并顺利通过审核验收。该项目自2026年1月启动现场联调，已形成“3类智能检测设备+6类AI智能算法模型+1个智能查验监管平台”的一体化解决方案，并已在湛江、舟山、青岛、福州等多地重点口岸落地应用。",{"_91":136},"2026-09-21T00:00:00.000Z",[134],35,"sdibakydt8pqdgjkshv2rkxey","5G专网与物理AI:相互成就的发展进程","物理AI对无线网络确定性、上行能力的要求正驱动5G专网发展。据SNS Telecom & IT报告，2026-2029年垂直行业5G专网投资CAGR约34%，2029年底超66亿美元。NTT DATA与爱立信合作提供5G专网托管服务以支持物理AI部署，但集成复杂度与部署门槛仍是规模化障碍。",{"_91":124},[86,89],46,"lbauc0jgmlxbbsfsd1ct0f6zq","兴业银行董事长一行来访大华股份调研交流","9月21日，兴业银行党委书记、董事长吕家进带队到大华股份总部调研交流。傅利泉介绍大华在AI大模型、机器人及场景数字化方面的积累，期待深化产融结合，赋能银行数字化、智能化转型。吕家进介绍兴业银行“十五五”发展战略，肯定大华研发实力，希望建立长效沟通机制，实现双方优势互补与高质量发展。",{"_91":115},"2026-09-22T00:00:00.000Z",[111,112],27,"v1heh6x35ds7swx5vwvb90imd","大华股份荣获中国（广西）-东盟“人工智能+应急管理”科技创新大赛二等奖","大华股份凭借“基于视频监测大模型的灾害风险识别”项目在中国（广西）-东盟“人工智能+应急管理”科技创新大赛中荣获防灾减灾与应急救援赛道二等奖。该方案通过大模型增强场景理解，灾害识别准确率从65%提升至90%，已在多省实现7×24小时智能巡检，应急管理工作效率提升超90%。",{"_91":115},"2026-09-23T00:00:00.000Z",[111,112,87],"hjjq5rz1gws3it63gts0nge5s","华北工控EMB-3513嵌入式AI主板：加速边缘AI多元化场景落地","华北工控推出EMB-3513嵌入式AI主板，采用NXP i.MX93/91处理器并集成Arm Ethos-U65 NPU，支持ML加速与4K显示。该主板提供双网口、CAN FD、多种USB和COM接口，适配Linux系统，具备0℃~60℃宽温工作能力，适用于工业AI质检、安防监控等边缘AI场景。",{"_91":209},"2026-09-23T06:00:00.000Z",[152,89,88,208,87],"工业/防爆","CPS中安网企业新闻","roxgtm0ac69f4gvn8scliwqh9","华北工控推出BIS-6960I-A12TW-24V工业整机，赋能物流自动分拣系统提质增效","华北工控推出BIS-6960I-A12TW-24V工业整机，搭载Intel 8/9代Core i3-i9处理器，最高64GB内存，支持6个LAN口与PoE可选、CAN和TSN，宽温-20℃～70℃、宽压DC20-48V，适用于物流自动分拣系统。",{"_91":209},"2026-09-23T06:01:00.000Z",[152],37,"qsn7obz84t2ne9x3ybe1cdu9z","从100到1000！国投智能保安机器人量产启动，推出首款AI原生取证产品","国投智能在27周年发布会上宣布保安机器人从100台试点转向1000台量产，并推出首款AI原生取证产品Qiko3.0。保安机器人元系列覆盖园区、校园等场景；Qiko3.0可实现“检材进、报告出”端到端取证。",{"_91":209},"2026-09-23T10:47:00.000Z",[152,153,88],53,"xnltujc8kmzd2o7giqfrnf1o1","三新·智变洞察① | 822个硬核项目！解码AI时代物联网发展新路径","822个物联网“新技术新应用新模式”项目揭示，产业价值重心正从数据采集转向为AI服务的智能闭环，智能传感器、通信、终端与工业智能体四大方向成主赛道。申报主体中500强及上市公司项目104项，独角兽、单项冠军与专精特新企业85项，产业生态含金量飙升。无源物联网将仓库盘点时间从两天压缩至半小时，工业智能体将衍生车型导入周期从14天压至2天，物联网正加速从“连得上”迈向“用得好、能闭环”。",{"_91":124},"2026-09-24T00:00:00.000Z",[86,88,89],34,"vcy85j8r8v0sweu02g2iwt7ik","守储能安全底线，促标准落地生根 ——2026第三届储能安全大会于宜昌顺利落幕","2026第三届储能安全大会于9月23日在宜昌落幕，近600名代表聚焦电化学储能安全标准GB/T 51048-2025落地与海外市场合规。大会期间，及安盾消防与中国检验认证集团、SGS等机构达成战略合作，完善全球属地化技术服务与质量检测体系。与会代表实地参观及安盾消防科技园，了解其产品预制车间、CNAS认证实验室等全链条硬实力。",{"_91":209},"2026-09-24T12:36:00.000Z",[101,238],12,"报警探测","lklzunds2ve5yal53j32cbvsk","非洲数字发展与转型高级研修班到访辰安信息","近日，非洲数字发展与转型高级研修班一行15人到访辰安科技子公司北京辰安信息科技有限公司，就中国公共安全与应急管理应用实践展开交流并探讨合作。辰安科技联合研究院副院长张毛磊介绍了公司参与共建的中国-乌干达自然灾害监测预警“一带一路”联合实验室（已辐射非洲多国）等成果。双方还就数字基建、数字安全等领域后续合作方向进行了初步探讨。",{"_91":246},"2026-09-27T16:00:00.000Z",[111],18,"安防展览网资讯","ez9zjsjvkn1zj3mzg4e161119","睿芯全球首款RISC-V数据流AI芯片高光D35正式量产","9月25日，睿芯旗下全球首款RISC-V数据流AI芯片高光D35正式量产发布。该芯片采用数据流架构和全自研RISC-V CPU内核，最高支持128GB高速显存及Chiplet封装，定位边缘端AI推理。量产同期，睿芯与多家企业签署生态合作，覆盖智慧园区、智慧交通、医疗健康、具身智能等场景。",{"_91":209},"2026-09-28T05:43:00.000Z",[152,88,89],52,"wqjirrlja30i7t3w7xbyk02eb","从监控到战略：安讯士谈主动零售运营的转变","安讯士赞助的IDC白皮书指出，零售业通过将视频、音频、门禁和IoT传感器数据连接至统一平台并加载AI分析，可从被动监控转向主动战略运营。连接智能支持实时防损、客流洞察、货架优化、能效管理和客户体验提升。现有基础设施经开放标准平台集成即可，且可扩展适应业务变化。",{"_91":92},"2026-09-28T06:00:00.000Z",[86,261,90],23,"零售","b2ac9flif1ac08u2xkc0i5h57","大华股份与东华软件达成战略合作 共促产业数智化发展","大华股份与东华软件签署战略合作协议，双方将在产品融合、业务协同及商机联拓方面深化合作。结合大华在AI大模型、物联感知领域的技术积淀与东华软件在行业软件领域的能力，双方将围绕城市治理、企业数智化等重点场景推动软硬件深度融合，助力客户数智化转型。",{"_91":246},"2026-09-28T16:00:00.000Z",[111,87,112],31,"sb8redfcyosm1i81gpn3nr26z","同济大学携手乐聚机器人！智能无人系统联合实验室正式揭牌","9月26日，同济大学与乐聚机器人为智能无人系统联合实验室揭牌，双方合作进入实体化平台阶段。实验室重点布局数字孪生与仿真训练、数据回流与技能进化、自主智能导航三大方向，旨在让人形机器人在工业巡检等场景走通产业化与商业化闭环。",{"_91":246},[111],28,"ohvhb8ggea30mz2735jyniyun","Veepai小鹰维拍发布端侧AI多模态模组系列，最低15元起","Veepai小鹰维拍发布端侧AI多模态模组系列，包含小mini、小黄人板级、枪摇/枪球专用模组，覆盖100万至200万像素，最低15元起，同步开放100万片预售。模组内置端侧AI识别与夜视3D降噪，预制集成Sensor、图像调优与AI算法，可降低厂商开发门槛，适配迷你机、云台机、枪摇机等家用IPC形态。","原文给出了小鹰维拍多款AI模组的价格与适配机型，可帮助设备厂商评估低成本端侧AI的选型与落地路径。",{"_91":209},"2026-09-29T01:48:00.000Z",[152,88,162,163],57,"gxmi6t6vrgvy6ffawn8he8s65","东土科技发布首台全国产化电子架构具身智能机器人","9月28日东土科技在湖北宜昌发布首台搭载全国产化电子架构的具身智能机器人，以鸿道Intewell操作系统、AUTBUS国际标准、MaVIEW工具软件和国产AI处理器芯片整体优化，实现控制与AI计算隔离融合。在国家工业信息安全发展研究中心的关节破坏、网络攻击、病毒植入测试中，该架构机器人通过安全验证，并已在2026年9月联合清华、智元、逐际动力等发起国产化具身智能机器人电子架构联盟。",{"_91":209},"2026-09-29T06:11:00.000Z",[152,208],40,"i313ssh7cwxhl8e8zxu39t57q","海康威视首批通过网络安全标识三星级备案，亮相2026国家网络安全宣传周","海康威视作为首批通过网络安全标识三星级（领先级）备案的企业，在2026国家网络安全宣传周上展示其安全方案。备案依据《消费类网联摄像头安全要求》，本次备案共两款4G球机，是唯一备案4G产品的厂商。海康还介绍了海康御心安全引擎的主动防御能力并宣布连续十年支撑国家信息安全漏洞库。","海康威视首批通过摄像头安全标识最高等级备案，并详述其海康御心引擎架构与十年漏洞治理经验，可帮助关注合规的用户理解该认证要求与落地方法。",{"_91":154},"2026-09-29T11:14:49.652Z","standard",[298,87,299],"检测认证","海康威视","bki266c4nfawo881n4gli9c95","保利物业携手海康威视 以AI大模型打造智慧小区管理新模式","保利物业与海康威视合作，将AI大模型与物联感知技术落地于智慧社区建设。海康威视智能文搜主机实现文本检索监控画面，大模型周界相机24小时监测水池落水，多光谱火灾探测器预警电瓶车电池温度，云眸平台自动核验外卖订单放行。这些应用推动小区管理从被动应对转为主动预见，提升安全与服务品质。",{"_91":154},"2026-09-29T11:14:49.655Z",[134,113,299],24,"c2jqdd84vfsqsut1omjlaymgv","视美泰AIoT-3568S主板赋能电话班牌项目应用案例分享","视美泰AIoT-3568S主板被用于电话班牌项目，其126×90mm超薄尺寸适配10.1-32英寸屏幕，内置1TOPS NPU实现本地人脸识别考勤，丰富的USB、串口及音频接口可集成摄像头、读卡器、对讲模块等外设。该主板兼容Android、Linux、OpenHarmony操作系统，支持双屏异显和有线/WiFi/蓝牙多网络融合，适合校园批量部署与管理。","本文展示了视美泰AIoT-3568S主板在电话班牌项目中的全方面适配方案，涵盖超薄尺寸、多接口、本地AI算力及多系统兼容等关键技术参数，可供智慧校园终端选型参考。",{"_91":317},"2026-09-29T00:00:00.000Z","2026-09-29T15:24:24.414Z",[134,315,88,316],"人脸识别","视美泰","视美泰企业动态","ype0punlbb6x4knfl2rnhpkhv","宁波天合家园×海康威视：二十年老小区，让AI“翻新”了","宁波天合家园联合海康威视，用物联感知设备和AI大模型改造近20年房龄老小区。电梯物联网相机识别电瓶车、液化气罐并阻止关门，AI摄像机盯守消防通道违停，高空抛物相机自动定位楼层，毫米波雷达水位感知球监测涝情，热成像摄像机预警充电车棚温度。小区还部署海康云眸管理外卖员授权进出、文搜超脑支持文字检索录像，并落地居家跌倒雷达、智能电动车充电桩等应用。",{"_91":246},"2026-09-29T16:00:00.000Z","2026-09-30T02:28:26.893Z",[134,113,87,325,326,299],"热成像","行为分析","znnnabn6gwwo4q6ezg909fsm7","华为行业感知首批通过网络安全标识三星级备案，亮相2026网络安全周","华为行业感知首批通过网络安全标识三星级备案，并在2026网络安全周亮相。",{"_91":103},"2026-09-30T05:59:23.280Z",[298,334],50,"华为机器视觉","ty7txhpicx2mzwstwih7e5wel","华北工控基于飞腾腾锐D2000推出100%国产化工控主板MATX-6555GC","华北工控发布MATX-6555GC工控主板，基于飞腾腾锐D2000处理器，实现100%国产化，适配统信UOS服务器操作系统V20和银河操作系统。",{"_91":103},"2026-09-30T05:59:23.298Z",[152],"ngs36mrem1drlbal22aq0nrmu","华北工控SOMB-6581A：支持变配电站智能监测平台的边缘AI计算","华北工控 SOMB-6581A 支持变配电站智能监测平台的边缘AI计算。作为行业专用工控机设备提供商，华北工控深耕智能电网领域，为相关平台应用提供支撑。",{"_91":103},"2026-09-30T05:59:23.308Z",[152,89,153],"f7v6e16o2pv98q7yoyw5szbcg","itc保伦股份安防系统怎么样？从五大核心能力看智慧安防新格局","广东保伦股份有限公司（itc保伦股份）依托三十余年音视频安防技术沉淀，从五大核心能力切入呈现智慧安防新格局。其安防系统覆盖前端、传输、后端、显示全链路，包含70大系列自研软硬件。",{"_91":103},"2026-09-30T05:59:23.324Z",[86],22,"qyfsbh3yfd3px048k87hijiag","RPC-2500P：增强AI性能与丰富接口设计，适配机房动环监控系统应用","RPC-2500P 增强AI性能并丰富接口设计，适配机房动环监控系统应用。AI算力需求激增，直接拉动了AI数据中心等算力基础设施规模化建设落地。",{"_91":103},"2026-09-30T05:59:23.331Z",[152,89],21,"mddkz72398qtwdqllc6wzdmzh","华北工控环境监测专用AIoT计算机SOMB-6581A：为安全应急场景量身打造","华北工控SOMB-6581A环境监测专用AIoT计算机采用瑞芯微RK3588旗舰级AIoT芯片，面向安全应急场景。该产品接口丰富，兼具自主可控与工业级高可靠性。",{"_91":103},"2026-09-30T05:59:23.346Z",[152,89],"wwfp09k7g0408zkafy2x69coo","互学互鉴砺精兵 三晋救援队伍齐聚介休大比武","三晋救援队伍齐聚介休，开展大比武；各队在互学互鉴中砺练救援精兵。",{"_91":103},"2026-09-30T05:59:23.349Z",[111],8,"h44iyj8itrpht348ckgmvwege","上海安防监控系统安装找哪家靠谱？正规安装公司选型经验分享","正规安装公司的选型经验，是上海安防监控系统安装找靠谱公司的参考。",{"_91":103},"2026-09-30T05:59:23.358Z",[86],10,"pesrxwfdb4iprkhvciu9qn3vp","小体积，大能量：华北工控BIS-6670L模块化整机完美适配边缘AI场景","华北工控BIS-6670L模块化整机面向边缘AI场景，AI算力出色，支持DDR5高带宽存储，配备多网口和I/O扩展接口。该整机以小体积实现强大性能，定位稳定可靠。",{"_91":103},"2026-09-30T05:59:23.377Z",[152,89],"nbjv3gaoxnv4r6pi8lq31xmhz","海康威视推出掌静脉识别门禁新品，抬掌即开门","海康威视推出支持掌静脉与人脸识别的门禁新品，识别速度 0.5 秒、误识率千万分之一。产品无需接触设备即可开门，且不受环境干扰。",{"_91":103},"2026-09-30T05:59:23.382Z",[152,114,315,299],48,"all","tag","topic","q","tab","time",{"_401":402},"changelogVersion","2026-10-01T08:00"]

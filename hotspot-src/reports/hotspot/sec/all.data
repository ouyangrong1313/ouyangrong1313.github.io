"_76":77,"_78":207,"_80":113,"_82":102,"_84":85,"_86":-5},{"_64":193,"_66":194,"_68":195,"_70":-5,"_71":196,"_73":197,"_75":197,"_76":77,"_78":198,"_80":199,"_82":83,"_84":85,"_86":-5},{"_64":187,"_66":188,"_68":189,"_70":-5,"_71":190,"_73":191,"_75":191,"_76":77,"_78":192,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":177,"_66":178,"_68":179,"_70":180,"_71":181,"_73":182,"_75":182,"_76":77,"_78":183,"_80":184,"_82":102,"_84":85,"_86":-5},{"_64":167,"_66":168,"_68":169,"_70":-5,"_71":170,"_73":152,"_75":152,"_76":77,"_78":171,"_80":172,"_82":83,"_84":85,"_86":-5},{"_64":158,"_66":159,"_68":160,"_70":-5,"_71":161,"_73":152,"_75":152,"_76":99,"_78":162,"_80":163,"_82":83,"_84":85,"_86":-5},{"_64":147,"_66":148,"_68":149,"_70":150,"_71":151,"_73":152,"_75":152,"_76":153,"_78":154,"_80":155,"_82":102,"_84":85,"_86":-5},{"_64":138,"_66":139,"_68":140,"_70":-5,"_71":141,"_73":142,"_75":142,"_76":143,"_78":144,"_80":145,"_82":83,"_84":85,"_86":-5},{"_64":127,"_66":128,"_68":129,"_70":-5,"_71":130,"_73":131,"_75":131,"_76":77,"_78":132,"_80":133,"_82":83,"_84":85,"_86":-5},{"_64":118,"_66":119,"_68":120,"_70":121,"_71":122,"_73":123,"_75":123,"_76":77,"_78":124,"_80":125,"_82":102,"_84":85,"_86":-5},{"_64":106,"_66":107,"_68":108,"_70":109,"_71":110,"_73":111,"_75":111,"_76":77,"_78":112,"_80":113,"_82":102,"_84":85,"_86":-5},{"_64":93,"_66":94,"_68":95,"_70":96,"_71":97,"_73":98,"_75":98,"_76":99,"_78":100,"_80":101,"_82":102,"_84":85,"_86":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":74,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":-5},"id","wlqnqgi427ibfq5ne2r561fee","title","人脸识别算法落地难？视美泰 AIoT 终端硬件给出端侧完整方案","summary","视美泰借助 AIoT-3568X 通行门禁主板、AIBOX-3576M 和 AIBOX-3588M AI 主机盒等硬件，实现人脸识别算法本地化部署，本地即可完成抓拍、比对和活体检测，断网也可稳定运行。","reason","source",{"_91":92},"publishedAt","2026-09-10T00:00:00.000Z","timelineAt","category","product","tags",[87,88,89,90],"score",20,"selected",false,"channel","news","x","技术进展","端侧AI","人脸识别","视美泰","name","视美泰企业动态","lt3b2jt9fvurdwf1as9syu5m2","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","本文展示了视美泰AIoT-3588A主板在停车场智慧服务屏中的硬件参数和落地项目，对评估同类交互终端的边缘计算方案有参考意义。",{"_91":92},"2026-09-11T00:00:00.000Z","project",[103,88,104,105,89,90],25,true,"应用场景","边缘计算","车牌识别","npg4yqwnewx26hqnbvtqtxdfh","安讯士发布AXIS TQ1823-VE双舱安装柜","安讯士（Axis）发布AXIS TQ1823-VE双舱安装柜，可同时容纳两台Axis设备并集成线缆管理，适用于室内外监控部署。该柜具备防破坏和宽温设计，支持壁挂或杆装，减少安装时间和硬件杂乱，将于2026年11月通过渠道上市。","AXIS TQ1823-VE 双舱安装柜集成双设备安装板与线缆管理，简化室外部署并减少杂乱，适合城市、机场等关键基础设施场景。",{"_91":117},"2026-09-11T08:48:47.000Z",[114,115,116],45,"产品发布","视频监控","Axis","安讯士 Axis 新闻中心","q64nvuajyvy70ujltl57yma8z","安讯士发布AXIS D5210-E和AXIS D5211-E高性能IP供电LED补光灯","安讯士发布AXIS D5210-E和AXIS D5211-E两款IP供电LED补光灯，最远补光距离分别为175米（白光）和200米（红外），支持PoE供电与远程亮度/照射角度调节。内置lux传感器可自动触发补光，PoE out可为其他设备供电；计划2026年第四季度通过安讯士分销渠道上市。","AXIS D5210/D5211-E补光灯提供最远200米补光、PoE供电与远程调节，可直接用于系统集成和低照度监控方案选型。",{"_91":117},"2026-09-11T08:56:09.000Z",[114,126,115,116],58,"低照度","uxpuajb50awusylhdshumd8zw","Lorex Connect 扩展 V 系列产品线，为家庭和企业推出专业级 4K 安防解决方案","Lorex 产品仅限消费与商业用途，不适用于美国联邦政府、联邦资助项目或受 NDAA 约束的承包商。部分产品受 FCC 进口/营销限制，禁止用于公共安全、政府设施安保、关键基础设施物理监控及其他国家安全用途。详见 FCC 通知。",{"_91":137},"2026-09-11T17:24:18.000Z",[114,115,134,135,136],18,"家用消费级","商用企业级","Lorex","Lorex 官方博客","rdt0yg2l2gme55in8ckybhqdo","软银与Sceye完成全球首次HAPS边缘计算技术验证，计划2027年商用","软银与Sceye在日本完成高空平台HAPS边缘计算技术验证，平流层内数据处理平均时延68毫秒，较云端方案降低40%。测试同时实现HAPS对地面手机和无人机的稳定通信。双方计划2027年推动商业化部署。",{"_91":146},"2026-09-13T00:00:00.000Z","technology",[87,104],53,"物联网智库资讯","exw7bw5j6nenzcs2uccm6vyzt","从信息通信业“十五五”规划看物联网发展特点","信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。","本文从连接体系、AI融合和标准化三个维度解读物联网十五五规划要点，可帮助读者把握政策导向与产业演进方向。",{"_91":146},"2026-09-14T00:00:00.000Z","policy",[156,104,157],61,"观点/分析","工信部","og0u5vquobzto7liffnyc25ye","大模型守护杭电，“杭小巡”让校园管理更高效、服务更暖心","杭州电子科技大学联合大华股份，依托大华星汉大模型技术打造“杭小巡”校园安全大模型，实现风险主动发现与事件快速追溯。该系统支持模糊线索检索，十几秒即可定位关键视频片段，并对违规人员再次进入时触发预警。通过整合校园指挥中心、一线安保与安全驿站，“杭小巡”形成从风险发现到服务保障的全流程闭环。",{"_91":166},[103,115,88,164,165],32,"园区社区","大华股份","大华股份新闻中心","srbz4k7gralvnbo79ztmnkqdb","海康威视发布卷轴鹰眼全景拼接摄像机","海康威视发布卷轴鹰眼全景拼接摄像机。产品采用8镜头融光拼接技术，实现140°环视与8K全景成像，细节球机支持4K分辨率和45倍光学变倍。全景采用F1.0大光圈实现低照度全彩，细节球机采用1/1.2英寸超大靶面与光学防抖实现星光Pro级效果；设备集成秒级联动、智能分析（船舶、车辆、人员检测）及AR实景地图平台，适用于城市安防、交通、港口等场景。",{"_91":176},[114,115,126,173,174,175],50,"图像算法","视频结构化","海康威视","a&s 安防知识网资讯","t83703w9v5xds3d6eblh5vnz7","安讯士发布 AXIS M3945-R、P3945-R 和 P3947-R 车载半球摄像机","安讯士发布三款车载半球摄像机 AXIS M3945-R（2 MP，面向巴士）、P3945-R（2 MP）和 P3947-R（5 MP，面向火车/电车），内置麦克风支持音频采集。","三款车载半球摄像机符合 UNECE R10/R118 及 EN 50155 等交通法规，音频和 Lightfinder 2.0 提升现场记录能力，且兼容现有安装接口便于升级。",{"_91":117},"2026-09-14T11:52:23.000Z",[114,185,186,126,116],56,"交通","音频拾取","wmnyamrubjzgg0abrxgxv67mr","Lorex Connect 推出面向家庭与企业的进阶 4K 安防方案：V7 摄像机与 VF 16-Channel NVR","Lorex Connect 推出面向家庭与企业的进阶 4K 安防方案，新品包含 V7 摄像机与 VF 16-Channel NVR。该组合具备先进低照度性能、智能识别与可扩展本地存储能力。",{"_91":137},"2026-09-14T19:13:00.000Z",[114,115,136],"akemy3nmejwsix2zslkeg4go7","熵基科技发布无人值守场景空间解决方案","熵基科技发布无人值守场景空间解决方案，面向运动场馆整合数字身份、智慧通行、AI视觉与云端管理能力，已在厦门、泉州等地投入运营。方案可根据不同场馆（如24小时健身房、预约球馆、游泳馆）的运营要求配置无人化程度，覆盖用户进出、空间感知与运营管理环节。",{"_91":176},"2026-09-15T00:00:00.000Z",[114,200,135],44,"门禁对讲","k0g55fpi9kyhfbducbkdxhydq","拆解视美泰 AIoT-3576EV：面向交互大屏的 RK3576 硬件方案","视美泰在官方动态中拆解了AIoT-3576EV主板，该主板基于瑞芯微RK3576平台（8核CPU+6TOPS NPU），支持4K@120Hz显示、7路USB及工业总线扩展，面向B端整机厂商和集成商，能够本地运行数字人驱动、客流统计等AI业务。","本文对AIoT-3576EV的显示、接口与AI算力定制做了详细拆解，供交互大屏整机选型时评估硬件方案。",{"_91":92},"2026-09-16T00:00:00.000Z",[114,88,135,90],"y0u179kn1yabrwg919vii2gzu","大华股份获多项国内及国际权威网络安全认可","大华股份获评2026年度CNNVD协同软硬件漏洞管理优秀企业，并入选NVDB三大安全漏洞专业库（CNVDB、CAPPVD、CICSVD）技术支撑单位，其中CAPPVD评级由上年度二星级升至三星级。公司同期通过ISO/IEC 29147:2018与ISO/IEC 30111:2019认证，漏洞管理与处置机制的规范性、完整性和有效性获国际权威认可。",{"_91":166},"industry",[214,165],"检测认证","tp6nv5y426ibo5dkpelnluisx","安讯士：利用AI和摄像头实现洪水检测与早期预警","安讯士将AI与视频监控摄像头结合，通过实时分析水位变化和传感器数据，实现洪水早期预警。系统整合超声波水位计、流量计和雨量计，提供全天候监测和自动警报。集成天气预报数据后，AI能预测洪水趋势，支持提前疏散和应急部署。",{"_91":117},"2026-09-17T07:00:00.000Z",[156,115,88,104,116],30,"oo0ylft54t39kcplq9bv1lol7","大华股份出席2026中建八局建筑科技创新产业大会，签约城市合伙人并展示一站式数智方案","9月16日，大华股份出席2026中建八局建筑科技创新产业大会，国内营销中心常务副总裁覃春红代表公司与多方签署城市合伙人战略合作协议。大会期间，大华集中展示了城市更新、园区大模型（星汉大模型）、“好房子”建设、智慧能源、安消电一体化等场景的一站式数智方案。依托星汉大模型与云边端协同架构，大华推出“数据全融合、状态全可视、事件全可控”的智慧园区大脑，并发布“五位一体”智慧能源方案及城市生命线方案。",{"_91":166},"2026-09-18T00:00:00.000Z",[229,165,164,200],29,"行业动态","pwjb14wsatyff04mj1sz7rfjd","移远通信：端侧AI能力全域赋能，开启AIoT增长新曲线","移远通信完成端侧AI全维度布局，以覆盖1‑2000 TOPS的算力矩阵及端侧大模型、AlgoStore算法超市、AI物联平台形成软硬一体底座，开启AIoT增长新曲线。基于英伟达Jetson Thor的AI算力盒子算力达2070 FP4 TFLOPS，面向工业智能、机器人等高算力场景。方案已在具身智能、车载、智慧零售等多行业落地，缩短客户AI开发周期。",{"_91":146},[87,88,104],"z1xgmtt4mk2vqdqcwcnsan09g","同方威视在福州长乐机场T2部署近300台套智慧安检设备","2026年9月16日，福州长乐国际机场T2航站楼正式投运，同方威视近300台套安检设备及智慧安检方案同步上线。方案涵盖手提行李CT、毫米波人体安检门等设备，依托AI实现辅助判图与安检质控，并创新“一机双屏、一次过检”关航联合查验模式，支撑年3600万人次旅客吞吐量。","同方威视在福州长乐机场T2部署近300台套安检设备，涵盖CT与毫米波门，关航联检模式为机场安检效率与安全融合提供实际范例。",{"_91":242},[103,185],54,"中国安防协会企业动态","fhofkey37gkbgw9t6nd2n6yc2","HID推出全新Signo Décor读卡器，兼顾门禁安全与设计美学","HID推出全新Signo Décor读卡器，专为注重设计的空间打造，同时不牺牲门禁安全性。产品支持齐平安装，具备IK10防冲击和IP65防护等级，搭载EAL5+安全元件并通过OSDP协议加密通信。基于蓝牙和NFC，用户可使用手机完成开门，现已在欧洲、中国大陆、香港、新加坡和阿联酋开放订购，更多型号将于今年内推出。","Signo Décor读卡器具备IK10/IP65防护与EAL5+安全认证，兼容OSDP协议，文中规格对高端设计项目门禁选型有参考价值。",{"_91":176},"2026-09-20T00:00:00.000Z",[114,200,135],"um9dtnole86z7jelwxdqil3kn","2026 CCBEC 跨境电商消费类安防选品论坛在深圳举办","2026年9月17日，由法兰克福展览旗下a&s传媒主办的2026 CCBEC跨境电商消费类安防选品论坛在深圳举办。论坛聚焦市场研判、平台选品、AI技术落地与海外合规，嘉宾指出全球消费安防出货量逼近2亿台，2026年上半年国内安防类目出口额达190亿美元，智能喂鸟器等AI视觉产品成为高增长细分赛道。现场还设有爆品推荐专区，展示家用、宠物、户外场景安防产品。",{"_91":176},"opinion",[156,134,257],41,"低功耗/电池","wkbowykgpcucbburqk4vkfk2d","跨境电商消费类安防爆品推荐专区圆满收官：源头厂家选好品，选爆品","由a&s传媒主办、浙江杰峰物联支持的跨境电商消费类安防爆品推荐专区在2026 CCBEC深圳跨境电商展览会圆满收官。该专区聚焦家用、宠物、户外三大场景，集中展示小夜灯婴儿监护器、太阳能摄像机、智能喂食器等热门消费类安防设备。参展商涵盖整机与ODM/OEM厂商，产品标注FCC/CE等认证与上架平台，帮助跨境卖家降低选品试错成本。",{"_91":176},[263,134,115,257],"展会/活动","fenousqucl9hxhjnedgef28sr","宝信软件助力湛江海东新区海关“智慧商检”正式上线","湛江海关所属海东新区海关“智慧商检——大宗资源性商品监管（煤炭）项目”近日启动试运行，宝信软件作为承建方完成项目建设并顺利通过审核验收。该项目自2026年1月启动现场联调，已形成“3类智能检测设备+6类AI智能算法模型+1个智能查验监管平台”的一体化解决方案，并已在湛江、舟山、青岛、福州等多地重点口岸落地应用。",{"_91":242},"2026-09-21T00:00:00.000Z",[103],35,"sdibakydt8pqdgjkshv2rkxey","5G专网与物理AI:相互成就的发展进程","物理AI对无线网络确定性、上行能力的要求正驱动5G专网发展。据SNS Telecom & IT报告，2026-2029年垂直行业5G专网投资CAGR约34%，2029年底超66亿美元。NTT DATA与爱立信合作提供5G专网托管服务以支持物理AI部署，但集成复杂度与部署门槛仍是规模化障碍。",{"_91":146},[156,104],46,"lbauc0jgmlxbbsfsd1ct0f6zq","兴业银行董事长一行来访大华股份调研交流","9月21日，兴业银行党委书记、董事长吕家进带队到大华股份总部调研交流。傅利泉介绍大华在AI大模型、机器人及场景数字化方面的积累，期待深化产融结合，赋能银行数字化、智能化转型。吕家进介绍兴业银行“十五五”发展战略，肯定大华研发实力，希望建立长效沟通机制，实现双方优势互补与高质量发展。",{"_91":166},"2026-09-22T00:00:00.000Z",[229,165],27,"v1heh6x35ds7swx5vwvb90imd","大华股份荣获中国（广西）-东盟“人工智能+应急管理”科技创新大赛二等奖","大华股份凭借“基于视频监测大模型的灾害风险识别”项目在中国（广西）-东盟“人工智能+应急管理”科技创新大赛中荣获防灾减灾与应急救援赛道二等奖。该方案通过大模型增强场景理解，灾害识别准确率从65%提升至90%，已在多省实现7×24小时智能巡检，应急管理工作效率提升超90%。",{"_91":166},"2026-09-23T00:00:00.000Z",[229,165,115],"hjjq5rz1gws3it63gts0nge5s","华北工控EMB-3513嵌入式AI主板：加速边缘AI多元化场景落地","华北工控推出EMB-3513嵌入式AI主板，采用NXP i.MX93/91处理器并集成Arm Ethos-U65 NPU，支持ML加速与4K显示。该主板提供双网口、CAN FD、多种USB和COM接口，适配Linux系统，具备0℃~60℃宽温工作能力，适用于工业AI质检、安防监控等边缘AI场景。",{"_91":297},"2026-09-23T06:00:00.000Z",[114,104,88,296,115],"工业/防爆","CPS中安网企业新闻","roxgtm0ac69f4gvn8scliwqh9","华北工控推出BIS-6960I-A12TW-24V工业整机，赋能物流自动分拣系统提质增效","华北工控推出BIS-6960I-A12TW-24V工业整机，搭载Intel 8/9代Core i3-i9处理器，最高64GB内存，支持6个LAN口与PoE可选、CAN和TSN，宽温-20℃～70℃、宽压DC20-48V，适用于物流自动分拣系统。",{"_91":297},"2026-09-23T06:01:00.000Z",[114],37,"qsn7obz84t2ne9x3ybe1cdu9z","从100到1000！国投智能保安机器人量产启动，推出首款AI原生取证产品","国投智能在27周年发布会上宣布保安机器人从100台试点转向1000台量产，并推出首款AI原生取证产品Qiko3.0。保安机器人元系列覆盖园区、校园等场景；Qiko3.0可实现“检材进、报告出”端到端取证。",{"_91":297},"2026-09-23T10:47:00.000Z",[114,135,88],"xnltujc8kmzd2o7giqfrnf1o1","三新·智变洞察① | 822个硬核项目！解码AI时代物联网发展新路径","822个物联网“新技术新应用新模式”项目揭示，产业价值重心正从数据采集转向为AI服务的智能闭环，智能传感器、通信、终端与工业智能体四大方向成主赛道。申报主体中500强及上市公司项目104项，独角兽、单项冠军与专精特新企业85项，产业生态含金量飙升。无源物联网将仓库盘点时间从两天压缩至半小时，工业智能体将衍生车型导入周期从14天压至2天，物联网正加速从“连得上”迈向“用得好、能闭环”。",{"_91":146},"2026-09-24T00:00:00.000Z",[156,88,104],34,"vcy85j8r8v0sweu02g2iwt7ik","守储能安全底线，促标准落地生根 ——2026第三届储能安全大会于宜昌顺利落幕","2026第三届储能安全大会于9月23日在宜昌落幕，近600名代表聚焦电化学储能安全标准GB/T 51048-2025落地与海外市场合规。大会期间，及安盾消防与中国检验认证集团、SGS等机构达成战略合作，完善全球属地化技术服务与质量检测体系。与会代表实地参观及安盾消防科技园，了解其产品预制车间、CNAS认证实验室等全链条硬实力。",{"_91":297},"2026-09-24T12:36:00.000Z",[263,325],12,"报警探测","lklzunds2ve5yal53j32cbvsk","非洲数字发展与转型高级研修班到访辰安信息","近日，非洲数字发展与转型高级研修班一行15人到访辰安科技子公司北京辰安信息科技有限公司，就中国公共安全与应急管理应用实践展开交流并探讨合作。辰安科技联合研究院副院长张毛磊介绍了公司参与共建的中国-乌干达自然灾害监测预警“一带一路”联合实验室（已辐射非洲多国）等成果。双方还就数字基建、数字安全等领域后续合作方向进行了初步探讨。",{"_91":332},"2026-09-27T16:00:00.000Z",[229],"安防展览网资讯","ez9zjsjvkn1zj3mzg4e161119","睿芯全球首款RISC-V数据流AI芯片高光D35正式量产","9月25日，睿芯旗下全球首款RISC-V数据流AI芯片高光D35正式量产发布。该芯片采用数据流架构和全自研RISC-V CPU内核，最高支持128GB高速显存及Chiplet封装，定位边缘端AI推理。量产同期，睿芯与多家企业签署生态合作，覆盖智慧园区、智慧交通、医疗健康、具身智能等场景。",{"_91":297},"2026-09-28T05:43:00.000Z",[114,88,104],52,"wqjirrlja30i7t3w7xbyk02eb","从监控到战略：安讯士谈主动零售运营的转变","安讯士赞助的IDC白皮书指出，零售业通过将视频、音频、门禁和IoT传感器数据连接至统一平台并加载AI分析，可从被动监控转向主动战略运营。连接智能支持实时防损、客流洞察、货架优化、能效管理和客户体验提升。现有基础设施经开放标准平台集成即可，且可扩展适应业务变化。",{"_91":117},"2026-09-28T06:00:00.000Z",[156,347,116],23,"零售","b2ac9flif1ac08u2xkc0i5h57","大华股份与东华软件达成战略合作 共促产业数智化发展","大华股份与东华软件签署战略合作协议，双方将在产品融合、业务协同及商机联拓方面深化合作。结合大华在AI大模型、物联感知领域的技术积淀与东华软件在行业软件领域的能力，双方将围绕城市治理、企业数智化等重点场景推动软硬件深度融合，助力客户数智化转型。",{"_91":332},"2026-09-28T16:00:00.000Z",[229,115,165],31,"sb8redfcyosm1i81gpn3nr26z","同济大学携手乐聚机器人！智能无人系统联合实验室正式揭牌","9月26日，同济大学与乐聚机器人为智能无人系统联合实验室揭牌，双方合作进入实体化平台阶段。实验室重点布局数字孪生与仿真训练、数据回流与技能进化、自主智能导航三大方向，旨在让人形机器人在工业巡检等场景走通产业化与商业化闭环。",{"_91":332},[229],28,"ohvhb8ggea30mz2735jyniyun","Veepai小鹰维拍发布端侧AI多模态模组系列，最低15元起","Veepai小鹰维拍发布端侧AI多模态模组系列，包含小mini、小黄人板级、枪摇/枪球专用模组，覆盖100万至200万像素，最低15元起，同步开放100万片预售。模组内置端侧AI识别与夜视3D降噪，预制集成Sensor、图像调优与AI算法，可降低厂商开发门槛，适配迷你机、云台机、枪摇机等家用IPC形态。","原文给出了小鹰维拍多款AI模组的价格与适配机型，可帮助设备厂商评估低成本端侧AI的选型与落地路径。",{"_91":297},"2026-09-29T01:48:00.000Z",[114,88,134,257],57,"gxmi6t6vrgvy6ffawn8he8s65","东土科技发布首台全国产化电子架构具身智能机器人","9月28日东土科技在湖北宜昌发布首台搭载全国产化电子架构的具身智能机器人，以鸿道Intewell操作系统、AUTBUS国际标准、MaVIEW工具软件和国产AI处理器芯片整体优化，实现控制与AI计算隔离融合。在国家工业信息安全发展研究中心的关节破坏、网络攻击、病毒植入测试中，该架构机器人通过安全验证，并已在2026年9月联合清华、智元、逐际动力等发起国产化具身智能机器人电子架构联盟。",{"_91":297},"2026-09-29T06:11:00.000Z",[114,296],40,"i313ssh7cwxhl8e8zxu39t57q","海康威视首批通过网络安全标识三星级备案，亮相2026国家网络安全宣传周","海康威视作为首批通过网络安全标识三星级（领先级）备案的企业，在2026国家网络安全宣传周上展示其安全方案。备案依据《消费类网联摄像头安全要求》，本次备案共两款4G球机，是唯一备案4G产品的厂商。海康还介绍了海康御心安全引擎的主动防御能力并宣布连续十年支撑国家信息安全漏洞库。","海康威视首批通过摄像头安全标识最高等级备案，并详述其海康御心引擎架构与十年漏洞治理经验，可帮助关注合规的用户理解该认证要求与落地方法。",{"_91":176},"2026-09-29T11:14:49.652Z","standard",[214,115,175],"bki266c4nfawo881n4gli9c95","保利物业携手海康威视 以AI大模型打造智慧小区管理新模式","保利物业与海康威视合作，将AI大模型与物联感知技术落地于智慧社区建设。海康威视智能文搜主机实现文本检索监控画面，大模型周界相机24小时监测水池落水，多光谱火灾探测器预警电瓶车电池温度，云眸平台自动核验外卖订单放行。这些应用推动小区管理从被动应对转为主动预见，提升安全与服务品质。",{"_91":176},"2026-09-29T11:14:49.655Z",[103,164,175],24,"c2jqdd84vfsqsut1omjlaymgv","视美泰AIoT-3568S主板赋能电话班牌项目应用案例分享","视美泰AIoT-3568S主板被用于电话班牌项目，其126×90mm超薄尺寸适配10.1-32英寸屏幕，内置1TOPS NPU实现本地人脸识别考勤，丰富的USB、串口及音频接口可集成摄像头、读卡器、对讲模块等外设。该主板兼容Android、Linux、OpenHarmony操作系统，支持双屏异显和有线/WiFi/蓝牙多网络融合，适合校园批量部署与管理。","本文展示了视美泰AIoT-3568S主板在电话班牌项目中的全方面适配方案，涵盖超薄尺寸、多接口、本地AI算力及多系统兼容等关键技术参数，可供智慧校园终端选型参考。",{"_91":92},"2026-09-29T00:00:00.000Z","2026-09-29T15:24:24.414Z",[103,89,88,90],"all","tag","topic","q","tab","time",{"_406":407},"changelogVersion","2026-10-01T08:00"]

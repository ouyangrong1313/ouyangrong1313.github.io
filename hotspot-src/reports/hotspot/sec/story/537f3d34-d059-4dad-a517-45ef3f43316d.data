[{"_1":2,"_3":4},"root",{"_5":89},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","537f3d34-d059-4dad-a517-45ef3f43316d","title","非洲高级研修班到访辰安信息","status","watching","reportCount",1,"sourceCount","firstReportAt","2026-09-27T16:00:00.000Z","latestAt","digest","近日，非洲数字发展与转型高级研修班一行15人到访辰安科技子公司北京辰安信息科技有限公司，就中国公共安全与应急管理应用实践展开交流并探讨合作。辰安科技联合研究院副院长张毛磊介绍了公司参与共建的中国-乌干达自然灾害监测预警‘一带一路’联合实验室（已辐射非洲多国）等成果。双方还就数字基建、数字安全等领域后续合作方向进行了初步探讨。目前该事件处于初期交流阶段，尚无后续进展报道。","digestUpdatedAt","2026-09-29T11:19:46.584Z","summary","excerpt","latest","非洲研修班到访辰安信息，双方就合作进行初步探讨。","whyHot",{"_82":83,"_84":83,"_85":83,"_86":87,"_88":-5,"_37":-5},"developments",[76],"officialReports",[],"timeline",[54],"heat",[41,42,43,44],"related",[],{"_45":52,"_37":53,"_48":16},{"_45":50,"_37":51,"_48":16},{"_45":49,"_37":47,"_48":16},{"_45":46,"_37":47,"_48":16},"hour","2026-09-29T15:00:00.000Z",2.6,"participants","2026-09-29T14:00:00.000Z","2026-09-29T13:00:00.000Z",2.7,"2026-09-29T12:00:00.000Z",2.8,{"_55":56,"_11":57,"_25":58,"_59":60,"_61":19,"_62":63,"_64":65,"_66":67},"id","lklzunds2ve5yal53j32cbvsk","非洲数字发展与转型高级研修班到访辰安信息","近日，非洲数字发展与转型高级研修班一行15人到访辰安科技子公司北京辰安信息科技有限公司，就中国公共安全与应急管理应用实践展开交流并探讨合作。辰安科技联合研究院副院长张毛磊介绍了公司参与共建的中国-乌干达自然灾害监测预警“一带一路”联合实验室（已辐射非洲多国）等成果。双方还就数字基建、数字安全等领域后续合作方向进行了初步探讨。","source",{"_55":68,"_69":70,"_71":72,"_73":65,"_74":75},"publishedAt","originalUrl","https://www.afzhan.com/news/detail/111921.html","selected",false,"factId","fu75OlpHbjsE","weblist-afzhan-news","name","安防展览网资讯","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.afzhan.com%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=e7813a1c302ba3e3",{"_66":67,"_11":77,"_78":-5,"_18":19,"_15":16,"_79":80},"非洲研修班到访辰安信息","occurredAt","representative",{"_55":56,"_11":57,"_25":58,"_59":81,"_61":19,"_62":63,"_64":65,"_66":67},{"_55":68,"_69":70,"_71":72,"_
[{"_1":2,"_3":4},"root",{"_5":84},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","e2e8d335-ac7b-4ffd-8ad6-e8547af3771e","title","安讯士提出数据中心安防5层纵深防御策略","status","active","reportCount",1,"sourceCount","firstReportAt","2026-09-30T06:52:52.000Z","latestAt","digest","2026年9月30日，安讯士（Axis）新闻中心发布报道，提出数据中心安防应采用5层纵深防御策略。该策略主张从周界到服务器机架逐层设防，以应对物理入侵、内部威胁、蓄意破坏、人为失误及环境灾害等多样化风险。报道称，各层防御会结合AI视频分析、雷达与PTZ联动、多因素认证和生物识别等技术，使入侵者必须逐层突破。目前该策略为安讯士提出的安防架构建议，尚未披露具体实施案例或落地时间。","digestUpdatedAt","2026-09-30T07:31:05.161Z","summary","excerpt","latest","安讯士发布5层纵深防御策略，涵盖周界至机架逐层防护。","whyHot",{"_79":16,"_80":16,"_81":16,"_82":69,"_83":-5,"_37":-5},"developments",[74],"officialReports",[72],"timeline",[49],"heat",[41,42],"related",[],{"_43":47,"_37":48,"_46":16},{"_43":44,"_37":45,"_46":16},"hour","2026-09-30T09:00:00.000Z",9.4,"participants","2026-09-30T08:00:00.000Z",9.7,{"_50":51,"_11":52,"_25":53,"_54":55,"_56":19,"_57":58,"_59":60,"_61":62},"id","r4e8dl4p154ty071i4imzlgy7","安讯士：数据中心安防的5层纵深防御策略","安讯士（Axis）提出，数据中心安防需采用5层纵深防御策略，从周界到服务器机架逐层设防。该策略针对物理入侵、内部威胁、蓄意破坏、人为失误及环境灾害等多样化风险。各层结合AI视频分析、雷达与PTZ联动、多因素认证和生物识别等技术，使入侵者必须逐层突破。","source",{"_50":63,"_64":65,"_66":67,"_68":69,"_70":71},"publishedAt","originalUrl","https://newsroom.axis.com/blog/data-center-security","selected",false,"factId","fA_iLJhDCqcU","rss-axis-newsroom","name","安讯士 Axis 新闻中心","kind","rss","firstParty",true,"iconUrl","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico",{"_50":51,"_11":52,"_25":53,"_54":73,"_56":19,"_57":58,"_59":60,"_61":62},{"_50":63,"_64":65,"_66":67,"_68":69,"_70":71},{"_61":62,"_11":52,"_75":-5,"_18":19,"_15":16,"_76":77},"occurredAt","representative",{"_50":51,"_11":52,"_25":53,"_54":78,"_56":19,"_57":58,"_59":60,"_61":62},{"_50":63,"_64":65,"_66":67,"_68":69,"_70":71},"participants48h","newParticipants6h","recentReports24h","observationComplete","rank",{"_85":86},"changelogVersion","2026-10-01T08:00"]

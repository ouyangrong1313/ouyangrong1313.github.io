[{"_1":2,"_3":4},"root",{"_5":99},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","792bbc40-f752-4fbc-acf9-9cc7563605fe","title","视美泰AIoT-3568S主板赋能电话班牌项目","status","active","reportCount",1,"sourceCount","firstReportAt","2026-09-29T00:00:00.000Z","latestAt","digest","2026年9月29日，视美泰发布AIoT-3568S主板赋能电话班牌项目的应用案例。该主板采用126×90mm超薄尺寸，适配10.1-32英寸屏幕，内置1TOPS NPU实现本地人脸识别考勤。丰富的USB、串口及音频接口可集成摄像头、读卡器、对讲模块等外设。主板兼容Android、Linux、OpenHarmony操作系统，支持双屏异显和有线/WiFi/蓝牙多网络融合，适合校园批量部署管理。目前该方案已在项目中应用。","digestUpdatedAt","2026-09-29T15:27:12.071Z","summary","excerpt","latest","视美泰发布AIoT-3568S主板在电话班牌中的应用案例，展示其超薄设计与人脸识别等特性。","whyHot",{"_93":16,"_94":95,"_96":16,"_97":75,"_98":-5,"_37":-5},"developments",[88],"officialReports",[86],"timeline",[64],"heat",[41,42,43,44,45,46,47],"related",[],{"_48":62,"_37":63,"_51":16},{"_48":60,"_37":61,"_51":16},{"_48":58,"_37":59,"_51":16},{"_48":56,"_37":57,"_51":16},{"_48":54,"_37":55,"_51":16},{"_48":52,"_37":53,"_51":16},{"_48":49,"_37":50,"_51":16},"hour","2026-09-29T22:00:00.000Z",5.3,"participants","2026-09-29T21:00:00.000Z",5.5,"2026-09-29T20:00:00.000Z",5.6,"2026-09-29T19:00:00.000Z",5.8,"2026-09-29T18:00:00.000Z",5.9,"2026-09-29T17:00:00.000Z",6.1,"2026-09-29T16:00:00.000Z",6.3,{"_65":66,"_11":67,"_25":68,"_69":70,"_71":19,"_72":73,"_74":75,"_76":77},"id","c2jqdd84vfsqsut1omjlaymgv","视美泰AIoT-3568S主板赋能电话班牌项目应用案例分享","视美泰AIoT-3568S主板被用于电话班牌项目，其126×90mm超薄尺寸适配10.1-32英寸屏幕，内置1TOPS NPU实现本地人脸识别考勤，丰富的USB、串口及音频接口可集成摄像头、读卡器、对讲模块等外设。该主板兼容Android、Linux、OpenHarmony操作系统，支持双屏异显和有线/WiFi/蓝牙多网络融合，适合校园批量部署与管理。","source",{"_65":78,"_79":80,"_81":82,"_83":75,"_84":85},"publishedAt","originalUrl","https://www.shimeta.com.cn/newsinfo/9251259.html","selected",true,"factId","fAE10udBE2Oo","weblist-shimeta-news","name","视美泰企业动态","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fnwzimg.we
[{"_1":2,"_3":4},"root",{"_5":95},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","34b83742-71ca-49a9-97e3-f58de9c26136","title","宁波天合家园联合海康威视落地AI安全升级","status","active","reportCount",1,"sourceCount","firstReportAt","2026-09-29T16:00:00.000Z","latestAt","digest","2026年9月30日，安防展览网报道，宁波天合家园联合海康威视，用物联感知设备和AI大模型对近20年房龄的老小区进行安全升级。具体措施包括：电梯物联网相机识别电瓶车、液化气罐并阻止关门；AI摄像机盯守消防通道违停；高空抛物相机自动定位楼层；毫米波雷达水位感知球监测涝情；热成像摄像机预警充电车棚温度。此外，小区部署海康云眸管理外卖员授权进出，文搜超脑支持文字检索录像，并落地居家跌倒雷达、智能电动车充电桩等应用。报道未提及后续进展，目前展示的是已部署的多个AI安全场景。","digestUpdatedAt","2026-09-30T02:30:35.343Z","summary","excerpt","latest","最新报道显示，天合家园已落地电梯阻车、高空抛物定位等多项AI安全应用。","whyHot",{"_88":16,"_89":90,"_91":16,"_92":93,"_94":-5,"_37":-5},"developments",[83],"officialReports",[],"timeline",[61],"heat",[41,42,43,44,45,46],"related",[],{"_47":59,"_37":60,"_50":16},{"_47":57,"_37":58,"_50":16},{"_47":55,"_37":56,"_50":16},{"_47":53,"_37":54,"_50":16},{"_47":51,"_37":52,"_50":16},{"_47":48,"_37":49,"_50":16},"hour","2026-09-30T08:00:00.000Z",6.3,"participants","2026-09-30T07:00:00.000Z",6.5,"2026-09-30T06:00:00.000Z",6.7,"2026-09-30T05:00:00.000Z",6.9,"2026-09-30T04:00:00.000Z",7.1,"2026-09-30T03:00:00.000Z",7.3,{"_62":63,"_11":64,"_25":65,"_66":67,"_68":19,"_69":70,"_71":72,"_73":74},"id","ype0punlbb6x4knfl2rnhpkhv","宁波天合家园×海康威视：二十年老小区，让AI“翻新”了","宁波天合家园联合海康威视，用物联感知设备和AI大模型改造近20年房龄老小区。电梯物联网相机识别电瓶车、液化气罐并阻止关门，AI摄像机盯守消防通道违停，高空抛物相机自动定位楼层，毫米波雷达水位感知球监测涝情，热成像摄像机预警充电车棚温度。小区还部署海康云眸管理外卖员授权进出、文搜超脑支持文字检索录像，并落地居家跌倒雷达、智能电动车充电桩等应用。","source",{"_62":75,"_76":77,"_78":79,"_80":72,"_81":82},"publishedAt","originalUrl","https://www.afzhan.com/news/detail/111949.html","selected",false,"factId","f1t3oasOwpKM","weblist-afzhan-news","name","安防展览网资讯","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico",{"_73":74,"_11":12,"_84":-5,"_18":19,"_15":16,"
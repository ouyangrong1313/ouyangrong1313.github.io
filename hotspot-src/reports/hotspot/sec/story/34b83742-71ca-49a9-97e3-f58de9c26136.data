[{"_1":2,"_3":4},"root",{"_5":92},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","34b83742-71ca-49a9-97e3-f58de9c26136","title","宁波天合家园联合海康威视落地AI安全升级","status","active","reportCount",1,"sourceCount","firstReportAt","2026-09-29T16:00:00.000Z","latestAt","digest","2026年9月30日，安防展览网报道，宁波天合家园联合海康威视，用物联感知设备和AI大模型对近20年房龄的老小区进行安全升级。具体措施包括：电梯物联网相机识别电瓶车、液化气罐并阻止关门；AI摄像机盯守消防通道违停；高空抛物相机自动定位楼层；毫米波雷达水位感知球监测涝情；热成像摄像机预警充电车棚温度。此外，小区部署海康云眸管理外卖员授权进出，文搜超脑支持文字检索录像，并落地居家跌倒雷达、智能电动车充电桩等应用。报道未提及后续进展，目前展示的是已部署的多个AI安全场景。","digestUpdatedAt","2026-09-30T02:30:35.343Z","summary","excerpt","latest","最新报道显示，天合家园已落地电梯阻车、高空抛物定位等多项AI安全应用。","whyHot",{"_85":16,"_86":87,"_88":16,"_89":90,"_91":-5,"_37":-5},"developments",[80],"officialReports",[],"timeline",[58],"heat",[41,42,43,44,45],"related",[],{"_46":56,"_37":57,"_49":16},{"_46":54,"_37":55,"_49":16},{"_46":52,"_37":53,"_49":16},{"_46":50,"_37":51,"_49":16},{"_46":47,"_37":48,"_49":16},"hour","2026-09-30T07:00:00.000Z",6.5,"participants","2026-09-30T06:00:00.000Z",6.7,"2026-09-30T05:00:00.000Z",6.9,"2026-09-30T04:00:00.000Z",7.1,"2026-09-30T03:00:00.000Z",7.3,{"_59":60,"_11":61,"_25":62,"_63":64,"_65":19,"_66":67,"_68":69,"_70":71},"id","ype0punlbb6x4knfl2rnhpkhv","宁波天合家园×海康威视：二十年老小区，让AI“翻新”了","宁波天合家园联合海康威视，用物联感知设备和AI大模型改造近20年房龄老小区。电梯物联网相机识别电瓶车、液化气罐并阻止关门，AI摄像机盯守消防通道违停，高空抛物相机自动定位楼层，毫米波雷达水位感知球监测涝情，热成像摄像机预警充电车棚温度。小区还部署海康云眸管理外卖员授权进出、文搜超脑支持文字检索录像，并落地居家跌倒雷达、智能电动车充电桩等应用。","source",{"_59":72,"_73":74,"_75":76,"_77":69,"_78":79},"publishedAt","originalUrl","https://www.afzhan.com/news/detail/111949.html","selected",false,"factId","f1t3oasOwpKM","weblist-afzhan-news","name","安防展览网资讯","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico",{"_70":71,"_11":12,"_81":-5,"_18":19,"_15":16,"_82":83},"occurredAt","representative",{"_59":60,"_11":61,"_25"
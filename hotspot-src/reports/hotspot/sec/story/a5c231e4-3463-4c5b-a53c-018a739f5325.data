[{"_1":2,"_3":4},"root",{"_5":76},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","a5c231e4-3463-4c5b-a53c-018a739f5325","title","视美泰AI主板实现姿态估计算法边缘端部署","status","active","reportCount",1,"sourceCount","firstReportAt","2026-09-30T00:00:00.000Z","latestAt","digest","2026年9月30日，视美泰发布企业动态，介绍其RK3576、RK3588系列AI终端主板如何支撑姿态估计算法在边缘端商用。该系列主板依靠6TOPS NPU完成本地推理，可输出人体关键点与姿态判断结果，无需将视频流全部上传云端。配套SDK支持模型量化与算子适配，硬件兼容Android、OpenHarmony，可覆盖AI体测、健身魔镜、运动分析和工业行为检测等场景。目前报道仅为企业技术方案介绍，未提及具体商用落地案例或部署规模。","digestUpdatedAt","2026-09-30T06:36:37.838Z","summary","excerpt","latest","视美泰发布动态，介绍其RK3576/RK3588主板以6TOPS NPU实现姿态估计边缘端部署。","whyHot",{"_70":16,"_71":72,"_73":16,"_74":52,"_75":-5,"_37":-5},"developments",[65],"officialReports",[63],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54},"id","w5m99se6midmav2csvvlec7qx","姿态估计算法如何实现边缘端商用？视美泰 RK3576/RK3588 AI 主板实战解析","视美泰介绍其 RK3576、RK3588 系列 AI 终端主板如何支撑姿态估计算法在边缘端商用：依靠 6TOPS NPU 完成本地推理，输出人体关键点与姿态判断结果，无需将视频流全部上传云端。配套 SDK 支持模型量化与算子适配，硬件兼容 Android、OpenHarmony，可覆盖 AI 体测、健身魔镜、运动分析和工业行为检测等场景。","source",{"_42":55,"_56":57,"_58":59,"_60":52,"_61":62},"publishedAt","originalUrl","https://www.shimeta.com.cn/newsinfo/9252709.html","selected",true,"factId","fqEWLrpd2kVI","weblist-shimeta-news","name","视美泰企业动态","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png",{"_42":43,"_11":44,"_25":45,"_46":64,"_48":19,"_49":50,"_51":52,"_53":54},{"_42":55,"_56":57,"_58":59,"_60":52,"_61":62},{"_53":54,"_11":12,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":69,"_48":19,"_49":50,"_51":52,"_53":54},{"_42":55,"_56":57,"_58":59,"_60":52,"_61":62},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete","rank",{"_77":78},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":87},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","a5c231e4-3463-4c5b-a53c-018a739f5325","title","视美泰AI主板实现姿态估计算法边缘端部署","status","active","reportCount",1,"sourceCount","firstReportAt","2026-09-30T00:00:00.000Z","latestAt","digest","2026年9月30日，视美泰发布企业动态，介绍其RK3576、RK3588系列AI终端主板如何支撑姿态估计算法在边缘端商用。该系列主板依靠6TOPS NPU完成本地推理，可输出人体关键点与姿态判断结果，无需将视频流全部上传云端。配套SDK支持模型量化与算子适配，硬件兼容Android、OpenHarmony，可覆盖AI体测、健身魔镜、运动分析和工业行为检测等场景。目前报道仅为企业技术方案介绍，未提及具体商用落地案例或部署规模。","digestUpdatedAt","2026-09-30T06:36:37.838Z","summary","excerpt","latest","视美泰发布动态，介绍其RK3576/RK3588主板以6TOPS NPU实现姿态估计边缘端部署。","whyHot",{"_81":16,"_82":83,"_84":16,"_85":63,"_86":-5,"_37":-5},"developments",[76],"officialReports",[74],"timeline",[52],"heat",[41,42,43],"related",[],{"_44":50,"_37":51,"_47":16},{"_44":48,"_37":49,"_47":16},{"_44":45,"_37":46,"_47":16},"hour","2026-09-30T09:00:00.000Z",7.7,"participants","2026-09-30T08:00:00.000Z",7.9,"2026-09-30T07:00:00.000Z",8.2,{"_53":54,"_11":55,"_25":56,"_57":58,"_59":19,"_60":61,"_62":63,"_64":65},"id","w5m99se6midmav2csvvlec7qx","姿态估计算法如何实现边缘端商用？视美泰 RK3576/RK3588 AI 主板实战解析","视美泰介绍其 RK3576、RK3588 系列 AI 终端主板如何支撑姿态估计算法在边缘端商用：依靠 6TOPS NPU 完成本地推理，输出人体关键点与姿态判断结果，无需将视频流全部上传云端。配套 SDK 支持模型量化与算子适配，硬件兼容 Android、OpenHarmony，可覆盖 AI 体测、健身魔镜、运动分析和工业行为检测等场景。","source",{"_53":66,"_67":68,"_69":70,"_71":63,"_72":73},"publishedAt","originalUrl","https://www.shimeta.com.cn/newsinfo/9252709.html","selected",true,"factId","fqEWLrpd2kVI","weblist-shimeta-news","name","视美泰企业动态","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png",{"_53":54,"_11":55,"_25":56,"_57":75,"_59":19,"_60":61,"_62":63,"_64":65},{"_53":66,"_67":68,"_69":70,"_71":63,"_72":73},{"_64":65,"_11":12,"_77":-5,"_18":19,"_15":16,"_78":79},"occurredAt","representative",{"_53":54,"_11":55
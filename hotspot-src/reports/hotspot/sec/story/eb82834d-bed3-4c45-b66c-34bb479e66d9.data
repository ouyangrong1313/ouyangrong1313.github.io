[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","eb82834d-bed3-4c45-b66c-34bb479e66d9","title","大华股份亮相上海大会，获智慧城市领军企业奖","status","active","reportCount",1,"sourceCount","firstReportAt","2026-09-29T16:00:00.000Z","latestAt","digest","2026年9月30日，大华股份在2026明日城市·上海大会上举办智慧城市峰会，并荣获2026年“世界智慧城市大奖·一带一路地区”企业类别大奖中的领军企业奖项。大华股份表示，目前已在全球70个国家和地区交付900余个智慧城市解决方案。其在墨西哥坎佩切州建设的智能信号控制系统覆盖34个路口、7条绿波走廊，在交通量增长约20%的情况下，车辆等待时间缩短约15%。","digestUpdatedAt","2026-09-30T06:33:40.672Z","summary","excerpt","latest","大华股份获世界智慧城市大奖·一带一路地区领军企业奖，并披露墨西哥项目成效。","whyHot",{"_74":16,"_75":76,"_77":16,"_78":79,"_80":-5,"_37":-5},"developments",[68],"officialReports",[],"timeline",[46],"heat",[41],"related",[],{"_42":43,"_37":44,"_45":16},"hour","2026-09-30T07:00:00.000Z",6.5,"participants",{"_47":48,"_11":49,"_25":50,"_51":52,"_53":19,"_54":55,"_56":57,"_58":59},"id","lkmueonpotnxbvse8450g2g2z","大华股份亮相明日之城·上海大会","大华股份在2026明日城市·上海大会上举办智慧城市峰会，并荣获2026年“世界智慧城市大奖·一带一路地区”企业类别大奖-领军企业。目前，大华已在全球70个国家和地区交付900余个智慧城市解决方案。其在墨西哥坎佩切州建设的智能信号控制系统覆盖34个路口、7条绿波走廊，在交通量增长约20%的情况下，车辆等待时间缩短约15%。","source",{"_47":60,"_61":62,"_63":64,"_65":57,"_66":67},"publishedAt","originalUrl","https://www.afzhan.com/news/detail/111953.html","selected",false,"factId","fuECCAuPf6AA","weblist-afzhan-news","name","安防展览网资讯","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico",{"_58":59,"_11":69,"_70":-5,"_18":19,"_15":16,"_71":72},"大华股份亮相明日之城·上海大会并获智慧城市领军企业奖","occurredAt","representative",{"_47":48,"_11":49,"_25":50,"_51":73,"_53":19,"_54":55,"_56":57,"_58":59},{"_47":60,"_61":62,"_63":64,"_65":57,"_66":67},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_82":83},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":120},"monthly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"report",{"_21":22,"_15":16,"_17":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":19},"index",[13,14],"today","2026-09-30",{"_15":19,"_17":20},{"_15":16,"_17":18},"key","2026-06","title","标准瘦身智能化 企业出海拓市场","2026-08","AI落地加速，边缘计算成焦点","kind","monthly","安防热点 月报 · 2026-06","windowStart","2026-05-31T16:00:00.000Z","windowEnd","2026-06-30T16:00:00.000Z","generatedAt","2026-09-30T07:17:08.132Z","revision",1,"lead",{"_17":18,"_119":35},"overview","本期覆盖2026年6月1日至6月30日。期内，公安部依据《行业标准管理办法》发布公告，废止119项公共安全行业标准，涉及GA 374-2019《电子防盗锁》、GA/T 1093-2013《出入口控制人脸识别系统技术要求》等安防与警用装备标准。此次清理旨在解决标准陈旧、重复问题，为智能化转型释放空间，降低企业合规成本。企业层面，中维世纪迎来二十六年发展节点，依托自研音视频后处理芯片JV9800与普惠AI战略，构建硬件+平台+算法+云服务全栈能力；安联锐视于2026年5月28日至6月4日先后参加越南IEAE电子展和墨西哥EXPO SEGURIDAD，展出免钻孔窗口相机、黑光全彩夜视相机、4K超高清IP摄像机等方案。整体来看，本期安防行业呈现“标准瘦身、企业提质、市场外拓”的转向。","highlights",[116,117,118],"sections",[103,104,105],"stories",[55,56,57],"flashes",[],"cover","metrics",{"_51":52,"_53":52,"_54":52},"readingMinutes",2,"prev","next","totalStories",3,"selectedCount","reportsCovered",{"_58":91,"_17":92,"_61":93,"_63":94,"_65":95,"_67":96,"_69":97,"_87":98,"_70":99,"_72":100,"_74":-5,"_75":101,"_77":71,"_78":102},{"_58":80,"_17":81,"_61":82,"_63":83,"_65":84,"_67":85,"_69":86,"_87":88,"_70":71,"_72":73,"_74":-5,"_75":89,"_77":71,"_78":90},{"_58":59,"_17":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":-5,"_70":71,"_72":73,"_74":-5,"_75":76,"_77":71,"_78":79},"itemId","ksmqcdtlqq2l9gjfdiofnp30e","安联锐视回顾越南IEAE与墨西哥EXPO SEGURIDAD展会，展示免钻孔与低功耗安防方案","summary","安联锐视（Ansjer）于2026年5月28日至6月4日先后参加越南IEAE电子展和墨西哥EXPO SEGURIDAD，展出免钻孔窗口相机、黑光全彩夜视相机、4K超高清IP摄像机。","sourceName","安联锐视 Ansjer 官方博客","sourceUrl","https://www.ansjer.com/ansjer-security-exhibitions-recap/","sourceId","rss-ansjer-blog","sourceIconUrl","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-06-17T01:48:18.000Z","available","label","海外展会拓新局","n4voso60clj9gy3cwko64ddjn","从创业幼苗到行业脊梁——中维世纪二十六年向上生长","中维世纪二十六年从山大路起步成长为全球安防50强，在济南高新区政策支持下自研音视频后处理芯片JV9800，提出普惠AI战略，构建硬件+平台+算法+云服务全栈能力。公司推出AI场景机、双目AOV太阳能电池球机等产品，在农业看护、幼儿园、食品连锁等场景落地，其中食品连锁案例每年节省成本超100万元、销量提升约10%。2024年底，人工智能创新应用产业园全面投产。","中维世纪企业动态","http://www.jovision.com/Company/ViewContent.aspx?id=899&cid=349","weblist-jovision-news","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico","sourceIconSrcSet","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 48w, /reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 96w","2026-06-15T00:00:00.000Z","中维世纪深耕普惠智能","ry6j7cx03143kigl46vytphqm","安防“瘦身”，公安部废止119项公共安全行业标准","公安部发布公告，依据《行业标准管理办法》决定废止119项公共安全行业标准，涉及GA 374-2019《电子防盗锁》、GA/T 1093-2013《出入口控制人脸识别系统技术要求》等多项安防与警用装备标准。本次清理旨在解决标准陈旧、重复问题，为智能化转型释放空间，企业可降低合规成本并推动技术迭代。","CPS中安网智能安防","http://news.cps.com.cn/article/202606/943750.html","weblist-cps-news","/reports/hotspot/sec/avatars/b652901aa45148336630.ico","/reports/hotspot/sec/avatars/b652901aa45148336630.ico 48w, /reports/hotspot/sec/avatars/b652901aa45148336630.ico 96w",false,"媒体","2026-06-23T01:19:00.000Z","标准瘦身释放转型空间",{"_78":102,"_61":113,"_107":114},{"_78":90,"_61":110,"_107":111},{"_78":79,"_61":106,"_107":108},"安联锐视于2026年5月28日至6月4日先后参加越南IEAE电子展和墨西哥EXPO SEGURIDAD，展示免钻孔窗口相机、黑光全彩夜视相机、4K超高清IP摄像机等产品，重点突出免钻孔与低功耗安防方案。本期覆盖两场海外展会时间，显示中国安防企业正通过差异化产品加速拓展海外市场，以创新方案参与全球竞争。","items",[109],{"_58":59,"_17":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":-5,"_70":71,"_72":73,"_74":-5,"_75":76,"_77":71},"中维世纪从创业幼苗成长为全球安防50强，二十六年持续向上。在济南高新区政策支持下，公司自研音视频后处理芯片JV9800，提出普惠AI战略，构建硬件+平台+算法+云服务全栈能力。推出的AI场景机、双目AOV太阳能电池球机等产品，已在农业看护、幼儿园、食品连锁等场景落地，其中食品连锁案例每年节省成本，体现智能化向民生与行业场景深入渗透的趋势。",[112],{"_58":80,"_17":81,"_61":82,"_63":83,"_65":84,"_67":85,"_69":86,"_87":88,"_70":71,"_72":73,"_74":-5,"_75":89,"_77":71},"公安部发布公告，依据《行业标准管理办法》废止119项公共安全行业标准，涉及GA 374-2019《电子防盗锁》、GA/T 1093-2013《出入口控制人脸识别系统技术要求》等多项安防与警用装备标准。本次清理旨在解决标准陈旧、重复问题，为智能化转型释放空间，企业可降低合规成本。这是本期安防行业最重要的政策动态，将对标准体系优化和产业升级产生直接影响。",[115],{"_58":91,"_17":92,"_61":93,"_63":94,"_65":95,"_67":96,"_69":97,"_87":98,"_70":99,"_72":100,"_74":-5,"_75":101,"_77":71},{"_58":91,"_17":92,"_61":93,"_63":94,"_65":95,"_67":96,"_69":97,"_87":98,"_70":99,"_72":100,"_74":-5,"_75":101,"_77":71,"_78":102},{"_58":80,"_17":81,"_61":82,"_63":83,"_65":84,"_67":85,"_69":86,"_87":88,"_70":71,"_72":73,"_74":-5,"_75":89,"_77":71,"_78":90},{"_58":59,"_17":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":-5,"_70":71,"_72":73,"_74":-5,"_75":76,"_77":71,"_78":79},"leadParagraph",{"_121":122},"changelogVersion","2026-10-01T08:00"]

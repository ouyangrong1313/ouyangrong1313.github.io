[{"_1":2,"_3":4},"root",{"_5":128},"monthly-latest",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14},"kind","monthly","report",{"_7":8,"_17":21,"_19":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":18,"_50":-5},"index",[15,16],"today","2026-09-30",{"_17":21,"_19":22},{"_17":18,"_19":20},"key","2026-06","title","标准瘦身智能化 企业出海拓市场","2026-08","AI落地加速，边缘计算成焦点","安防热点 月报 · 2026-08","windowStart","2026-07-31T16:00:00.000Z","windowEnd","2026-08-31T16:00:00.000Z","generatedAt","2026-09-30T07:16:44.474Z","revision",1,"lead",{"_19":22,"_127":35},"overview","本期覆盖2026年8月1日至8月31日。安防行业呈现两大主线：一是AI能力加速从云端走向真实设备和场景，涂鸦智能发布财报显示营收稳步增长，并推出端到端物理AI生成系统Tuya Cobuilder，AI开发者平台注册数超209万；二是边缘计算在细分场景持续深化，中维世纪发布电梯四合一算法场景机，将电动车、煤气罐、困人、遮挡检测集成于一体，视美泰则推出基于瑞芯微RK3576的紧凑型AIoT主板，并携全栈AI方案亮相深圳智慧显示博览会。整体来看，行业正从单一硬件向软硬融合、场景化智能演进，边缘侧算力与算法协同成为落地关键。","highlights",[124,125,126],"sections",[110,111,112],"stories",[56,57,58,59],"flashes",[],"cover","metrics",{"_51":52,"_53":52,"_54":55},"readingMinutes",2,"prev","next","totalStories",4,"selectedCount","reportsCovered",3,{"_60":100,"_19":101,"_63":102,"_65":103,"_67":104,"_69":105,"_71":106,"_73":107,"_75":76,"_77":78,"_79":-5,"_80":108,"_82":76,"_83":109},{"_60":90,"_19":91,"_63":92,"_65":93,"_67":94,"_69":95,"_71":96,"_73":97,"_75":76,"_77":78,"_79":-5,"_80":98,"_82":76,"_83":99},{"_60":85,"_19":86,"_63":87,"_65":66,"_67":88,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":89,"_82":76,"_83":84},{"_60":61,"_19":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":81,"_82":76,"_83":84},"itemId","yohsi83a932qyegd9l99czim4","视美泰携全栈AI方案亮相第八届深圳智慧显示博览会","summary","2026年8月26-28日，视美泰亮相第八届深圳（国际）智慧显示系统产业应用博览会，展出基于瑞芯微等平台的RK3568、RK3576、RK3588系列主板盒子，以及AI大模型双屏翻译机、智能体广告机、多模态语视交互模组等产品，并布局OpenHarmony开源鸿蒙系列与AIBOX-M88边缘计算平台。","sourceName","视美泰企业动态","sourceUrl","https://www.shimeta.com.cn/newsinfo/9212330.html","sourceId","weblist-shimeta-news","sourceIconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png","sourceIconSrcSet","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 48w, /reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-08-27T00:00:00.000Z","available","label","边缘计算与紧凑硬件","whoyby6caxyvkntk5vy9eoy3j","视美泰发布AIoT-3576SE主板：100×80mm尺寸，6TOPS NPU，丰富接口","视美泰发布AIoT-3576SE主板，基于瑞芯微RK3576八核芯片，集成6TOPS NPU，尺寸100×80mm。支持4K输出、MIPI摄像头和语音功能，待机电流低至22mA，适用于智能家居中控、小型网关等紧凑场景。","https://www.shimeta.com.cn/newsinfo/9217068.html","2026-08-31T00:00:00.000Z","dwcwafzuwe8fvzhfq5sns3fic","中维世纪发布电梯四合一算法场景机，集成电动车、煤气罐、困人与遮挡检测","中维世纪发布电梯四合一算法场景机，内置煤气罐检测、电动车检测、困人检测和遮挡检测四种算法。电动车或煤气罐入梯时联动梯控阻止关门；困人检测自动推送物业；遮挡检测触发防御警报并阻止关门。","中维世纪企业动态","http://www.jovision.com/Company/ViewContent.aspx?id=903&cid=349","weblist-jovision-news","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 48w, /reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 96w","2026-08-28T00:00:00.000Z","电梯安全场景化算法","ia14xbm4ye1vesyrnrp2toxfx","涂鸦智能发布2026年Q2及H1财报：推动AI能力在真实设备和实际场景中落地","涂鸦智能发布2026年Q2及H1财报，上半年总营收1.738亿美元，同比增长12.3%；第二季度营收9290万美元，同比增长16.0%，净利润率20.1%。公司持续推进AI能力产品化落地，上线端到端物理AI生成系统Tuya Cobuilder，AI开发者平台注册数超209万。","涂鸦智能新闻","https://www.tuya.com/cn/news-details/Kfw78hyi7htuk","weblist-tuya-news","/reports/hotspot/sec/avatars/bb46cef0a0b0e1a7ddc7.png","/reports/hotspot/sec/avatars/bb46cef0a0b0e1a7ddc7.png 48w, /reports/hotspot/sec/avatars/bb46cef0a0b0e1a7ddc7.png 96w","2026-08-25T01:00:00.000Z","AI能力产品化落地",{"_83":109,"_63":121,"_114":122},{"_83":99,"_63":118,"_114":119},{"_83":84,"_63":113,"_114":115},"视美泰发布AIoT-3576SE主板，基于瑞芯微RK3576八核芯片，集成6TOPS NPU，尺寸仅100×80mm，支持4K输出、MIPI摄像头和语音功能，待机电流低至22mA，适用于智能家居中控、小型网关等紧凑场景。同时，视美泰在深圳智慧显示博览会展示全栈AI方案，涵盖RK3568、RK3576、RK3588系列主板及AI大模型双屏翻译机等，并布局OpenHarmony开源鸿蒙系列，凸显边缘计算硬件的小型化与多样化趋势。","items",[116,117],{"_60":85,"_19":86,"_63":87,"_65":66,"_67":88,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":89,"_82":76},{"_60":61,"_19":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":81,"_82":76},"中维世纪发布电梯四合一算法场景机，集成电动车检测、煤气罐检测、困人检测和遮挡检测四种算法。电动车或煤气罐入梯时联动梯控阻止关门，困人检测自动推送物业，遮挡检测触发防御警报并阻止关门，实现电梯安全的多维防护，体现AI在垂直场景的深度定制。",[120],{"_60":90,"_19":91,"_63":92,"_65":93,"_67":94,"_69":95,"_71":96,"_73":97,"_75":76,"_77":78,"_79":-5,"_80":98,"_82":76},"涂鸦智能发布2026年Q2及H1财报，上半年总营收1.738亿美元，同比增长12.3%，第二季度营收9290万美元，同比增长16.0%，净利润率20.1%。公司持续推进AI能力产品化，上线端到端物理AI生成系统Tuya Cobuilder，AI开发者平台注册数超209万，显示AI正从概念走向实际设备与场景应用。",[123],{"_60":100,"_19":101,"_63":102,"_65":103,"_67":104,"_69":105,"_71":106,"_73":107,"_75":76,"_77":78,"_79":-5,"_80":108,"_82":76},{"_60":100,"_19":101,"_63":102,"_65":103,"_67":104,"_69":105,"_71":106,"_73":107,"_75":76,"_77":78,"_79":-5,"_80":108,"_82":76,"_83":109},{"_60":90,"_19":91,"_63":92,"_65":93,"_67":94,"_69":95,"_71":96,"_73":97,"_75":76,"_77":78,"_79":-5,"_80":98,"_82":76,"_83":99},{"_60":85,"_19":86,"_63":87,"_65":66,"_67":88,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":89,"_82":76,"_83":84},"leadParagraph",{"_129":130},"changelogVersion","2026-10-01T08:00"]

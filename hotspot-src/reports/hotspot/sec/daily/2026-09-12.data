s.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=25a605d17992c2cd 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","2026-09-11T08:48:47.000Z","available","label","产品与方案发布","q64nvuajyvy70ujltl57yma8z","安讯士发布AXIS D5210-E和AXIS D5211-E高性能IP供电LED补光灯","安讯士发布AXIS D5210-E和AXIS D5211-E两款IP供电LED补光灯，最远补光距离分别为175米（白光）和200米（红外），支持PoE供电与远程亮度/照射角度调节。内置lux传感器可自动触发补光，PoE out可为其他设备供电；计划2026年第四季度通过安讯士分销渠道上市。","https://newsroom.axis.com/news/led-illuminators","2026-09-11T08:56:09.000Z",{"_89":90,"_69":-5,"_97":98},"items",[99,100],{"_66":91,"_20":92,"_69":93,"_71":72,"_73":94,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":95,"_88":82},{"_66":67,"_20":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":87,"_88":82},{"_66":91,"_20":92,"_69":93,"_71":72,"_73":94,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":95,"_88":82,"_89":90},{"_66":67,"_20":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":87,"_88":82,"_89":90},"leadParagraph","安讯士发布AXIS D5210-E与AXIS D5211-E高性能LED补光灯，最远补光距离175米（白光）和200米（红外），支持PoE供电及远程调节。同时推出AXIS TQ1823-VE双舱安装柜，可双设备部署，将于2026年11月上市。",{"_106":107},"changelogVersion","2026-10-01T08:00"]

rceIconSrcSet","/reports/hotspot/sec/avatars/b652901aa45148336630.ico 48w, /reports/hotspot/sec/avatars/b652901aa45148336630.ico 96w","firstParty",false,"role","媒体","storyPublicId","publishedAt","2026-06-23T01:19:00.000Z","available",true,"label","标准与检测认证",{"_113":114,"_92":-5,"_116":117},"items",[118],{"_89":90,"_32":91,"_92":93,"_94":95,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":107,"_108":-5,"_109":110,"_111":112},{"_89":90,"_32":91,"_92":93,"_94":95,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":107,"_108":-5,"_109":110,"_111":112,"_113":114},"leadParagraph","公安部今日发布公告，依据《行业标准管理办法》废止119项公共安全行业标准，涉及电子防盗锁、出入口控制人脸识别系统等安防与警用装备标准。此次清理旨在解决标准陈旧、重复问题，推动安防行业标准体系优化升级。",{"_123":124},"changelogVersion","2026-10-01T08:00"]

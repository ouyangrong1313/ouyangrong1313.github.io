51c.ico","sourceIconSrcSet","/reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 48w, /reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","available","label","行业动态",{"_110":111,"_91":-5,"_113":114},"items",[115],{"_88":89,"_32":90,"_91":92,"_93":94,"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":106,"_107":-5,"_108":58,"_109":104},{"_88":89,"_32":90,"_91":92,"_93":94,"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":106,"_107":-5,"_108":58,"_109":104,"_110":111},"leadParagraph","中维世纪从山大路起步二十六年，成长为全球安防50强；在济南高新区政策支持下，自研音视频后处理芯片JV9800，提出普惠AI战略，构建硬件+平台+算法+云服务全栈能力。公司推出AI场景机、双目AOV太阳能电池球机，应用于农业看护、幼儿园、食品链等场景。",{"_120":121},"changelogVersion","2026-10-01T08:00"]

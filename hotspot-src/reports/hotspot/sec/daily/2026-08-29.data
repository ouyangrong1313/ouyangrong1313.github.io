otspot/sec/avatars/2a68c091ecfd3c34851c.ico 48w, /reports/hotspot/sec/avatars/2a68c091ecfd3c34851c.ico 96w","firstParty",true,"role","官方","storyPublicId","publishedAt","available","label","技术方向",{"_112":113,"_93":-5,"_115":116},"items",[117],{"_90":91,"_35":92,"_93":94,"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":106,"_107":108,"_109":-5,"_110":59,"_111":106},{"_90":91,"_35":92,"_93":94,"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":106,"_107":108,"_109":-5,"_110":59,"_111":106,"_112":113},"leadParagraph","中维世纪今日发布电梯四合一算法场景机，内置电动车、煤气罐、困人与遮挡检测四种算法。其中电动车或煤气罐入梯可联动梯控阻止关门，困人检测自动推送物业，遮挡检测触发防御警报并阻止关门。",{"_122":123},"changelogVersion","2026-10-01T08:00"]

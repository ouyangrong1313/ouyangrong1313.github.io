,"_79":-5,"_101":102},"items",[103],{"_76":77,"_25":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":45,"_97":92},{"_76":77,"_25":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":45,"_97":92,"_98":99},"leadParagraph","中维世纪今日发布电梯四合一算法场景机，内置电动车、煤气罐、困人与遮挡检测四种算法。其中电动车或煤气罐入梯可联动梯控阻止关门，困人检测自动推送物业，遮挡检测触发防御警报并阻止关门。",{"_108":109},"changelogVersion","2026-10-01T08:00"]

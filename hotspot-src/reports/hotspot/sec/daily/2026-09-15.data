ico","sourceIconSrcSet","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 48w, /reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 96w","官方","2026-09-14T11:52:23.000Z","产品与方案发布",{"_86":99,"_69":-5,"_102":105},{"_86":87,"_69":-5,"_102":103},"items",[104],{"_66":67,"_20":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":79,"_80":81,"_82":-5,"_83":34,"_84":85},[106],{"_66":88,"_20":89,"_69":90,"_71":91,"_73":92,"_75":93,"_77":94,"_95":96,"_78":85,"_80":97,"_82":-5,"_83":98,"_84":85},{"_66":67,"_20":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":79,"_80":81,"_82":-5,"_83":34,"_84":85,"_86":87},{"_66":88,"_20":89,"_69":90,"_71":91,"_73":92,"_75":93,"_77":94,"_95":96,"_78":85,"_80":97,"_82":-5,"_83":98,"_84":85,"_86":99},"leadParagraph","信息通信业“十五五”规划明确物联网向5G-A+6G+卫星协同连接、人工智能融合等方向演进，要求移动物联网终端用户突破38亿。安讯士同日发布三款车载半球摄像机，覆盖巴士与火车场景，内置麦克风支持音频采集。",{"_112":113},"changelogVersion","2026-10-01T08:00"]

85.html","sourceId","weblist-csppi-company","sourceIconUrl","firstParty",true,"role","官方","storyPublicId","publishedAt","available","label","场景与项目落地",{"_113":114,"_97":-5,"_116":117},"items",[118],{"_94":95,"_38":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":-5,"_106":107,"_108":109,"_110":-5,"_111":63,"_112":107},{"_94":95,"_38":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":-5,"_106":107,"_108":109,"_110":-5,"_111":63,"_112":107,"_113":114},"leadParagraph","9月16日，福州长乐国际机场T2航站楼正式投运，同方威视近300台安检设备及智慧安检方案同步上线。方案涵盖手提行李CT、毫米波人体安检门等设备，依托AI实现辅助判图与安检质控，并创新“一机双屏、一次过检”关航联合查验模式。",{"_123":124},"changelogVersion","2026-10-01T08:00"]

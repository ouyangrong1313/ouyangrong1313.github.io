[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":37,"_52":37,"_53":-5,"_54":55,"_56":57},"id","s3fh913cyocws3myalmd1l2qb","revision",1,"title","《网络安全标识管理办法》发布，家用摄像头为首批试点，7月施行","originalTitle","定了，家用摄像头新规7月施行","summary","2026年4月10日，国家网信办、工信部、公安部联合印发《网络安全标识管理办法》，7月1日起施行，消费类网联摄像头列为首批试点。办法实行基础级（一星）、增强级（二星）、领先级（三星）分级标识，生产者自愿参与，鼓励消费者优先选用。新规将加速行业洗牌，推动联网安防产品从价格竞争转向安全品质竞争。","reason","文章详细解读了网络安全标识管理办法的三级标识体系和试点范围，对消费者选购和厂商合规均有参考价值。","source",{"_9":67,"_68":69,"_70":71,"_72":55,"_73":74,"_75":76},"links",{"_64":65,"_57":66},"publishedAt","2026-04-20T07:58:00.000Z","discoveredAt","2026-09-29T11:14:51.483Z","timelineAt","category","policy","tags",[58,59,60,61,62,63],"score",76,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","政策/监管","视频监控","数据安全","网信办","工信部","公安部","aihot","/items/s3fh913cyocws3myalmd1l2qb","http://news.cps.com.cn/article/202604/943667.html","weblist-cps-news","name","CPS中安网智能安防","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=f7f19640bbb4a67e","iconSrcSet","/api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=e2d7b365812ac90d 48w, /api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=c095dafaa0ca5dc4 96w",{"_78":79},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"id","m2u0141zoyu2aupen1qkkif6p","revision",1,"title","安讯士发布 AXIS D2124-VE 雷达，360° 覆盖与 AI 分类实现全天候区域保护","originalTitle","Powerful radar device delivers reliable area protection with 360° coverage, 24/7","summary","安讯士发布 AXIS D2124-VE 雷达，具备 360° 覆盖、AI 分类和雷达图像稳定，可全天候探测 200 米目标。人体识别面积达 40,000 m²，平均功耗 14.8 W，可与 AXIS Q6225-LE PTZ 摄像机联动实现自动跟踪复核，计划 2026 年第四季度上市。","reason","原文给出了 AXIS D2124-VE 雷达的覆盖面积、功耗和探测距离等关键参数，其与 PTZ 联动复核的设计可供大面积周界方案参考。","source",{"_9":66,"_67":68,"_69":70,"_71":37,"_72":73,"_74":75},"links",{"_63":64,"_58":65},"publishedAt","2026-09-01T12:46:38.000Z","discoveredAt","2026-09-29T13:15:43.124Z","timelineAt","category","product","tags",[59,60,61,62],"score",57,"selected",true,"channel","news","story","x","readingMode","full","author","emeliesl","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","产品发布","毫米波雷达","周界防范","Axis","aihot","/items/m2u0141zoyu2aupen1qkkif6p","https://newsroom.axis.com/news/radar-device-area-protection","rss-axis-newsroom","name","安讯士 Axis 新闻中心","kind","rss","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=df89d96899bf174f","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=6f4aac1922d54813 48w, /api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=25a605d17992c2cd 96w",{"_77":78},"changelogVersion","2026-10-01T08:00"]

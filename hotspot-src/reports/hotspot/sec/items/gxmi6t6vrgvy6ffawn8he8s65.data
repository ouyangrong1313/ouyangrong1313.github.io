[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":36,"_52":53,"_54":55,"_56":36,"_57":58},"id","gxmi6t6vrgvy6ffawn8he8s65","revision",4,"title","东土科技发布首台全国产化电子架构具身智能机器人","originalTitle","首台国产化电子架构具身机器人正式发布 为物理AI装上国产“神经”","summary","9月28日东土科技在湖北宜昌发布首台搭载全国产化电子架构的具身智能机器人，以鸿道Intewell操作系统、AUTBUS国际标准、MaVIEW工具软件和国产AI处理器芯片整体优化，实现控制与AI计算隔离融合。在国家工业信息安全发展研究中心的关节破坏、网络攻击、病毒植入测试中，该架构机器人通过安全验证，并已在2026年9月联合清华、智元、逐际动力等发起国产化具身智能机器人电子架构联盟。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":36,"_82":83,"_84":85},"links",{"_73":74,"_58":75},"publishedAt","2026-09-29T06:11:00.000Z","discoveredAt","2026-09-29T11:14:51.471Z","timelineAt","category","technology","tags",[71,72],"score",40,"selected",false,"channel","news","story",{"_67":68,"_13":69},"x","readingMode","full","author","language","body","outline",[],"relatedStories",[70],"indexable","markdownAvailable",true,"group",{"_59":60,"_39":61,"_62":63,"_64":65,"_66":65},"hasTranslation","bodyLanguage","original","factId","fRpPQBi9eiW4",{"_67":68,"_13":69},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","f33f1335-5705-4866-a866-9c3cf970710b","东土科技发布首台全国产化电子架构具身机器人",{"_67":68,"_13":69},"产品发布","工业/防爆","aihot","/items/gxmi6t6vrgvy6ffawn8he8s65","http://companynews.cps.com.cn/article/202609/943917.html","weblist-cps-company","name","CPS中安网企业新闻","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico","iconSrcSet","/reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico 48w, /reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico 96w",{"_87":88},"changelogVersion","2026-10-01T08:00"]

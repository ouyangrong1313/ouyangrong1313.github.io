[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"id","q64nvuajyvy70ujltl57yma8z","revision",2,"title","安讯士发布AXIS D5210-E和AXIS D5211-E高性能IP供电LED补光灯","originalTitle","High-performance, IP-powered LED illuminators expand camera capabilities","summary","安讯士发布AXIS D5210-E和AXIS D5211-E两款IP供电LED补光灯，最远补光距离分别为175米（白光）和200米（红外），支持PoE供电与远程亮度/照射角度调节。内置lux传感器可自动触发补光，PoE out可为其他设备供电；计划2026年第四季度通过安讯士分销渠道上市。","reason","AXIS D5210/D5211-E补光灯提供最远200米补光、PoE供电与远程调节，可直接用于系统集成和低照度监控方案选型。","source",{"_9":66,"_67":68,"_69":70,"_71":37,"_72":73,"_74":75},"links",{"_63":64,"_58":65},"publishedAt","2026-09-11T08:56:09.000Z","discoveredAt","2026-09-29T11:14:49.869Z","timelineAt","category","product","tags",[59,60,61,62],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","emeliesl","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","产品发布","低照度","视频监控","Axis","aihot","/items/q64nvuajyvy70ujltl57yma8z","https://newsroom.axis.com/news/led-illuminators","rss-axis-newsroom","name","安讯士 Axis 新闻中心","kind","rss","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=df89d96899bf174f","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=6f4aac1922d54813 48w, /api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=25a605d17992c2cd 96w",{"_77":78},"changelogVersion","2026-10-01T08:00"]

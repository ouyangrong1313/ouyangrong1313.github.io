[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":36,"_51":36,"_52":-5,"_53":54,"_55":56},"id","exw7bw5j6nenzcs2uccm6vyzt","revision",3,"title","从信息通信业“十五五”规划看物联网发展特点","originalTitle","summary","信息通信业“十五五”规划明确物联网向“5G-A+6G+卫星”协同连接、人工智能融合以及补齐标准数据安全短板三大方向演进，要求移动物联网终端用户突破38亿，到2030年全面建成新一代通信网。","reason","本文从连接体系、AI融合和标准化三个维度解读物联网十五五规划要点，可帮助读者把握政策导向与产业演进方向。","source",{"_9":63,"_64":65,"_66":67,"_68":54,"_69":-5},"links",{"_60":61,"_56":62},"publishedAt","2026-09-14T00:00:00.000Z","discoveredAt","2026-09-29T11:14:51.871Z","timelineAt","category","policy","tags",[57,58,59],"score",61,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","观点/分析","边缘计算","工信部","aihot","/items/exw7bw5j6nenzcs2uccm6vyzt","https://www.iot101.com/news/10680.html","weblist-iot101-news","name","物联网智库资讯","kind","web_list","firstParty","iconUrl",{"_71":72},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","y0u179kn1yabrwg919vii2gzu","revision",2,"title","大华股份获多项国内及国际权威网络安全认可","originalTitle","summary","大华股份获评2026年度CNNVD协同软硬件漏洞管理优秀企业，并入选NVDB三大安全漏洞专业库（CNVDB、CAPPVD、CICSVD）技术支撑单位，其中CAPPVD评级由上年度二星级升至三星级。公司同期通过ISO/IEC 29147:2018与ISO/IEC 30111:2019认证，漏洞管理与处置机制的规范性、完整性和有效性获国际权威认可。","reason","source",{"_9":61,"_62":63,"_64":65,"_66":51,"_67":68,"_69":70},"links",{"_58":59,"_55":60},"publishedAt","2026-09-16T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.721Z","timelineAt","category","industry","tags",[56,57],"score",32,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","检测认证","大华股份","aihot","/items/y0u179kn1yabrwg919vii2gzu","https://www.dahuatech.com/news/info/1249.html?page=1","weblist-dahua-news","name","大华股份新闻中心","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico","iconSrcSet","/reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico 48w, /reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico 96w",{"_72":73},"changelogVersion","2026-10-01T08:00"]

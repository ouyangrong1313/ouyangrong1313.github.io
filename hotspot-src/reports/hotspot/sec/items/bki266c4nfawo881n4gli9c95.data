[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":-5,"_24":25,"_26":25,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":-5,"_38":-5,"_39":40,"_41":-5,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":34,"_49":50,"_51":-5,"_52":34,"_53":54},"id","bki266c4nfawo881n4gli9c95","revision",2,"title","保利物业携手海康威视 以AI大模型打造智慧小区管理新模式","originalTitle","summary","保利物业与海康威视合作，将AI大模型与物联感知技术落地于智慧社区建设。海康威视智能文搜主机实现文本检索监控画面，大模型周界相机24小时监测水池落水，多光谱火灾探测器预警电瓶车电池温度，云眸平台自动核验外卖订单放行。这些应用推动小区管理从被动应对转为主动预见，提升安全与服务品质。","reason","source",{"_9":61,"_62":63,"_64":65,"_66":34,"_67":-5},"links",{"_58":59,"_54":60},"publishedAt","discoveredAt","2026-09-29T11:14:49.655Z","timelineAt","category","project","tags",[55,56,57],"score",24,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","应用场景","园区社区","海康威视","aihot","/items/bki266c4nfawo881n4gli9c95","https://www.asmag.com.cn/news/202609/115339.html","weblist-asmag-news","name","a&s 安防知识网资讯","kind","web_list","firstParty","iconUrl",{"_69":70},"changelogVersion","2026-10-01T08:00"]

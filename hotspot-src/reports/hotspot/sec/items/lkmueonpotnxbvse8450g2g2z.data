[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":35,"_51":52,"_53":54,"_55":35,"_56":57},"id","lkmueonpotnxbvse8450g2g2z","revision",2,"title","大华股份亮相明日之城·上海大会","originalTitle","summary","大华股份在2026明日城市·上海大会上举办智慧城市峰会，并荣获2026年“世界智慧城市大奖·一带一路地区”企业类别大奖-领军企业。目前，大华已在全球70个国家和地区交付900余个智慧城市解决方案。其在墨西哥坎佩切州建设的智能信号控制系统覆盖34个路口、7条绿波走廊，在交通量增长约20%的情况下，车辆等待时间缩短约15%。","reason","source",{"_9":75,"_76":77,"_78":79,"_80":35,"_81":82,"_83":84},"links",{"_72":73,"_57":74},"publishedAt","2026-09-29T16:00:00.000Z","discoveredAt","2026-09-30T06:31:30.344Z","timelineAt","category","industry","tags",[70,71],"score",25,"selected",false,"channel","news","story",{"_66":67,"_13":68},"x","readingMode","full","author","language","body","outline",[],"relatedStories",[69],"indexable","markdownAvailable",true,"group",{"_58":59,"_38":60,"_61":62,"_63":64,"_65":64},"hasTranslation","bodyLanguage","original","factId","fuECCAuPf6AA",{"_66":67,"_13":68},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","eb82834d-bed3-4c45-b66c-34bb479e66d9","大华股份亮相上海大会，获智慧城市领军企业奖",{"_66":67,"_13":68},"行业动态","大华股份","aihot","/items/lkmueonpotnxbvse8450g2g2z","https://www.afzhan.com/news/detail/111953.html","weblist-afzhan-news","name","安防展览网资讯","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico","iconSrcSet","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico 48w, /reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico 96w",{"_86":87},"changelogVersion","2026-10-01T08:00"]

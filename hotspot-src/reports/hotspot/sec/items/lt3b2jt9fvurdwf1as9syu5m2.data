[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":37,"_52":37,"_53":-5,"_54":55,"_56":57},"id","lt3b2jt9fvurdwf1as9syu5m2","revision",1,"title","视美泰AIoT-3588A主板用于停车场智慧服务屏，实现人脸断点导航与VR反向寻车","originalTitle","视美泰AIoT-3588A主板赋能停车场智慧服务屏，打造全场景智能停车新体验","summary","视美泰AIoT-3588A主板已在北京、上海等地停车场智慧服务屏项目落地，支持人脸断点导航、VR反向寻车、车位引导、车流监控、异常告警等功能。该主板搭载RK3588八核处理器和6TOPS NPU，可在本地完成人脸检测与车牌识别推理，支持HDMI 8K输出、丰富接口及工业级稳定性，无需依赖云端。","reason","本文展示了视美泰AIoT-3588A主板在停车场智慧服务屏中的硬件参数和落地项目，对评估同类交互终端的边缘计算方案有参考意义。","source",{"_9":67,"_68":69,"_70":71,"_72":37,"_73":74,"_75":76},"links",{"_64":65,"_57":66},"publishedAt","2026-09-11T00:00:00.000Z","discoveredAt","2026-09-29T15:24:24.420Z","timelineAt","category","project","tags",[58,59,60,61,62,63],"score",25,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","应用场景","端侧AI","边缘计算","车牌识别","人脸识别","视美泰","aihot","/items/lt3b2jt9fvurdwf1as9syu5m2","https://www.shimeta.com.cn/newsinfo/9230551.html","weblist-shimeta-news","name","视美泰企业动态","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fnwzimg.wezhan.cn%2Fsitefiles10337%2F10337587%2F%25E6%25B5%258F%25E8%25A7%2588%25E5%2599%25A8.png&mode=avatar&exp=1790899200&sig=2f6e9cbf83192a7e","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fnwzimg.wezhan.cn%2Fsitefiles10337%2F10337587%2F%25E6%25B5%258F%25E8%25A7%2588%25E5%2599%25A8.png&mode=avatar-48&exp=1790899200&sig=a4fe2617166af71f 48w, /api/img-proxy?u=https%3A%2F%2Fnwzimg.wezhan.cn%2Fsitefiles10337%2F10337587%2F%25E6%25B5%258F%25E8%25A7%2588%25E5%2599%25A8.png&mode=avatar-96&exp=1790899200&sig=0a8033c31bdbbd6d 96w",{"_78":79},"changelogVersion",
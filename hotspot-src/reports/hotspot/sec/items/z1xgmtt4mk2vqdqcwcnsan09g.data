[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":37,"_52":37,"_53":-5,"_54":55,"_56":57},"id","z1xgmtt4mk2vqdqcwcnsan09g","revision",2,"title","同方威视在福州长乐机场T2部署近300台套智慧安检设备","originalTitle","AI+CT +关航联检！同方赋能福州长乐机场T2智能化安检","summary","2026年9月16日，福州长乐国际机场T2航站楼正式投运，同方威视近300台套安检设备及智慧安检方案同步上线。方案涵盖手提行李CT、毫米波人体安检门等设备，依托AI实现辅助判图与安检质控，并创新“一机双屏、一次过检”关航联合查验模式，支撑年3600万人次旅客吞吐量。","reason","同方威视在福州长乐机场T2部署近300台套安检设备，涵盖CT与毫米波门，关航联检模式为机场安检效率与安全融合提供实际范例。","source",{"_9":63,"_64":65,"_66":67,"_68":37,"_69":-5},"links",{"_60":61,"_57":62},"publishedAt","2026-09-18T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.662Z","timelineAt","category","project","tags",[58,59],"score",54,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","应用场景","交通","aihot","/items/z1xgmtt4mk2vqdqcwcnsan09g","https://xh.21csp.com.cn/c62/202609/11430785.html","weblist-csppi-company","name","中国安防协会企业动态","kind","web_list","firstParty","iconUrl",{"_71":72},"changelogVersion","2026-10-01T08:00"]

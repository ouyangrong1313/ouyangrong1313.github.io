[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","fenousqucl9hxhjnedgef28sr","revision",1,"title","宝信软件助力湛江海东新区海关“智慧商检”正式上线","originalTitle","summary","湛江海关所属海东新区海关“智慧商检——大宗资源性商品监管（煤炭）项目”近日启动试运行，宝信软件作为承建方完成项目建设并顺利通过审核验收。该项目自2026年1月启动现场联调，已形成“3类智能检测设备+6类AI智能算法模型+1个智能查验监管平台”的一体化解决方案，并已在湛江、舟山、青岛、福州等多地重点口岸落地应用。","reason","source",{"_9":60,"_61":62,"_63":64,"_65":51,"_66":-5},"links",{"_57":58,"_55":59},"publishedAt","2026-09-21T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.632Z","timelineAt","category","project","tags",[56],"score",35,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","应用场景","aihot","/items/fenousqucl9hxhjnedgef28sr","https://xh.21csp.com.cn/c62/202609/11430816.html","weblist-csppi-company","name","中国安防协会企业动态","kind","web_list","firstParty","iconUrl",{"_68":69},"changelogVersion","2026-10-01T08:00"]

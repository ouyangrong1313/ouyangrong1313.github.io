[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":35,"_51":52,"_53":54,"_55":35,"_56":57},"id","lklzunds2ve5yal53j32cbvsk","revision",2,"title","非洲数字发展与转型高级研修班到访辰安信息","originalTitle","summary","近日，非洲数字发展与转型高级研修班一行15人到访辰安科技子公司北京辰安信息科技有限公司，就中国公共安全与应急管理应用实践展开交流并探讨合作。辰安科技联合研究院副院长张毛磊介绍了公司参与共建的中国-乌干达自然灾害监测预警“一带一路”联合实验室（已辐射非洲多国）等成果。双方还就数字基建、数字安全等领域后续合作方向进行了初步探讨。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":35,"_80":81,"_82":83},"links",{"_71":72,"_57":73},"publishedAt","2026-09-27T16:00:00.000Z","discoveredAt","2026-09-29T11:14:51.579Z","timelineAt","category","industry","tags",[70],"score",18,"selected",false,"channel","news","story",{"_66":67,"_13":68},"x","readingMode","full","author","language","body","outline",[],"relatedStories",[69],"indexable","markdownAvailable",true,"group",{"_58":59,"_38":60,"_61":62,"_63":64,"_65":64},"hasTranslation","bodyLanguage","original","factId","fu75OlpHbjsE",{"_66":67,"_13":68},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","537f3d34-d059-4dad-a517-45ef3f43316d","非洲高级研修班到访辰安信息",{"_66":67,"_13":68},"行业动态","aihot","/items/lklzunds2ve5yal53j32cbvsk","https://www.afzhan.com/news/detail/111921.html","weblist-afzhan-news","name","安防展览网资讯","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico","iconSrcSet","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico 48w, /reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico 96w",{"_85":86},"changelogVersion","2026-10-01T08:00"]

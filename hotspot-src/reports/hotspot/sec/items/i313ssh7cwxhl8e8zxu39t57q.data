[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":-5,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":36,"_51":36,"_52":-5,"_53":54,"_55":56},"id","i313ssh7cwxhl8e8zxu39t57q","revision",2,"title","海康威视首批通过网络安全标识三星级备案，亮相2026国家网络安全宣传周","originalTitle","首批通过网络安全标识三星级备案，海康威视亮相2026国家网络安全宣传周","summary","海康威视作为首批通过网络安全标识三星级（领先级）备案的企业，在2026国家网络安全宣传周上展示其安全方案。备案依据《消费类网联摄像头安全要求》，本次备案共两款4G球机，是唯一备案4G产品的厂商。海康还介绍了海康御心安全引擎的主动防御能力并宣布连续十年支撑国家信息安全漏洞库。","reason","海康威视首批通过摄像头安全标识最高等级备案，并详述其海康御心引擎架构与十年漏洞治理经验，可帮助关注合规的用户理解该认证要求与落地方法。","source",{"_9":63,"_64":65,"_66":67,"_68":54,"_69":-5},"links",{"_60":61,"_56":62},"publishedAt","discoveredAt","2026-09-29T11:14:49.652Z","timelineAt","category","standard","tags",[57,58,59],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","检测认证","视频监控","海康威视","aihot","/items/i313ssh7cwxhl8e8zxu39t57q","https://www.asmag.com.cn/news/202609/115342.html","weblist-asmag-news","name","a&s 安防知识网资讯","kind","web_list","firstParty","iconUrl",{"_71":72},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":37,"_52":37,"_53":-5,"_54":55,"_56":57},"id","icmtvh4s7stvt5iunfh3wc2ug","revision",1,"title","大华股份发布基于星汉大模型的风电叶片视觉智能检测方案","originalTitle","大模型上塔，解锁风电叶片AI巡检新方式！","summary","大华股份发布基于星汉大模型与多模态视频理解技术的风电叶片视觉智能检测方案，在风机机舱部署抗振云台实现常态化在线监测。方案在甘肃某风电场运行半年，累计抓拍约15万张叶片画面，检出2台风机3支叶片的早期裂纹和脱胶缺陷，并自动生成预警与检修建议。","reason","大华风电叶片检测方案集成星汉大模型与实际风电场半年运行数据，抓拍15万张画面检出3支缺陷叶片，验证了常态化AI巡检的可行性。","source",{"_9":65,"_66":67,"_68":69,"_70":37,"_71":72,"_73":74},"links",{"_62":63,"_57":64},"publishedAt","2026-09-03T00:00:00.000Z","discoveredAt","2026-09-29T17:17:25.340Z","timelineAt","category","technology","tags",[58,59,60,61],"score",50,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","产品发布","视频监控","图像算法","大华股份","aihot","/items/icmtvh4s7stvt5iunfh3wc2ug","https://www.dahuatech.com/news/info/1245.html?page=1","weblist-dahua-news","name","大华股份新闻中心","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.dahuatech.com%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=7d0cd9d592f1ccad","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fwww.dahuatech.com%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=a4254c25ea02c5d7 48w, /api/img-proxy?u=https%3A%2F%2Fwww.dahuatech.com%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=8141322b9db1118b 96w",{"_76":77},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","lbauc0jgmlxbbsfsd1ct0f6zq","revision",1,"title","兴业银行董事长一行来访大华股份调研交流","originalTitle","summary","9月21日，兴业银行党委书记、董事长吕家进带队到大华股份总部调研交流。傅利泉介绍大华在AI大模型、机器人及场景数字化方面的积累，期待深化产融结合，赋能银行数字化、智能化转型。吕家进介绍兴业银行“十五五”发展战略，肯定大华研发实力，希望建立长效沟通机制，实现双方优势互补与高质量发展。","reason","source",{"_9":61,"_62":63,"_64":65,"_66":51,"_67":68,"_69":70},"links",{"_58":59,"_55":60},"publishedAt","2026-09-22T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.714Z","timelineAt","category","industry","tags",[56,57],"score",27,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","行业动态","大华股份","aihot","/items/lbauc0jgmlxbbsfsd1ct0f6zq","https://www.dahuatech.com/news/info/1253.html?page=1","weblist-dahua-news","name","大华股份新闻中心","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.dahuatech.com%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=7d0cd9d592f1ccad","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fwww.dahuatech.com%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=a4254c25ea02c5d7 48w, /api/img-proxy?u=https%3A%2F%2Fwww.dahuatech.com%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=8141322b9db1118b 96w",{"_72":73},"changelogVersion","2026-10-01T08:00"]

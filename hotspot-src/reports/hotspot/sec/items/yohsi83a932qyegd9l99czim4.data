[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":37,"_52":37,"_53":-5,"_54":55,"_56":57},"id","yohsi83a932qyegd9l99czim4","revision",2,"title","视美泰携全栈AI方案亮相第八届深圳智慧显示博览会","originalTitle","展讯 | AI赋能商显，智领未来！视美泰携全栈AI解决方案亮相第八届深圳（国际）智慧显示系统产业应用博览会","summary","2026年8月26-28日，视美泰亮相第八届深圳（国际）智慧显示系统产业应用博览会，展出基于瑞芯微等平台的RK3568、RK3576、RK3588系列主板盒子，以及AI大模型双屏翻译机、智能体广告机、多模态语视交互模组等产品，并布局OpenHarmony开源鸿蒙系列与AIBOX-M88边缘计算平台。","reason","原文梳理了视美泰从算力基座到鸿蒙生态的全栈产品矩阵，读者可借此了解AI大模型在商显终端的规模化落地路径。","source",{"_9":65,"_66":67,"_68":69,"_70":37,"_71":72,"_73":74},"links",{"_62":63,"_57":64},"publishedAt","2026-08-27T00:00:00.000Z","discoveredAt","2026-09-29T13:23:34.113Z","timelineAt","category","product","tags",[58,59,60,61],"score",26,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","产品发布","商用企业级","端侧AI","视美泰","aihot","/items/yohsi83a932qyegd9l99czim4","https://www.shimeta.com.cn/newsinfo/9212330.html","weblist-shimeta-news","name","视美泰企业动态","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png","iconSrcSet","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 48w, /reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 96w",{"_76":77},"changelogVersion","2026-10-01T08:00"]

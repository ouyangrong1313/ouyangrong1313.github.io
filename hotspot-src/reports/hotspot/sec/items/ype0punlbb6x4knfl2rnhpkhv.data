[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":36,"_52":53,"_54":55,"_56":36,"_57":58},"id","ype0punlbb6x4knfl2rnhpkhv","revision",2,"title","宁波天合家园×海康威视：二十年老小区，让AI“翻新”了","originalTitle","宁波天合家园X海康威视：二十年老小区，让AI“翻新”了","summary","宁波天合家园联合海康威视，用物联感知设备和AI大模型改造近20年房龄老小区。电梯物联网相机识别电瓶车、液化气罐并阻止关门，AI摄像机盯守消防通道违停，高空抛物相机自动定位楼层，毫米波雷达水位感知球监测涝情，热成像摄像机预警充电车棚温度。小区还部署海康云眸管理外卖员授权进出、文搜超脑支持文字检索录像，并落地居家跌倒雷达、智能电动车充电桩等应用。","reason","source",{"_9":80,"_81":82,"_83":84,"_85":36,"_86":87,"_88":89},"links",{"_77":78,"_58":79},"publishedAt","2026-09-29T16:00:00.000Z","discoveredAt","2026-09-30T02:28:26.893Z","timelineAt","category","project","tags",[71,72,73,74,75,76],"score",27,"selected",false,"channel","news","story",{"_67":68,"_13":69},"x","readingMode","full","author","language","body","outline",[],"relatedStories",[70],"indexable","markdownAvailable",true,"group",{"_59":60,"_39":61,"_62":63,"_64":65,"_66":65},"hasTranslation","bodyLanguage","original","factId","f1t3oasOwpKM",{"_67":68,"_13":69},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","34b83742-71ca-49a9-97e3-f58de9c26136","宁波天合家园联合海康威视落地AI安全升级",{"_67":68,"_13":69},"应用场景","园区社区","视频监控","热成像","行为分析","海康威视","aihot","/items/ype0punlbb6x4knfl2rnhpkhv","https://www.afzhan.com/news/detail/111949.html","weblist-afzhan-news","name","安防展览网资讯","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico","iconSrcSet","/reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico 48w, /reports/hotspot/sec/avatars/28909b11a7ea490bb77d.ico 96w",{"_91":92},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":37,"_53":37,"_54":55,"_56":57,"_58":59},"id","w5m99se6midmav2csvvlec7qx","revision",2,"title","姿态估计算法如何实现边缘端商用？视美泰 RK3576/RK3588 AI 主板实战解析","originalTitle","姿态估计算法如何实现边缘端商用？视美泰 AI 主板实战解析","summary","视美泰介绍其 RK3576、RK3588 系列 AI 终端主板如何支撑姿态估计算法在边缘端商用：依靠 6TOPS NPU 完成本地推理，输出人体关键点与姿态判断结果，无需将视频流全部上传云端。配套 SDK 支持模型量化与算子适配，硬件兼容 Android、OpenHarmony，可覆盖 AI 体测、健身魔镜、运动分析和工业行为检测等场景。","reason","原文把姿态估计算法边缘端商用拆成模型量化、算子适配与本地推理几步，适合作为边缘 AI 落地选型的参照。","source",{"_9":80,"_81":82,"_83":84,"_85":37,"_86":87,"_88":89},"links",{"_77":78,"_59":79},"publishedAt","2026-09-30T00:00:00.000Z","discoveredAt","2026-09-30T06:33:30.270Z","timelineAt","category","technology","tags",[72,73,74,75,76],"score",31,"selected",true,"channel","news","story",{"_68":69,"_13":70},"x","readingMode","full","author","language","body","outline",[],"relatedStories",[71],"indexable","markdownAvailable","group",{"_60":61,"_40":62,"_63":64,"_65":66,"_67":66},"hasTranslation",false,"bodyLanguage","original","factId","fqEWLrpd2kVI",{"_68":69,"_13":70},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","a5c231e4-3463-4c5b-a53c-018a739f5325","视美泰AI主板实现姿态估计算法边缘端部署",{"_68":69,"_13":70},"技术进展","端侧AI","边缘计算","行为分析","视美泰","aihot","/items/w5m99se6midmav2csvvlec7qx","https://www.shimeta.com.cn/newsinfo/9252709.html","weblist-shimeta-news","name","视美泰企业动态","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png","iconSrcSet","/reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 48w, /reports/hotspot/sec/avatars/f056dc0cc41ad406646b.png 96w",{"_91":92},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":37,"_52":37,"_53":-5,"_54":55,"_56":57},"id","pxeindylegkwy45253wxfocd3","revision",2,"title","台州公安自研防爆罐机器人亮相，自重50公斤可抵御500克TNT当量","originalTitle","破局排爆痛点 台州公安自研防爆罐机器人亮相","summary","台州公安自主研发的自主移动式防爆罐机器人亮相，自重控制在50公斤内，可抵御500克TNT当量爆炸冲击。机器人搭载履带底盘与3D激光雷达，支持一键路径规划，具备自主导航与远程操作功能。目前已在台州机场、高铁站等核心安保部位部署，累计参与涉爆警情处置及实战演练20余起。2025年台州某商场可疑包裹处置中，机器人凭借自主导航完成无感转移，未大规模疏散人群。","reason","相比自重超200公斤的传统防爆罐，该机器人自重仅50公斤且可抵御500克TNT当量爆炸冲击，搭配一键路径规划与远程控制，使非专业警力也能安全操作，降低了基层排爆作业门槛。","source",{"_9":63,"_64":65,"_66":67,"_68":55,"_69":70,"_71":72},"links",{"_60":61,"_57":62},"publishedAt","2026-03-26T09:11:00.000Z","discoveredAt","2026-09-29T12:15:39.172Z","timelineAt","category","product","tags",[58,59],"score",59,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","应用场景","工业/防爆","aihot","/items/pxeindylegkwy45253wxfocd3","http://news.cps.com.cn/article/202603/943629.html","weblist-cps-news","name","CPS中安网智能安防","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=f7f19640bbb4a67e","iconSrcSet","/api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=e2d7b365812ac90d 48w, /api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=c095dafaa0ca5dc4 96w",{"_74":75},"changelogVersion","2026-10-01T08:00"]

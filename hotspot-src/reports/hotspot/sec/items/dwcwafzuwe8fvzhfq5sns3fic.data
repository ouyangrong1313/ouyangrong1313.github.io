[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":37,"_52":37,"_53":-5,"_54":55,"_56":57},"id","dwcwafzuwe8fvzhfq5sns3fic","revision",2,"title","中维世纪发布电梯四合一算法场景机，集成电动车、煤气罐、困人与遮挡检测","originalTitle","电动车、煤气罐、被困者，电梯里的三大安全隐患如何实现有效监测？","summary","中维世纪发布电梯四合一算法场景机，内置煤气罐检测、电动车检测、困人检测和遮挡检测四种算法。电动车或煤气罐入梯时联动梯控阻止关门；困人检测自动推送物业；遮挡检测触发防御警报并阻止关门。","reason","文中介绍了中维世纪电梯四合一算法的具体检测能力与梯控联动设计，便于了解当前电梯场景的AI检测集成方案。","source",{"_9":65,"_66":67,"_68":69,"_70":37,"_71":72,"_73":74},"links",{"_62":63,"_57":64},"publishedAt","2026-08-28T00:00:00.000Z","discoveredAt","2026-09-29T13:23:34.117Z","timelineAt","category","technology","tags",[58,59,60,61],"score",32,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","产品发布","视频监控","行为分析","中维世纪","aihot","/items/dwcwafzuwe8fvzhfq5sns3fic","http://www.jovision.com/Company/ViewContent.aspx?id=903&cid=349","weblist-jovision-news","name","中维世纪企业动态","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=http%3A%2F%2Fwww.jovision.com%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=3e13699e0d7e01a7","iconSrcSet","/api/img-proxy?u=http%3A%2F%2Fwww.jovision.com%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=40045fd2232a4c92 48w, /api/img-proxy?u=http%3A%2F%2Fwww.jovision.com%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=d513ba1393d42dbb 96w",{"_76":77},"changelogVersion","2026-10-01T08:00"]

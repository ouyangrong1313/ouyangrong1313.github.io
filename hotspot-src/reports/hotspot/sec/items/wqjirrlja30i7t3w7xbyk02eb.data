[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"id","wqjirrlja30i7t3w7xbyk02eb","revision",3,"title","从监控到战略：安讯士谈主动零售运营的转变","originalTitle","From surveillance to strategy: The shift to proactive retail operations","summary","安讯士赞助的IDC白皮书指出，零售业通过将视频、音频、门禁和IoT传感器数据连接至统一平台并加载AI分析，可从被动监控转向主动战略运营。连接智能支持实时防损、客流洞察、货架优化、能效管理和客户体验提升。现有基础设施经开放标准平台集成即可，且可扩展适应业务变化。","reason","source",{"_9":77,"_78":79,"_80":81,"_82":54,"_83":84,"_85":86},"links",{"_74":75,"_59":76},"publishedAt","2026-09-28T06:00:00.000Z","discoveredAt","2026-09-29T11:14:49.857Z","timelineAt","category","opinion","tags",[71,72,73],"score",23,"selected",false,"channel","news","story",{"_68":69,"_13":14},"x","readingMode","full","author","emeliesl","language","body","outline",[],"relatedStories",[70],"indexable","markdownAvailable",true,"group",{"_60":61,"_39":62,"_63":64,"_65":66,"_67":66},"hasTranslation","bodyLanguage","original","factId","f8B5rcNC6izQ",{"_68":69,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","6ddcda14-0a6c-4d27-873a-bfefcefe2612",{"_68":69,"_13":14},"观点/分析","零售","Axis","aihot","/items/wqjirrlja30i7t3w7xbyk02eb","https://newsroom.axis.com/blog/proactive-retail-operations","rss-axis-newsroom","name","安讯士 Axis 新闻中心","kind","rss","firstParty","iconUrl","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=df89d96899bf174f","iconSrcSet","/api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=6f4aac1922d54813 48w, /api/img-proxy?u=https%3A%2F%2Fnewsroom.axis.com%2Fthemes%2Fcustom%2Fnewsroom-v2%2Ffavicon.ico&mode=avatar-96&exp=1790
[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":36,"_51":52,"_53":-5,"_54":36,"_55":56},"id","um9dtnole86z7jelwxdqil3kn","revision",2,"title","2026 CCBEC 跨境电商消费类安防选品论坛在深圳举办","originalTitle","抢抓安防出海新机遇｜2026 CCBEC 跨境电商消费类安防选品论坛在深圳举办","summary","2026年9月17日，由法兰克福展览旗下a&s传媒主办的2026 CCBEC跨境电商消费类安防选品论坛在深圳举办。论坛聚焦市场研判、平台选品、AI技术落地与海外合规，嘉宾指出全球消费安防出货量逼近2亿台，2026年上半年国内安防类目出口额达190亿美元，智能喂鸟器等AI视觉产品成为高增长细分赛道。现场还设有爆品推荐专区，展示家用、宠物、户外场景安防产品。","reason","source",{"_9":63,"_64":65,"_66":67,"_68":36,"_69":-5},"links",{"_60":61,"_56":62},"publishedAt","2026-09-20T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.660Z","timelineAt","category","opinion","tags",[57,58,59],"score",41,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","观点/分析","家用消费级","低功耗/电池","aihot","/items/um9dtnole86z7jelwxdqil3kn","https://www.asmag.com.cn/news/202609/115317.html","weblist-asmag-news","name","a&s 安防知识网资讯","kind","web_list","firstParty","iconUrl",{"_71":72},"changelogVersion","2026-10-01T08:00"]

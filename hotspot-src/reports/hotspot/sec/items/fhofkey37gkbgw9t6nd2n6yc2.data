[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":36,"_51":36,"_52":-5,"_53":54,"_55":56},"id","fhofkey37gkbgw9t6nd2n6yc2","revision",2,"title","HID推出全新Signo Décor读卡器，兼顾门禁安全与设计美学","originalTitle","summary","HID推出全新Signo Décor读卡器，专为注重设计的空间打造，同时不牺牲门禁安全性。产品支持齐平安装，具备IK10防冲击和IP65防护等级，搭载EAL5+安全元件并通过OSDP协议加密通信。基于蓝牙和NFC，用户可使用手机完成开门，现已在欧洲、中国大陆、香港、新加坡和阿联酋开放订购，更多型号将于今年内推出。","reason","Signo Décor读卡器具备IK10/IP65防护与EAL5+安全认证，兼容OSDP协议，文中规格对高端设计项目门禁选型有参考价值。","source",{"_9":63,"_64":65,"_66":67,"_68":54,"_69":-5},"links",{"_60":61,"_56":62},"publishedAt","2026-09-20T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.663Z","timelineAt","category","product","tags",[57,58,59],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","产品发布","门禁对讲","商用企业级","aihot","/items/fhofkey37gkbgw9t6nd2n6yc2","https://www.asmag.com.cn/news/202609/115314.html","weblist-asmag-news","name","a&s 安防知识网资讯","kind","web_list","firstParty","iconUrl",{"_71":72},"changelogVersion","2026-10-01T08:00"]

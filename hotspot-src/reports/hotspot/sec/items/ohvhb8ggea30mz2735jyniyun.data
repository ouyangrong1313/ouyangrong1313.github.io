[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":37,"_53":37,"_54":55,"_56":57,"_58":59},"id","ohvhb8ggea30mz2735jyniyun","revision",3,"title","Veepai小鹰维拍发布端侧AI多模态模组系列，最低15元起","originalTitle","Veepai小鹰维拍端侧AI多模态模组，普惠家用IPC智能化升级","summary","Veepai小鹰维拍发布端侧AI多模态模组系列，包含小mini、小黄人板级、枪摇/枪球专用模组，覆盖100万至200万像素，最低15元起，同步开放100万片预售。模组内置端侧AI识别与夜视3D降噪，预制集成Sensor、图像调优与AI算法，可降低厂商开发门槛，适配迷你机、云台机、枪摇机等家用IPC形态。","reason","原文给出了小鹰维拍多款AI模组的价格与适配机型，可帮助设备厂商评估低成本端侧AI的选型与落地路径。","source",{"_9":79,"_80":81,"_82":83,"_84":57,"_85":86,"_87":88},"links",{"_76":77,"_59":78},"publishedAt","2026-09-29T01:48:00.000Z","discoveredAt","2026-09-29T11:14:51.475Z","timelineAt","category","product","tags",[72,73,74,75],"score",57,"selected",true,"channel","news","story",{"_68":69,"_13":70},"x","readingMode","full","author","language","body","outline",[],"relatedStories",[71],"indexable","markdownAvailable","group",{"_60":61,"_40":62,"_63":64,"_65":66,"_67":66},"hasTranslation",false,"bodyLanguage","original","factId","f83VuuRpB9e8",{"_68":69,"_13":70},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","58a77cb7-f4e9-4e51-bd85-276d5989ac51","Veepai小鹰维拍发布端侧AI多模态模组系列",{"_68":69,"_13":70},"产品发布","端侧AI","家用消费级","低功耗/电池","aihot","/items/ohvhb8ggea30mz2735jyniyun","http://companynews.cps.com.cn/article/202609/943916.html","weblist-cps-company","name","CPS中安网企业新闻","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico","iconSrcSet","/reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico 48w, /reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico 96w",{"_90":91},"changelogVersion","2026-10-01T08:00"]

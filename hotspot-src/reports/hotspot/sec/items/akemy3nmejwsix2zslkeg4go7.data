[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","akemy3nmejwsix2zslkeg4go7","revision",2,"title","熵基科技发布无人值守场景空间解决方案","originalTitle","summary","熵基科技发布无人值守场景空间解决方案，面向运动场馆整合数字身份、智慧通行、AI视觉与云端管理能力，已在厦门、泉州等地投入运营。方案可根据不同场馆（如24小时健身房、预约球馆、游泳馆）的运营要求配置无人化程度，覆盖用户进出、空间感知与运营管理环节。","reason","source",{"_9":62,"_63":64,"_65":66,"_67":35,"_68":-5},"links",{"_59":60,"_55":61},"publishedAt","2026-09-15T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.665Z","timelineAt","category","product","tags",[56,57,58],"score",44,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","产品发布","门禁对讲","商用企业级","aihot","/items/akemy3nmejwsix2zslkeg4go7","https://www.asmag.com.cn/news/202609/115294.html","weblist-asmag-news","name","a&s 安防知识网资讯","kind","web_list","firstParty","iconUrl",{"_70":71},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","og0u5vquobzto7liffnyc25ye","revision",2,"title","大模型守护杭电，“杭小巡”让校园管理更高效、服务更暖心","originalTitle","summary","杭州电子科技大学联合大华股份，依托大华星汉大模型技术打造“杭小巡”校园安全大模型，实现风险主动发现与事件快速追溯。该系统支持模糊线索检索，十几秒即可定位关键视频片段，并对违规人员再次进入时触发预警。通过整合校园指挥中心、一线安保与安全驿站，“杭小巡”形成从风险发现到服务保障的全流程闭环。","reason","source",{"_9":64,"_65":66,"_67":68,"_69":51,"_70":71,"_72":73},"links",{"_61":62,"_55":63},"publishedAt","2026-09-14T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.724Z","timelineAt","category","project","tags",[56,57,58,59,60],"score",32,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","应用场景","视频监控","端侧AI","园区社区","大华股份","aihot","/items/og0u5vquobzto7liffnyc25ye","https://www.dahuatech.com/news/info/1248.html?page=1","weblist-dahua-news","name","大华股份新闻中心","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico","iconSrcSet","/reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico 48w, /reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico 96w",{"_75":76},"changelogVersion","2026-10-01T08:00"]

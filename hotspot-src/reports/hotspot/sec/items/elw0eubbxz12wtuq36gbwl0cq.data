[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":36,"_51":36,"_52":-5,"_53":54,"_55":56},"id","elw0eubbxz12wtuq36gbwl0cq","revision",2,"title","Yoosee广州体验店盛大开业：以服务赋能外贸商圈，共筑AI安防新标杆","originalTitle","summary","Yoosee于2026年1月17日在广州国际数码广场开设AI体验店，并举办行业交流会，聚焦珠三角外贸商圈。体验店以“安防体验实验室”为设计理念，展示AI摄像机的实时人车识别、哭声检测等功能，同时推出端侧算法与云端AI模型订阅、全球一卡通流量分成等模式，从硬件销售转向智能服务生态。","reason","原文详述Yoosee广州体验店如何以三大痛点解决方案构建AI安防服务生态，为消费安防渠道转型提供具体案例参考。","source",{"_9":64,"_65":66,"_67":68,"_69":36,"_70":71,"_72":73},"links",{"_61":62,"_56":63},"publishedAt","2026-01-20T00:00:00.000Z","discoveredAt","2026-09-29T13:23:34.318Z","timelineAt","category","industry","tags",[57,58,59,60],"score",29,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","行业动态","家用消费级","端侧AI","技威时代","aihot","/items/elw0eubbxz12wtuq36gbwl0cq","https://www.gwell.cc/?news_50/321.html","weblist-gwell-news","name","技威时代 Yoosee 企业动态","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/8196e1972bbd8f410547.ico","iconSrcSet","/reports/hotspot/sec/avatars/8196e1972bbd8f410547.ico 48w, /reports/hotspot/sec/avatars/8196e1972bbd8f410547.ico 96w",{"_75":76},"changelogVersion","2026-10-01T08:00"]

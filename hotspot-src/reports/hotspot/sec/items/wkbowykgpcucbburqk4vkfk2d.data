[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","wkbowykgpcucbburqk4vkfk2d","revision",2,"title","跨境电商消费类安防爆品推荐专区圆满收官：源头厂家选好品，选爆品","originalTitle","summary","由a&s传媒主办、浙江杰峰物联支持的跨境电商消费类安防爆品推荐专区在2026 CCBEC深圳跨境电商展览会圆满收官。该专区聚焦家用、宠物、户外三大场景，集中展示小夜灯婴儿监护器、太阳能摄像机、智能喂食器等热门消费类安防设备。参展商涵盖整机与ODM/OEM厂商，产品标注FCC/CE等认证与上架平台，帮助跨境卖家降低选品试错成本。","reason","source",{"_9":63,"_64":65,"_66":67,"_68":35,"_69":-5},"links",{"_60":61,"_55":62},"publishedAt","2026-09-20T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.657Z","timelineAt","category","industry","tags",[56,57,58,59],"score",20,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","展会/活动","家用消费级","视频监控","低功耗/电池","aihot","/items/wkbowykgpcucbburqk4vkfk2d","https://www.asmag.com.cn/news/202609/115320.html","weblist-asmag-news","name","a&s 安防知识网资讯","kind","web_list","firstParty","iconUrl",{"_71":72},"changelogVersion","2026-10-01T08:00"]

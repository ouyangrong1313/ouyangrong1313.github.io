[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":36,"_51":52,"_53":-5,"_54":36,"_55":56},"id","oo0ylft54t39kcplq9bv1lol7","revision",2,"title","大华股份出席2026中建八局建筑科技创新产业大会，签约城市合伙人并展示一站式数智方案","originalTitle","大华股份出席2026中建八局建筑科技创新产业大会，智焕建筑未来","summary","9月16日，大华股份出席2026中建八局建筑科技创新产业大会，国内营销中心常务副总裁覃春红代表公司与多方签署城市合伙人战略合作协议。大会期间，大华集中展示了城市更新、园区大模型（星汉大模型）、“好房子”建设、智慧能源、安消电一体化等场景的一站式数智方案。依托星汉大模型与云边端协同架构，大华推出“数据全融合、状态全可视、事件全可控”的智慧园区大脑，并发布“五位一体”智慧能源方案及城市生命线方案。","reason","source",{"_9":64,"_65":66,"_67":68,"_69":52,"_70":71,"_72":73},"links",{"_61":62,"_56":63},"publishedAt","2026-09-18T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.719Z","timelineAt","category","industry","tags",[57,58,59,60],"score",29,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","行业动态","大华股份","园区社区","门禁对讲","aihot","/items/oo0ylft54t39kcplq9bv1lol7","https://www.dahuatech.com/news/info/1251.html?page=1","weblist-dahua-news","name","大华股份新闻中心","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico","iconSrcSet","/reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico 48w, /reports/hotspot/sec/avatars/90d35dbfc04636ecd9a5.ico 96w",{"_75":76},"changelogVersion","2026-10-01T08:00"]

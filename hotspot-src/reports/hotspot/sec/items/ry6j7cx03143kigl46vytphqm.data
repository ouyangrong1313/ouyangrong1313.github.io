[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":36,"_51":36,"_52":-5,"_53":54,"_55":56},"id","ry6j7cx03143kigl46vytphqm","revision",1,"title","安防“瘦身”，公安部废止119项公共安全行业标准","originalTitle","summary","公安部发布公告，依据《行业标准管理办法》决定废止119项公共安全行业标准，涉及GA 374-2019《电子防盗锁》、GA/T 1093-2013《出入口控制人脸识别系统技术要求》等多项安防与警用装备标准。本次清理旨在解决标准陈旧、重复问题，为智能化转型释放空间，企业可降低合规成本并推动技术迭代。","reason","公安部集中废止119项公共安全行业标准，企业可借此缓解多重标准导致的合规负担，并加速AI、云边协同等新技术的应用。","source",{"_9":62,"_63":64,"_65":66,"_67":54,"_68":69,"_70":71},"links",{"_59":60,"_56":61},"publishedAt","2026-06-23T01:19:00.000Z","discoveredAt","2026-09-29T11:14:51.480Z","timelineAt","category","standard","tags",[57,58],"score",76,"selected",true,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","政策/监管","公安部","aihot","/items/ry6j7cx03143kigl46vytphqm","http://news.cps.com.cn/article/202606/943750.html","weblist-cps-news","name","CPS中安网智能安防","kind","web_list","firstParty","iconUrl","/api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar&exp=1790899200&sig=f7f19640bbb4a67e","iconSrcSet","/api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar-48&exp=1790899200&sig=e2d7b365812ac90d 48w, /api/img-proxy?u=http%3A%2F%2Fnews.cps.com.cn%2Fstatic%2Fimages%2Fcmsnew%2Ffavicon.ico&mode=avatar-96&exp=1790899200&sig=c095dafaa0ca5dc4 96w",{"_73":74},"changelogVersion","2026-10-01T08:00"]

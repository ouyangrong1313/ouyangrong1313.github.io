[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":36,"_51":52,"_53":-5,"_54":36,"_55":56},"id","srbz4k7gralvnbo79ztmnkqdb","revision",1,"title","海康威视发布卷轴鹰眼全景拼接摄像机","originalTitle","海康威视卷轴鹰眼，环视无畸，如画般精彩","summary","海康威视发布卷轴鹰眼全景拼接摄像机。产品采用8镜头融光拼接技术，实现140°环视与8K全景成像，细节球机支持4K分辨率和45倍光学变倍。全景采用F1.0大光圈实现低照度全彩，细节球机采用1/1.2英寸超大靶面与光学防抖实现星光Pro级效果；设备集成秒级联动、智能分析（船舶、车辆、人员检测）及AR实景地图平台，适用于城市安防、交通、港口等场景。","reason","source",{"_9":66,"_67":68,"_69":70,"_71":36,"_72":-5},"links",{"_63":64,"_56":65},"publishedAt","2026-09-14T00:00:00.000Z","discoveredAt","2026-09-29T11:14:49.668Z","timelineAt","category","product","tags",[57,58,59,60,61,62],"score",50,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","产品发布","视频监控","低照度","图像算法","视频结构化","海康威视","aihot","/items/srbz4k7gralvnbo79ztmnkqdb","https://www.asmag.com.cn/news/202609/115286.html","weblist-asmag-news","name","a&s 安防知识网资讯","kind","web_list","firstParty","iconUrl",{"_74":75},"changelogVersion","2026-10-01T08:00"]

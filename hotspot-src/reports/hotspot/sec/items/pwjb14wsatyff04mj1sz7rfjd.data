[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","pwjb14wsatyff04mj1sz7rfjd","revision",2,"title","移远通信：端侧AI能力全域赋能，开启AIoT增长新曲线","originalTitle","summary","移远通信完成端侧AI全维度布局，以覆盖1‑2000 TOPS的算力矩阵及端侧大模型、AlgoStore算法超市、AI物联平台形成软硬一体底座，开启AIoT增长新曲线。基于英伟达Jetson Thor的AI算力盒子算力达2070 FP4 TFLOPS，面向工业智能、机器人等高算力场景。方案已在具身智能、车载、智慧零售等多行业落地，缩短客户AI开发周期。","reason","source",{"_9":62,"_63":64,"_65":66,"_67":35,"_68":-5},"links",{"_59":60,"_55":61},"publishedAt","2026-09-18T00:00:00.000Z","discoveredAt","2026-09-29T11:14:51.867Z","timelineAt","category","technology","tags",[56,57,58],"score",25,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","技术进展","端侧AI","边缘计算","aihot","/items/pwjb14wsatyff04mj1sz7rfjd","https://www.iot101.com/news/10692.html","weblist-iot101-news","name","物联网智库资讯","kind","web_list","firstParty","iconUrl",{"_70":71},"changelogVersion","2026-10-01T08:00"]

[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","xnltujc8kmzd2o7giqfrnf1o1","revision",2,"title","三新·智变洞察① | 822个硬核项目！解码AI时代物联网发展新路径","originalTitle","summary","822个物联网“新技术新应用新模式”项目揭示，产业价值重心正从数据采集转向为AI服务的智能闭环，智能传感器、通信、终端与工业智能体四大方向成主赛道。申报主体中500强及上市公司项目104项，独角兽、单项冠军与专精特新企业85项，产业生态含金量飙升。无源物联网将仓库盘点时间从两天压缩至半小时，工业智能体将衍生车型导入周期从14天压至2天，物联网正加速从“连得上”迈向“用得好、能闭环”。","reason","source",{"_9":62,"_63":64,"_65":66,"_67":35,"_68":-5},"links",{"_59":60,"_55":61},"publishedAt","2026-09-24T00:00:00.000Z","discoveredAt","2026-09-29T11:14:51.860Z","timelineAt","category","opinion","tags",[56,57,58],"score",34,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","观点/分析","端侧AI","边缘计算","aihot","/items/xnltujc8kmzd2o7giqfrnf1o1","https://www.iot101.com/news/10697.html","weblist-iot101-news","name","物联网智库资讯","kind","web_list","firstParty","iconUrl",{"_70":71},"changelogVersion","2026-10-01T08:00"]

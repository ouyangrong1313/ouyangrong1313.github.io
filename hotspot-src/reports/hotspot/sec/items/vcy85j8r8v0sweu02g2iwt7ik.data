[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":35,"_50":51,"_52":-5,"_53":35,"_54":55},"id","vcy85j8r8v0sweu02g2iwt7ik","revision",2,"title","守储能安全底线，促标准落地生根 ——2026第三届储能安全大会于宜昌顺利落幕","originalTitle","summary","2026第三届储能安全大会于9月23日在宜昌落幕，近600名代表聚焦电化学储能安全标准GB/T 51048-2025落地与海外市场合规。大会期间，及安盾消防与中国检验认证集团、SGS等机构达成战略合作，完善全球属地化技术服务与质量检测体系。与会代表实地参观及安盾消防科技园，了解其产品预制车间、CNAS认证实验室等全链条硬实力。","reason","source",{"_9":61,"_62":63,"_64":65,"_66":35,"_67":68,"_69":70},"links",{"_58":59,"_55":60},"publishedAt","2026-09-24T12:36:00.000Z","discoveredAt","2026-09-29T11:14:51.482Z","timelineAt","category","industry","tags",[56,57],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","展会/活动","报警探测","aihot","/items/vcy85j8r8v0sweu02g2iwt7ik","http://companynews.cps.com.cn/article/202609/943914.html","weblist-cps-company","name","CPS中安网企业新闻","kind","web_list","firstParty","iconUrl","/reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico","iconSrcSet","/reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico 48w, /reports/hotspot/sec/avatars/561dd33a5244bffce5c8.ico 96w",{"_72":73},"changelogVersion","2026-10-01T08:00"]

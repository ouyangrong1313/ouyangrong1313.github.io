[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"id","r4e8dl4p154ty071i4imzlgy7","revision",2,"title","安讯士：数据中心安防的5层纵深防御策略","originalTitle","Data center security: A 5-layer defense strategy","summary","安讯士（Axis）提出，数据中心安防需采用5层纵深防御策略，从周界到服务器机架逐层设防。该策略针对物理入侵、内部威胁、蓄意破坏、人为失误及环境灾害等多样化风险。各层结合AI视频分析、雷达与PTZ联动、多因素认证和生物识别等技术，使入侵者必须逐层突破。","reason","source",{"_9":81,"_82":83,"_84":85,"_86":54,"_87":88,"_89":90},"links",{"_78":79,"_59":80},"publishedAt","2026-09-30T06:52:52.000Z","discoveredAt","2026-09-30T07:28:34.714Z","timelineAt","category","opinion","tags",[72,73,74,75,76,77],"score",27,"selected",false,"channel","news","story",{"_68":69,"_13":70},"x","readingMode","full","author","emeliesl","language","body","outline",[],"relatedStories",[71],"indexable","markdownAvailable",true,"group",{"_60":61,"_39":62,"_63":64,"_65":66,"_67":66},"hasTranslation","bodyLanguage","original","factId","fA_iLJhDCqcU",{"_68":69,"_13":70},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e2e8d335-ac7b-4ffd-8ad6-e8547af3771e","安讯士提出数据中心安防5层纵深防御策略",{"_68":69,"_13":70},"观点/分析","视频监控","门禁对讲","热成像","毫米波雷达","Axis","aihot","/items/r4e8dl4p154ty071i4imzlgy7","https://newsroom.axis.com/blog/data-center-security","rss-axis-newsroom","name","安讯士 Axis 新闻中心","kind","rss","firstParty","iconUrl","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico","iconSrcSet","/reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 48w, /reports/hotspot/sec/avatars/bde1999aa98aafa4be99.ico 96w",{"_92":93},"changelogVersion","2026-10-01T08:00"]

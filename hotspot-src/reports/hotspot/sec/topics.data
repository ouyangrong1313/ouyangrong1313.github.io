5":90,"_77":85,"_79":114},{"_65":107,"_67":108,"_69":70,"_71":109,"_73":90,"_75":90,"_77":85,"_79":-5},{"_65":104,"_67":105,"_69":70,"_71":106,"_73":90,"_75":90,"_77":85,"_79":-5},{"_65":100,"_67":101,"_69":70,"_71":102,"_73":89,"_75":90,"_77":85,"_79":103},{"_65":95,"_67":96,"_69":70,"_71":97,"_73":98,"_75":90,"_77":85,"_79":99},{"_65":92,"_67":93,"_69":70,"_71":94,"_73":90,"_75":90,"_77":85,"_79":-5},{"_65":86,"_67":87,"_69":70,"_71":88,"_73":89,"_75":90,"_77":85,"_79":91},{"_65":81,"_67":82,"_69":70,"_71":83,"_73":84,"_75":76,"_77":85,"_79":80},{"_65":66,"_67":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80},"slug","peer-watch","name","同业对比（消费级与中小企业安防）","group","company","definition","把天视通与捷高、中维世纪、雄迈、安佳威视、涂鸦智能、安联锐视、同为股份、技威时代的动态放在一处：消费级与中小企业安防赛道，按产品发布、技术路线（AOV/低功耗/4G 布点）、生态合作与出海节奏对比。","total",24,"recent",6,"indexable",true,"latestAt","2026-09-30T06:33:30.270Z","shimeta","视美泰","视美泰（SVMAT）的 AIoT 主板、算力盒子与行业方案动态。上游方案商，可为产品选型参考。",8,false,"gwell","技威时代","技威时代（Gwell / Yoosee）的智能摄像机与出海品牌动态。同赛道友商。",3,0,"2026-04-10T00:00:00.000Z","tvt","同为股份","同为股份（TVT）的 IPC、NVR 与解决方案动态。同赛道友商。","ansjer","安联锐视","安联锐视（Ansjer）的摄像机与方案动态。同赛道友商。",1,"2026-06-17T01:48:18.000Z","tuya","涂鸦智能","涂鸦智能的 IoT / 智能视觉产品与生态合作动态。平台型友商，常与摄像机厂商合作。","2026-08-25T01:00:00.000Z","anjiavision","安佳威视","安佳威视的产品与方案动态。同赛道友商。","xiongmai","雄迈","雄迈（浙江雄迈）的 IPC、低功耗与无线套装产品动态。同赛道友商（官网更新较少，作存在性监测）。","jovision","中维世纪","中维世纪（山东中维）的消费级与中小企业安防产品、方案与经营动态。同赛道友商。",2,"2026-08-28T00:00:00.000Z","jiegao","捷高","深圳市捷高电子科技有限公司的 AOV / 4G / Wi-Fi / IPC / 低功耗摄像机与 NVR 动态。同赛道友商。","2026-04-21T07:36:27.000Z","seetong","天视通（我司）","深圳天视通技术有限公司的全部动态：IPC、低功耗与无线摄像机、4G 球机、NVR 与云平台。本站主体，内容同时用于与友商做同业对比。","2024-12-24T16:00:00.000Z","tech-advance","技术进展","genre","算法、成像、编解码、芯片与工程实现的进展，以及可迁移到其他项目的方法。","reviews","评测与对比","独立实测、参数对比、选型评测与技术进展解读：可用于选型与对标的内容。","opinions","观点与分析","趋势判断、专家访谈、行业复盘与深度分析：有独立信息量的观点内容。","2026-09-14T00:00:00.000Z","exhibitions","展会与活动","CPSE、安博会、Intersec、ISC West 等展会上首次公开的产品、技术与行业信号。","projects-scene","场景落地","园区、社区、交通、零售、工厂、校园、医院等场景的方案落地与实际效果。",17,"2026-09-29T15:24:24.414Z","tenders","招投标与项目","招标中标、工程落地、试点项目与实效数据：规模、范围与技术要求。",4,"industry-news","行业动态","经营、财报、融资并购、人事、合作与市场数据：影响行业格局的商业事实。","2026-09-09T07:00:00.000Z","data-security","数据安全与隐私","视频数据、人脸与车牌信息的采集使用合规要求、安全事件与处罚案例。","2026-04-20T07:58:00.000Z","policy","政策与监管","法律法规、部委通知、监管措施、执法处罚与行业准入要求的第一手记录。","2026-06-23T01:19:00.000Z","certification","检测认证","产品检测、认证、抽查结果与合规要求：哪些项目要测、按哪个版本测。","2026-09-29T11:14:49.652Z","standards","标准发布","国标、行标、团标与国际标准的发布、报批、征求意见与修订：条文变化与执行时间。","product-releases","产品发布","新设备、新平台、新固件与重大功能更新的发布记录：参数、可用性与适配范围。",23,10,"2026-09-29T01:48:00.000Z","traffic","智慧交通感知","field","卡口、电警、交通流检测、车路协同与道路感知设备的方案与项目动态。","2026-09-18T00:00:00.000Z","image-sensor","芯片与传感器","安防 SoC、图像传感器、编解码芯片的供应、价格、替代方案与国产化进展。",13,"low-power","低功耗与电池供电","电池供电设备、唤醒机制、太阳能供电与功耗优化的产品与技术动态。","cloud-storage","云存储与边缘计算","视频云存储、边缘节点、云边协同与录像保留策略的技术与商业动态。","interoperability","互联与协议","ONVIF、GB/T 28181、GB 35114 与各类物联网协议的兼容性、安全要求与互通实践。","2025-01-22T03:58:30.000Z","codec","编解码与传输","H.265 / H.266 / AVS 系列编码、码率优化、传输协议与带宽成本的技术动态。","anpr","车牌识别","车牌识别与车辆结构化：识别率、场景适配、交通卡口与停车应用动态。","2026-09-11T00:00:00.000Z","face-recognition","人脸识别","人脸识别技术、合规要求、个人信息保护约束与实际落地的全部动态。","access-control","门禁与对讲","门禁控制、可视对讲、生物识别通行与楼宇联动系统的产品与标准动态。","2026-09-20T00:00:00.000Z","perimeter","周界防范","周界入侵检测、电子围栏、报警探测与误报抑制的产品与技术动态。","2026-09-01T12:46:38.000Z","mmwave-radar","毫米波雷达","毫米波雷达与雷视融合：周界检测、交通感知、跌倒检测与隐私友好方案的动态。","thermal","热成像与测温","非制冷红外、热成像机芯、测温与雷视/热可见光融合的技术与产品动态。","low-light","低照度成像","星光级、全彩夜视、大光圈与传感器技术：照度指标、实测对比与成像算法进展。",5,"2026-09-14T11:52:23.000Z","video-analytics","视频智能分析","行为分析、目标检测、视频结构化与跨镜追踪：算法能力、误报控制与实战效果。","edge-ai","端侧 AI","在设备端运行的智能分析：SoC 与 NPU、算法上端、模型裁剪与端云协同的全部动态。","video-surveillance","视频监控","摄像机、NVR、存储与平台构成的视频监控主线：成像、码流、通道与录像的全部技术动态。",15,"csppi","中国安防协会","中国安全防范产品行业协会的团标、行业统计、展会与会员动态。","miit","工信部","工业和信息化部关于物联网、通信模组、产业规划与准入的动态。","cac","网信办","中央网信办关于数据安全、个人信息保护与视频数据合规的要求与执法动态。","samr","市场监管总局","国家市场监督管理总局与认监委的强制性国标、认证与抽查监管动态。","mps","公安部","公安部及其研究所的政策、标准归口、检测与行业管理动态。","genetec","Genetec","Genetec 的统一安防平台（视频、门禁、报警、车牌识别）产品与项目动态。","milestone","Milestone","Milestone Systems 的 VMS 平台、开放架构与集成生态动态。","hanwha","Hanwha Vision","Hanwha Vision（韩华，原 Hanwha Techwin）的 Wisenet 产品线与成像技术动态。","bosch","Bosch 博世","Bosch 安防与视频系统产品线、报警与门禁方案动态。","axis","Axis 安讯士","Axis（安讯士）的网络摄像机产品线、芯片路线与海外标准与安全实践。","imou","乐橙 Imou","大华乐橙（Imou）的消费级与中小企业产品线、云平台动态。","ezviz","萤石网络","萤石网络（EZVIZ）的家用与消费级产品、云平台与经营动态。","tiandy","天地伟业","天地伟业（Tiandy）的产品发布、技术路线与项目动态。","huawei","华为机器视觉","华为机器视觉（好望 HoloSens）的产品线、软件定义摄像机路线与生态合作动态。","uniview","宇视科技","宇视科技（Uniview / UNV）的产品发布、平台迭代、经营与项目动态的持续追踪。","dahua","大华股份","大华股份及其子品牌（华睿科技、乐橙）的全部动态：产品线与固件更新、经营与项目、技术路线的持续追踪。","2026-09-03T00:00:00.000Z","hikvision","海康威视","海康威视及其子品牌（海康机器人、海康汽车电子、海康微影）的全部动态：产品线与固件更新、经营与项目、技术路线的持续追踪。",{"_282":283},"changelogVersion","2026-10-01T08:00"]
